+    def compute_boundary_penalties(self, circles: np.ndarray) -> float:
+        """Compute penalty for boundary violations."""
+        penalty = 0.0
+        for i in range(len(circles)):
+            x, y, r = circles[i]
+            if x - r < 0:
+                penalty += 1000 * (r - x)**2
+            if x + r > self.width:
+                penalty += 1000 * (x + r - self.width)**2
+            if y - r < 0:
+                penalty += 1000 * (r - y)**2
+            if y + r > self.height:
+                penalty += 1000 * (y + r - self.height)**2
+        return penalty
