 class ConstraintManager:
     """Manages constraint enforcement and penalty calculation with efficient spatial indexing"""
     
     def __init__(self, width: float, height: float, num_circles: int):
         self.width = width
         self.height = height
         self.num_circles = num_circles
         self.spatial_tree = None
     
     def update_spatial_tree(self, circles: np.ndarray):
         """Update the spatial tree for efficient neighbor queries"""
         try:
             self.spatial_tree = cKDTree(circles[:, :2])
         except Exception:
-            # Fallback to None if tree creation fails
             self.spatial_tree = None
     
     def is_feasible(self, circles: np.ndarray) -> bool:
         """Check if configuration satisfies all constraints efficiently"""
         # Check boundary violations
         if np.any((circles[:, 0] - circles[:, 2] < 0) |
                   (circles[:, 0] + circles[:, 2] > self.width) |
                   (circles[:, 1] - circles[:, 2] < 0) |
                   (circles[:, 1] + circles[:, 2] > self.height)):
             return False
         
         # Check overlap violations using spatial indexing
         try:
             if self.spatial_tree is None or circles.shape[0] < 2:
                 self.update_spatial_tree(circles)
             
             if self.spatial_tree is not None:
                 max_radius = np.max(circles[:, 2])
                 pairs = self.spatial_tree.query_pairs(2 * max_radius, output_type='ndarray')
                 
                 for i, j in pairs:
                     if i != j:
                         x1, y1, r1 = circles[i]
                         x2, y2, r2 = circles[j]
                         dx = x1 - x2
                         dy = y1 - y2
                         dist_sq = dx*dx + dy*dy
                         radius_sum_sq = (r1 + r2) * (r1 + r2)
                         if dist_sq < radius_sum_sq:
                             return False
             else:
                 # Fallback to brute force for small arrays or failed trees
                 for i in range(self.num_circles):
                     for j in range(i+1, self.num_circles):
                         x1, y1, r1 = circles[i]
                         x2, y2, r2 = circles[j]
                         dx = x1 - x2
                         dy = y1 - y2
                         dist_sq = dx*dx + dy*dy
                         radius_sum_sq = (r1 + r2) * (r1 + r2)
                         if dist_sq < radius_sum_sq:
                             return False
                             
         except Exception:
             # If any error occurs, fall back to brute force checking
             for i in range(self.num_circles):
                 for j in range(i+1, self.num_circles):
                     x1, y1, r1 = circles[i]
                     x2, y2, r2 = circles[j]
                     dx = x1 - x2
                     dy = y1 - y2
                     dist_sq = dx*dx + dy*dy
                     radius_sum_sq = (r1 + r2) * (r1 + r2)
                     if dist_sq < radius_sum_sq:
                         return False
         
         return True
     
