             existing_x, existing_y, existing_r = existing_circles[i]
             if i != len(existing_circles):  # Skip the circle being placed
                 distance = self.calculate_distance([x, y], [existing_x, existing_y])
                 if distance < (r + existing_r):
                     return False
         return True
 
