                 cx, cy, cr = circles_array[j]
                 dx = x - cx
                 dy = y - cy
                 distance = math.sqrt(dx*dx + dy*dy)
                 overlap = max(0, (r + cr) - distance)
                 if overlap > 0:
                     penalty += overlap ** 2
 
         return penalty
 
