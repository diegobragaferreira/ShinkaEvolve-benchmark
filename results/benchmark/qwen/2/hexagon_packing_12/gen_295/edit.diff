+class HexagonGeometry:
+    """Efficient geometric computations for hexagon operations."""
+    
+    def __init__(self):
+        self.side_length = 1.0
+        self.apothem = np.sqrt(3) / 2
+        self.height = 2 * self.apothem
+        self.width = 2 * self.side_length
