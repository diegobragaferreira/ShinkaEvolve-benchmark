+def get_hexagon_vertices(center_x, center_y, angle_deg, side_length=1):
+    """Get vertices of a regular hexagon given center, rotation, and side length"""
+    angle_rad = np.radians(angle_deg)
+    # Vertices of a unit hexagon centered at origin
+    base_vertices = np.array([
+        [1, 0],
+        [0.5, np.sqrt(3)/2],
+        [-0.5, np.sqrt(3)/2],
+        [-1, 0],
+        [-0.5, -np.sqrt(3)/2],
+        [0.5, -np.sqrt(3)/2]
+    ])
+
+    # Rotate and translate
+    rotation_matrix = np.array([
+        [np.cos(angle_rad), -np.sin(angle_rad)],
+        [np.sin(angle_rad), np.cos(angle_rad)]
+    ])
+
+    rotated_vertices = base_vertices @ rotation_matrix.T
+    return rotated_vertices + np.array([center_x, center_y])
+
+def check_containment(hex_vertices, outer_hex_center_x, outer_hex_center_y, outer_radius):
+    """Check if hexagon vertices are contained within outer hexagon"""
+    # Create outer hexagon vertices
+    outer_vertices = get_hexagon_vertices(outer_hex_center_x, outer_hex_center_y, 0, outer_radius)
+
+    # Convert to Shapely polygon
+    outer_polygon = Polygon(outer_vertices)
+
+    # Check if all vertices are inside the outer hexagon
+    for vertex in hex_vertices:
+        point = Point(vertex[0], vertex[1])
+        if not outer_polygon.contains(point):
+            return False
+    return True
+
+def check_overlap(hex1_vertices, hex2_vertices):
+    """Check if two hexagons overlap using Shapely"""
+    poly1 = Polygon(hex1_vertices)
+    poly2 = Polygon(hex2_vertices)
+    return poly1.intersects(poly2)
+
+def calculate_objective_and_constraints(params):
+    """
+    Calculate objective and constraints for optimization
+    params: [x1, y1, theta1, ..., x12, y12, theta12, R]
+    """
+    # Extract parameters
+    inner_params = params[:-1]  # First 36 values for 12 hexagons (x,y,theta each)
+    outer_radius = params[-1]  # Last value is outer radius
+
+    # Reshape inner hexagon parameters (12 hexagons, 3 params each)
+    inner_params = inner_params.reshape(-1, 3)
+
+    # Get vertices for all hexagons
+    hex_vertices_list = []
+    for i in range(12):
+        center_x, center_y, angle = inner_params[i]
+        vertices = get_hexagon_vertices(center_x, center_y, angle)
+        hex_vertices_list.append(vertices)
+
+    # Check containment constraints
+    outer_center_x, outer_center_y = 0, 0  # Assume centered
+    containment_violations = 0
+    for vertices in hex_vertices_list:
+        if not check_containment(vertices, outer_center_x, outer_center_y, outer_radius):
+            containment_violations += 1
+
+    # Check overlap constraints
+    overlap_violations = 0
+    for i in range(12):
+        for j in range(i+1, 12):
+            if check_overlap(hex_vertices_list[i], hex_vertices_list[j]):
+                overlap_violations += 1
+
+    # Objective: maximize 1/R (minimize R)
+    objective = outer_radius
+
+    # Return penalty for constraints (positive means violation)
+    total_penalty = containment_violations * 1000 + overlap_violations * 1000
+
+    return objective + total_penalty
 
