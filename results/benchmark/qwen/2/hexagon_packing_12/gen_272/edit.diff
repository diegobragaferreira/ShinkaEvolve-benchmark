 def adaptive_local_refinement(initial_config, max_iterations=100, method='L-BFGS-B'):
     """Apply local refinement to improve the configuration using scipy optimization"""
     from scipy.optimize import minimize
 
     # Convert to flat parameter array for optimization
     params = initial_config.flatten()
 
     def objective(flat_params):
         config = flat_params.reshape(-1, 3)
         outer_radius = get_outer_hexagon_radius(config)
         penalty = calculate_total_penalty(config, outer_radius)
         # Objective is to minimize penalty and maximize 1/R
         return penalty - 1.0/(outer_radius + 1e-6)  # Small epsilon for numerical stability
 
     # Use bounds for parameters to prevent extreme positions
     bounds = [(-5.0, 5.0), (-5.0, 5.0), (0.0, 360.0)] * 12
 
     try:
         result = minimize(objective, params, method=method, bounds=bounds,
                          options={'maxiter': max_iterations, 'gtol': 1e-8})
         if result.success:
             # Return optimized configuration
             final_config = result.x.reshape(-1, 3)
             return final_config
     except Exception as e:
         # If optimization fails, return original
         print(f"Local refinement failed: {e}")
 
     return initial_config
 
 def evolutionary_optimize(max_generations=50, population_size=30):
     """Evolutionary algorithm for hexagon packing optimization with improved initialization"""
     # Create initial population using symmetric configurations
     population = []
 
     # Strategy 1: Concentric ring configurations (more balanced)
     for _ in range(population_size // 3):
         positions = []
         # Center hexagon
         positions.append([0.0, 0.0, 0.0])
         # First ring (6 hexagons)
         for i in range(6):
             angle = i * 60
             radius = 1.9  # Tighter than previous
             x = radius * np.cos(np.radians(angle))
             y = radius * np.sin(np.radians(angle))
             positions.append([x, y, random.uniform(0, 360)])
         # Second ring (5 hexagons)
         for i in range(5):
             angle = i * 72
             radius = 3.3  # Slightly tighter than previous
             x = radius * np.cos(np.radians(angle))
             y = radius * np.sin(np.radians(angle))
             positions.append([x, y, random.uniform(0, 360)])
         population.append(np.array(positions))
 
     # Strategy 2: Grid-like configurations with more mathematical basis
     for _ in range(population_size // 3):
         positions = []
         # Central hexagon
         positions.append([0.0, 0.0, 0.0])
         # Grid layout with specific spacing
         positions.append([-2.2, 0.0, 0.0])   # Left
         positions.append([2.2, 0.0, 0.0])    # Right
         positions.append([0.0, 2.2, 0.0])    # Top
         positions.append([0.0, -2.2, 0.0])   # Bottom
         positions.append([-1.6, 1.6, 0.0])   # Top-left
         positions.append([1.6, 1.6, 0.0])    # Top-right
         positions.append([-1.6, -1.6, 0.0])  # Bottom-left
         positions.append([1.6, -1.6, 0.0])   # Bottom-right
         positions.append([-2.8, 2.8, 0.0])   # Far top-left
         positions.append([2.8, 2.8, 0.0])    # Far top-right
         positions.append([-2.8, -2.8, 0.0])  # Far bottom-left
         positions.append([2.8, -2.8, 0.0])   # Far bottom-right
         population.append(np.array(positions))
 
     # Strategy 3: Hybrid configurations with mathematical spacing
     for _ in range(population_size - 2 * (population_size // 3)):
         positions = []
         # Center hexagon
         positions.append([0.0, 0.0, 0.0])
         # Random placement with smart constraints
         for i in range(11):
             # Position hexagons in a way that respects hexagonal symmetry
             radius = random.uniform(1.8, 3.8)
             angle = random.uniform(0, 360)
             x = radius * np.cos(np.radians(angle))
             y = radius * np.sin(np.radians(angle))
             positions.append([x, y, random.uniform(0, 360)])
         population.append(np.array(positions))
 
     best_fitness = float('inf')
     best_individual = None
 
     # Evolutionary loop with more aggressive selection pressure
     for generation in range(max_generations):
         # Evaluate fitness of entire population
         fitness_scores = []
         for individual in population:
             outer_radius = get_outer_hexagon_radius(individual)
             penalty = calculate_total_penalty(individual, outer_radius)
             # Fitness is negative penalty plus inverse of radius (to maximize 1/R)
             fitness = penalty - 1.0 / (outer_radius + 1e-6)
             fitness_scores.append(fitness)
 
         # Find best individual in this generation
         best_idx = np.argmin(fitness_scores)
         if fitness_scores[best_idx] < best_fitness:
             best_fitness = fitness_scores[best_idx]
             best_individual = population[best_idx].copy()
 
         # Create new population with more elitism
         new_population = []
 
         # Keep best individual (elitism)
         new_population.append(best_individual)
 
         # Generate rest via tournament selection, crossover, and mutation
         while len(new_population) < population_size:
             # Tournament selection with larger tournament size for better selection pressure
             tournament_size = 4
             tournament_indices = random.sample(range(population_size), tournament_size)
             tournament_fitness = [fitness_scores[i] for i in tournament_indices]
             winner_idx = tournament_indices[np.argmin(tournament_fitness)]
 
             # Select another parent
             tournament_indices = random.sample(range(population_size), tournament_size)
             tournament_fitness = [fitness_scores[i] for i in tournament_indices]
             other_idx = tournament_indices[np.argmin(tournament_fitness)]
 
             # Crossover
             child1, child2 = crossover(population[winner_idx], population[other_idx])
 
             # Mutate children with adaptive rate
             mutation_rate = 0.25 * (1 - generation / max_generations)
             child1 = mutate_individual(child1, mutation_rate)
             child2 = mutate_individual(child2, mutation_rate)
 
             new_population.extend([child1, child2])
 
         # Trim population to exact size
         population = new_population[:population_size]
 
     # Refine the best solution found
     best_individual = adaptive_local_refinement(best_individual, max_iterations=50)
 
     return best_individual
 
 def mutate_individual(individual, mutation_rate=0.3, max_mutation=0.3):
     """Mutate individual hexagon positions and rotations with adaptive rate"""
     mutated = individual.copy()
 
     # Mutate positions and rotations
     for i in range(len(mutated)):
         if random.random() < mutation_rate:
             # Small random change to position
             mutated[i][0] += random.uniform(-max_mutation, max_mutation)
             mutated[i][1] += random.uniform(-max_mutation, max_mutation)
             # Small random change to rotation
             mutated[i][2] += random.uniform(-max_mutation * 15, max_mutation * 15)
             # Normalize rotation angle to [0, 360)
             mutated[i][2] = mutated[i][2] % 360
 
     return mutated
 
 def crossover(parent1, parent2):
     """Single-point crossover between two individuals"""
     crossover_point = random.randint(1, len(parent1) - 1)
     child1 = np.vstack([parent1[:crossover_point], parent2[crossover_point:]])
     child2 = np.vstack([parent2[:crossover_point], parent1[crossover_point:]])
     return child1, child2
 
 def hexagon_packing_12():
     """
     Constructs a packing of 12 disjoint unit regular hexagons inside a larger regular hexagon, maximizing 1/outer_hex_side_length.
     Returns
         inner_hex_data: np.ndarray of shape (12,3), where each row is of the form (x, y, angle_degrees) containing the (x,y) coordinates and angle_degree of the respective inner hexagon.
