+@jit(nopython=True)
+def point_distance_squared(x1, y1, x2, y2):
+    """Calculate squared distance between two points."""
+    dx = x1 - x2
+    dy = y1 - y2
+    return dx * dx + dy * dy
+
+@jit(nopython=True)
+def fast_hexagon_center_and_apothem(vertices):
+    """Fast calculation of center and apothem for a hexagon."""
