+# NUMBA JIT COMPILED FUNCTIONS FOR PERFORMANCE
+@jit(nopython=True)
+def hexagon_vertices_jit(center_x: float, center_y: float, side_length: float, angle_deg: float) -> np.ndarray:
+    """Generate vertices of a hexagon using numba for speed."""
+    angle_rad = np.radians(angle_deg)
+    vertices = np.empty((6, 2))
+    for i in range(6):
+        theta = angle_rad + i * np.pi / 3
+        vertices[i, 0] = center_x + side_length * np.cos(theta)
+        vertices[i, 1] = center_y + side_length * np.sin(theta)
+    return vertices
+
+@jit(nopython=True)
+def distance_point_to_segment(point_x: float, point_y: float, seg_start_x: float, seg_start_y: float, 
+                             seg_end_x: float, seg_end_y: float) -> float:
+    """Calculate distance from point to line segment."""
+    # Vector from start to end of segment
+    dx = seg_end_x - seg_start_x
+    dy = seg_end_y - seg_start_y
+    
+    # If segment is degenerate
+    if dx == 0 and dy == 0:
+        return np.sqrt((point_x - seg_start_x)**2 + (point_y - seg_start_y)**2)
+    
+    # Project point onto line
+    t = ((point_x - seg_start_x) * dx + (point_y - seg_start_y) * dy) / (dx*dx + dy*dy)
+    t = max(0, min(1, t))  # Clamp to segment bounds
+    
+    # Closest point on segment
+    closest_x = seg_start_x + t * dx
+    closest_y = seg_start_y + t * dy
+    
+    return np.sqrt((point_x - closest_x)**2 + (point_y - closest_y)**2)
