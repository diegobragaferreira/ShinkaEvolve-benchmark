+def calculate_min_distance(hexagons: List[Hexagon]) -> float:
+    """Calculate minimum distance between any two hexagons."""
+    min_dist = float('inf')
+    vertices_list = [hexagon.get_vertices() for hexagon in hexagons]
+    
+    for i in range(len(vertices_list)):
+        for j in range(i+1, len(vertices_list)):
+            vertices_i = vertices_list[i]
+            vertices_j = vertices_list[j]
+            
+            # Check distance between all pairs of vertices
+            distances = cdist(vertices_i, vertices_j)
+            min_dist = min(min_dist, distances.min())
+    
+    return min_dist
