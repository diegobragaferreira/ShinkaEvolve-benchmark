 def get_neighbors(grid, grid_x, grid_y, cell_size):
     """Get all neighbors in the spatial hash grid."""
     neighbors = []
     # Check the cell and its 8 neighbors
     for dx in [-1, 0, 1]:
         for dy in [-1, 0, 1]:
             nx, ny = grid_x + dx, grid_y + dy
             if (nx, ny) in grid:
                 neighbors.extend(grid[(nx, ny)])
     return neighbors
 
 
