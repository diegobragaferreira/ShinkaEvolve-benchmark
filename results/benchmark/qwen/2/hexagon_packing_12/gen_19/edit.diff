+def hexagon_vertices(center_x, center_y, angle_deg, side_length=1):
+    """Generate vertices of a regular hexagon with given center, rotation, and side length."""
+    angle_rad = math.radians(angle_deg)
+    # Vertices of regular hexagon centered at origin with side length 1
+    base_vertices = []
+    for i in range(6):
+        theta = angle_rad + i * math.pi / 3
+        x = math.cos(theta)
+        y = math.sin(theta)
+        base_vertices.append((x, y))
+
+    # Scale and translate
+    vertices = [(center_x + side_length * vx, center_y + side_length * vy) for vx, vy in base_vertices]
+    return vertices
