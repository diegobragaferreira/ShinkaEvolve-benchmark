+from scipy.spatial.distance import cdist
+from shapely.geometry import Polygon, Point
+import time
 
+def generate_hexagon_vertices(center_x, center_y, side_length=1, rotation_deg=0):
+    """Generate vertices of a regular hexagon."""
+    rotation_rad = np.radians(rotation_deg)
+    angles = np.linspace(0, 2*np.pi, 7) + rotation_rad
+    vertices = []
+    for angle in angles[:-1]:  # skip last vertex to close the polygon
+        x = center_x + side_length * np.cos(angle)
+        y = center_y + side_length * np.sin(angle)
+        vertices.append((x, y))
+    return vertices
+
+def create_hexagon_polygon(center_x, center_y, side_length=1, rotation_deg=0):
+    """Create Shapely polygon for a hexagon."""
+    vertices = generate_hexagon_vertices(center_x, center_y, side_length, rotation_deg)
+    return Polygon(vertices)
+
+def check_containment(inner_hex, outer_hex):
+    """Check if inner hexagon is fully contained within outer hexagon."""
+    # Check if all vertices of inner hexagon are within outer hexagon
+    for vertex in inner_hex.exterior.coords:
+        point = Point(vertex[0], vertex[1])
+        if not outer_hex.contains(point):
+            return False
+    return True
+
+def check_overlap(hex1, hex2):
+    """Check if two hexagons overlap."""
+    return hex1.intersects(hex2)
+
+def evaluate_configuration(params, outer_radius_guess=5.0):
+    """
+    Evaluate a configuration of hexagons.
+    params: flattened array of [x1,y1,theta1, x2,y2,theta2, ..., x12,y12,theta12, R]
+    """
+    # Parse parameters
+    n = 12
+    inner_positions = params[:2*n].reshape(-1, 2)  # (x,y) for each hexagon
+    inner_angles = params[2*n:3*n]  # rotation angles for each hexagon
+    outer_radius = params[-1]  # outer hexagon radius
+
+    # Create outer hexagon
+    outer_hex = create_hexagon_polygon(0, 0, outer_radius, 0)
+
+    # Initialize penalty
+    penalty = 0
+
+    # Check containment and overlaps
+    inner_hexagons = []
+    for i in range(n):
+        cx, cy = inner_positions[i]
+        angle = inner_angles[i]
+        inner_hex = create_hexagon_polygon(cx, cy, 1, angle)
+        inner_hexagons.append(inner_hex)
+
+        # Check containment
+        if not check_containment(inner_hex, outer_hex):
+            penalty += 1000  # Large penalty for containment violation
+
+        # Check overlaps with all previous hexagons
+        for j in range(i):
+            if check_overlap(inner_hex, inner_hexagons[j]):
+                penalty += 100  # Penalty for overlap
+
+    # Objective: maximize 1/outer_radius (minimize outer_radius)
+    # If there are violations, penalize heavily
+    if penalty > 0:
+        return penalty + 1/outer_radius  # Return penalty plus small objective value
+    else:
+        return 1/outer_radius
 
