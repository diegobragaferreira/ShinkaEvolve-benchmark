     @staticmethod
     @jit(nopython=True)
     def get_hexagon_bounds(vertices):
         """Get bounding box of a hexagon."""
         min_x = vertices[0][0]
         max_x = vertices[0][0]
         min_y = vertices[0][1]
         max_y = vertices[0][1]
 
         for i in range(1, len(vertices)):
             x, y = vertices[i]
             if x < min_x: min_x = x
             if x > max_x: max_x = x
             if y < min_y: min_y = y
             if y > max_y: max_y = y
 
         return min_x, max_x, min_y, max_y
 
