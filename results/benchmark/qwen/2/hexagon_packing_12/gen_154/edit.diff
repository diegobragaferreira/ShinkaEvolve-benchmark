+@njit
+def build_spatial_hash(hexagon_positions: List[Tuple[float, float, float]], 
+                      grid_size: float = 2.0) -> Dict[Tuple[int, int], List[int]]:
+    """Build spatial hash for fast overlap detection"""
+    hash_table = {}
