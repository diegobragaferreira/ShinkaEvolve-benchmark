 def _compute_penalty_distance(circles, i, j):
     """Compute the squared distance between two circles"""
     x1, y1, r1 = circles[i]
     x2, y2, r2 = circles[j]
     dx = x1 - x2
     dy = y1 - y2
     dist_sq = dx*dx + dy*dy
     return dist_sq
 
