+            popsize=5,
+            seed=42,
+            strategy='best1bin',
+            tol=1e-6
+        )
+
+        # Apply refined parameters back to original function
+        final_f = best_f.copy()
+        for i, idx in enumerate(sample_indices):
+            if i < len(result.x):
