+def compute_autoconvolution(f_vals, dx):
+    """
+    Compute the autoconvolution g = f * f efficiently using numpy
+    """
+    # Create the full convolution
+    g = np.convolve(f_vals, f_vals, mode='full')
+
+    # Adjust for proper spacing since we're working with step functions
+    # The convolution result is indexed from -n+1 to n-1 where n=len(f_vals)
+    # We keep only the central portion that corresponds to our desired domain
+    n = len(f_vals)
+    g = g[n-1:2*n-1]  # Keep center part
+
+    # Scale by dx for proper normalization
+    g = g * dx
+
+    return g
+
+def compute_c2_norms(g_vals):
+    """
+    Compute the three norms needed for C2 calculation
+    """
+    if len(g_vals) == 0:
+        return 0, 0, 0
+
+    # ||g||₁ (L1 norm)
+    g_abs = np.abs(g_vals)
+    g_l1 = np.sum(g_abs)
+
+    # ||g||₂² (L2 norm squared)
+    g_l2_sq = np.sum(g_abs**2)
+
+    # ||g||∞ (Infinity norm)
+    g_inf = np.max(g_abs)
+
+    return g_l2_sq, g_l1, g_inf
+
+def compute_c2(f_vals, dx):
+    """
+    Compute C2 value for given step function
+    """
+    try:
+        g = compute_autoconvolution(f_vals, dx)
+        g_l2_sq, g_l1, g_inf = compute_c2_norms(g)
+
+        # Avoid division by zero
+        if g_l1 <= 1e-15 or g_inf <= 1e-15:
+            return 0.0
+
+        c2 = g_l2_sq / (g_l1 * g_inf)
+        return c2
+    except Exception:
+        return 0.0
 
