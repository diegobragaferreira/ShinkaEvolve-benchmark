+@jit(nopython=True)
+def compute_autoconvolution_fast(f_vals):
+    """Fast autoconvolution computation using Numba JIT compilation"""
+    n = len(f_vals)
+    g = np.zeros(2 * n - 1)
+    
+    # Manual convolution for speed
+    for i in range(n):
+        for j in range(n):
+            g[i + j] += f_vals[i] * f_vals[j]
+    
+    return g
+
+@jit(nopython=True)
+def compute_norms_piecewise(g_vals):
+    """Compute norms using piecewise linear integration matching evaluator's method"""
+    n = len(g_vals)
+    
+    if n <= 1:
+        return 0.0, 0.0, 0.0
+    
+    # Compute L2 norm squared using trapezoidal-like integration
+    # Formula: (dx/3) * (y_i^2 + y_i*y_{i+1} + y_{i+1}^2)
+    norm_2_sq = 0.0
+    dx = 0.5 / (len(g_vals) - 1) if len(g_vals) > 1 else 0.5
+    
+    for i in range(n - 1):
+        y1 = g_vals[i]
+        y2 = g_vals[i + 1]
+        norm_2_sq += (dx / 3.0) * (y1 * y1 + y1 * y2 + y2 * y2)
+    
+    # Compute L1 norm (sum of absolute values)
+    norm_1 = 0.0
+    for i in range(n):
+        norm_1 += abs(g_vals[i])
+    
+    # Compute L-infinity norm (maximum absolute value)
+    norm_inf = 0.0
+    for i in range(n):
+        abs_val = abs(g_vals[i])
+        if abs_val > norm_inf:
+            norm_inf = abs_val
+    
+    return norm_2_sq, norm_1, norm_inf
+
+def compute_c2(func_vals: List[float]) -> float:
+    """
+    Compute C₂ value with optimized numerical integration using Numba JIT.
+    """
+    # Convert to numpy array
+    f_arr = np.array(func_vals, dtype=np.float64)
+    
+    # Compute autoconvolution using fast Numba version
+    g = compute_autoconvolution_fast(f_arr)
+    
+    # Compute norms using piecewise integration
+    norm_2_sq, norm_1, norm_inf = compute_norms_piecewise(g)
+    
+    # Prevent division by zero or extremely small values
+    if norm_1 <= 1e-15 or norm_inf <= 1e-15:
+        return 0.0
+
+    return norm_2_sq / (norm_1 * norm_inf)
+
+def generate_spectral_guided_peaks(n_steps: int) -> List[Tuple[float, float, float]]:
+    """
+    Generate peaks guided by spectral analysis to optimize autoconvolution properties.
+    Uses logarithmic spacing and careful amplitude distribution.
+    """
+    peaks = []
+    
+    # Generate peak positions using logarithmic spacing for better distribution
+    # This helps avoid clustering near edges while ensuring good coverage
+    n_peaks = max(10, min(25, n_steps // 200))  # Adaptive peak count
+    
+    # Logarithmic distribution with strategic gaps
+    for i in range(n_peaks):
+        # Use a combination of logarithmic and uniform distribution
+        if i < n_peaks // 2:
+            # First half: logarithmic spread in central region
+            log_min = np.log(0.02)
+            log_max = np.log(0.15)
+            pos_log = log_min + (log_max - log_min) * i / max(1, n_peaks // 2 - 1)
+            pos = np.exp(pos_log)
+            pos = np.random.uniform(pos * 0.8, pos * 1.2)  # Add variation
+        else:
+            # Second half: spread towards edges
+            pos = np.random.uniform(-0.24, -0.15) if i % 2 == 0 else np.random.uniform(0.15, 0.24)
+        
+        # Ensure unique positions with minimum separation
+        if any(abs(pos - p[0]) < 0.01 for p in peaks):
+            continue
+            
+        # Height based on position - central peaks get higher amplitudes
+        if abs(pos) < 0.05:
+            height = np.random.uniform(2.0, 3.0)
+        elif abs(pos) < 0.15:
+            height = np.random.uniform(1.5, 2.5)
+        else:
+            height = np.random.uniform(1.0, 2.0)
+            
+        # Width inversely related to height for better balance
+        width = np.random.uniform(0.015, 0.04)
+        
+        peaks.append((pos, height, width))
+    
+    # Ensure we always have at least some peaks
+    if len(peaks) == 0:
+        peaks.append((0.0, 2.0, 0.02))
+    
+    # Sort by position for consistent ordering
+    peaks.sort(key=lambda x: x[0])
+    
+    return peaks
+
+def add_supplementary_structure(f_values: np.ndarray, x: np.ndarray):
+    """
+    Add supplementary structure to enhance autoconvolution properties.
+    """
+    n_steps = len(f_values)
+    # Add more structured bumps for better interference patterns
+    for i in range(0, n_steps, max(1, n_steps//25)):
+        if np.random.random() > 0.8:  # 20% chance to add bump
+            bump_center = x[i]
+            bump_height = np.random.uniform(0.05, 0.25)
+            bump_width = np.random.uniform(0.005, 0.02)
+            bump = bump_height * np.exp(-0.5 * ((x - bump_center) / bump_width)**2)
+            f_values += bump
