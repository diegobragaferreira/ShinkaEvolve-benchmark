+def identify_key_peaks(func_vals: np.ndarray, x: np.ndarray, 
+                      min_height_ratio: float = 0.15) -> List[float]:
+    """
+    Identify key peak locations in the function for evolutionary optimization.
+    """
+    # Find local maxima with better filtering
+    peaks = []
+    threshold = min_height_ratio * np.max(func_vals)
+    
+    for i in range(1, len(func_vals)-1):
+        if (func_vals[i] > func_vals[i-1] and 
+            func_vals[i] > func_vals[i+1] and 
+            func_vals[i] > threshold):
+            peaks.append(x[i])
+
+    # If no significant peaks found, sample strategically
+    if not peaks:
+        # Sample from key regions: center, quarter points, and edges
+        key_positions = [x[len(x)//2], x[len(x)//4], x[3*len(x)//4], x[0], x[-1]]
+        # Keep only those with sufficient height
+        peaks = [pos for pos in key_positions if 
+                func_vals[np.argmin(np.abs(x - pos))] > threshold]
+
+    return sorted(set(peaks))  # Remove duplicates and sort
+
+def reconstruct_from_peaks(peak_params: List[float], x: np.ndarray) -> np.ndarray:
+    """
+    Reconstruct function from peak parameters with optimized Gaussian creation.
+    """
+    func = np.zeros_like(x)
+
+    # Peak parameters come in groups of 3: [position, height, width]
+    for i in range(0, len(peak_params), 3):
+        if i + 2 < len(peak_params):
+            pos = peak_params[i]
+            height = peak_params[i+1]
+            width = max(0.005, peak_params[i+2])  # Ensure minimum width
+
+            # Create Gaussian peak with better numerical stability
+            gaussian_peak = height * np.exp(-0.5 * ((x - pos) / width)**2)
+            func += gaussian_peak
+
+    return func
