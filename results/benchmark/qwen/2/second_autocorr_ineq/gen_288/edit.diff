 @jit(nopython=True)
 def gaussian_peak_function_numba(x, peak_params):
     """Fast Gaussian peak evaluation using Numba"""
     result = np.zeros_like(x)
     n_peaks = len(peak_params) // 3
 
     for i in range(n_peaks):
         amp = peak_params[i*3]
         center = peak_params[i*3 + 1]
         width = peak_params[i*3 + 2]
 
         # Avoid division by zero
         if width > 1e-6:
             for j in range(len(x)):
                 diff = (x[j] - center) / width
                 result[j] += amp * np.exp(-0.5 * diff * diff)
 
     return result
 
