+    # L2 norm squared (using trapezoidal-like scheme)
+    l2_sq = 0.0
+    for i in range(n - 1):
+        y1 = g_vals[i]
+        y2 = g_vals[i + 1]
+        l2_sq += (y1*y1 + y1*y2 + y2*y2) / 3.0
+    
+    # L1 norm
+    l1 = 0.0
+    for i in range(n):
+        l1 += abs(g_vals[i])
+    
+    # L-infinity norm
+    linf = 0.0
+    for i in range(n):
+        abs_val = abs(g_vals[i])
+        if abs_val > linf:
+            linf = abs_val
+    
+    return l2_sq, l1, linf
 
 class MultiScaleGaussianOptimizer:
