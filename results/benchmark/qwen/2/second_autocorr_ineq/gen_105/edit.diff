+def construct_function() -> List[float]:
+    """
+    Multi-scale peak placement optimizer for maximizing C₂ constant.
+    Uses strategic multi-scale peak distribution to create optimal autoconvolution properties.
+    """
+    optimizer = PeakOptimizer()
+    
+    # Parameters
+    n_steps = np.random.randint(2000, 8000)
