 def compute_autoconvolution_norms(f_values):
     """
     Compute the three norms needed for C2 calculation.
     """
     # Create step function with proper spacing
     n = len(f_values)
     if n < 1:
         return 0.0, 0.0, 0.0
 
     # Convert to numpy array
     f = np.array(f_values)
 
     # Create the step function on [-1/4, 1/4] with equal spacing
     dx = 0.5 / (n - 1) if n > 1 else 0.5
     x = np.linspace(-0.25, 0.25, n)
 
     # We'll use convolution to get g = f * f
     # Create extended arrays for proper convolution
     extended_f = np.concatenate([f[::-1], f, f[::-1]])
 
     # Use discrete convolution
     g = np.convolve(f, f, mode='full')
 
     # Keep only the middle part (proper autoconvolution)
     mid_idx = len(g) // 2
     g = g[mid_idx - (n-1):mid_idx + n]
 
     # Adjust for the fact that our function is defined on [-1/4, 1/4]
     # The actual convolution interval is [-1/2, 1/2]
     g_x = np.linspace(-0.5, 0.5, len(g))
 
     # Now compute the required norms
     # ||g||₂² (L2 norm squared)
     # Using trapezoidal integration approximation
     g_sq = g * g
     area = np.sum((g_sq[:-1] + g_sq[1:]) * (g_x[1:] - g_x[:-1])) / 2
     norm_2_sq = area
 
