+def chebyshev_nodes(n: int, a: float = -0.25, b: float = 0.25) -> np.ndarray:
+    """Generate Chebyshev nodes for better distribution."""
+    if n <= 0:
+        return np.array([])
+    
+    # Chebyshev nodes in [-1, 1], then map to [a, b]
+    k = np.arange(1, n + 1)
+    theta = (2*k - 1) * np.pi / (2*n)
+    nodes = np.cos(theta)
+    
+    # Map from [-1, 1] to [a, b]
+    return 0.5 * (b - a) * nodes + 0.5 * (b + a)
+
