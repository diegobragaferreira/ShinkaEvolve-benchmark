+class SequenceInitializer:
+    """Initializes sequences with structured patterns."""
+    
+    @staticmethod
+    def create(n: int) -> List[float]:
+        """Create a structured sequence that's more likely to yield good results."""
+        # Use a more sophisticated approach to mix multiple patterns
+        # This includes exponential decay, cosine envelope, and random components
+        
+        # Pattern 1: Exponential decay
+        exp_decay = np.exp(-np.linspace(0, 3, n))
+        
+        # Pattern 2: Cosine envelope for smoothness
+        cosine_env = 0.5 + 0.5 * np.cos(np.linspace(0, 2*np.pi, n))
+        
+        # Pattern 3: Random component with structured bias
+        random_part = np.random.rand(n)
+        
+        # Blend patterns with different weights
+        base_seq = 0.4 * exp_decay + 0.3 * cosine_env + 0.3 * random_part
+        
+        # Normalize and rescale
+        base_seq = base_seq / np.sum(base_seq) * 10
+        
+        # Ensure non-negativity and bounds
+        base_seq = np.clip(base_seq, 0, 1000)
+
+        return base_seq.tolist()
