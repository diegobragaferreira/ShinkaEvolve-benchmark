+def adaptive_step_size(current_inv_c1: float, iteration: int, prev_grad_norm: float = 1.0) -> float:
+    """
+    Adaptive step size based on convergence behavior with exponential decay.
+    """
+    # Base step size
+    base_step = 0.01
