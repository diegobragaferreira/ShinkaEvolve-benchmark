+def compute_convolution(seq):
+    """Compute the convolution of a sequence with itself."""
+    n = len(seq)
+    conv = np.zeros(2 * n - 1)
+    for i in range(n):
+        for j in range(n):
+            conv[i + j] += seq[i] * seq[j]
+    return conv[:n]
 
