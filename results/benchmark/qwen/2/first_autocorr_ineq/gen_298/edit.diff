+def hybrid_local_refinement(sequence: List[float], 
+                            max_iter: int = 50) -> List[float]:
+    """
+    Perform enhanced local refinement combining multiple strategies.
+    """
+    current = sequence.copy()
+    current_fitness = compute_c1_constant(current)
+    
+    for _ in range(max_iter):
+        # Generate candidate sequences using multiple tactics
+        candidates = []
+        
+        # 1. Random perturbations
+        for _ in range(3):
+            perturbed = current.copy()
+            idx = random.randint(0, len(perturbed) - 1)
+            delta = random.uniform(-0.1, 0.1) * perturbed[idx] if perturbed[idx] > 0 else random.uniform(-5, 5)
+            perturbed[idx] = max(0, min(1000, perturbed[idx] + delta))
+            candidates.append(perturbed)
+        
+        # 2. Spectral guided perturbation
+        try:
+            spectral_perturbed = spectral_filter(current)
+            candidates.append(spectral_perturbed)
+        except:
+            pass
+        
+        # 3. Gradient-like perturbation (direction towards improvement)
+        try:
+            # Simple heuristic: increase high-value elements and decrease low ones
+            avg_val = np.mean(current)
+            gradient_perturbed = [max(0, x + random.uniform(-0.05, 0.05) * (x - avg_val)) for x in current]
+            candidates.append(gradient_perturbed)
+        except:
+            pass
+        
+        # Evaluate candidates and accept the best improving one
+        best_candidate = None
+        best_fitness = current_fitness
+        
+        for candidate in candidates:
+            fitness = compute_c1_constant(candidate)
+            if fitness > best_fitness:
+                best_fitness = fitness
+                best_candidate = candidate
+        
+        if best_candidate is not None:
+            current = best_candidate
+            current_fitness = best_fitness
+        else:
+            # No improvement, consider breaking early
+            break
+    
+    return current
