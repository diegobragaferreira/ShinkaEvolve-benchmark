+def parallel_evaluate(population: List[List[float]]) -> List[float]:
+    """
+    Evaluate fitness of a population in parallel using ThreadPoolExecutor.
+    """
+    with ThreadPoolExecutor(max_workers=multiprocessing.cpu_count()) as executor:
+        futures = [executor.submit(compute_c1_constant, seq) for seq in population]
+        results = [future.result() for future in futures]
+    return results
