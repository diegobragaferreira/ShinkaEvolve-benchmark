+    def calculate_c1(self, sequence):
+        """Calculate the C1 constant for a given sequence."""
+        if len(sequence) == 0:
+            return float('inf')
+
+        sequence = np.array(sequence)
+        sum_a = np.sum(sequence)
+        if sum_a < 0.01:
+            return float('inf')
+
+        conv = self.compute_convolution_fft(sequence)
+        max_b = np.max(conv)
+        n = len(sequence)
