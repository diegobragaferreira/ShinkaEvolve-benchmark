+            mutated[i] += random.gauss(0, 0.05) * mutated[i] if mutated[i] > 0 else 0.01
+            mutated[i] = max(0, mutated[i])  # Ensure non-negativity
+    
+    # Re-normalize
+    sum_mut = np.sum(mutated)
+    if sum_mut > 0:
+        mutated = [x / sum_mut for x in mutated]
+    return mutated
