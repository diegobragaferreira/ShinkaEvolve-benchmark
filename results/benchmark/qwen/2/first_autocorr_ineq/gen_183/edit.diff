 def calculate_fitness(sequence):
     """Calculate fitness as inverse of C1, i.e., (sum(a))^2 / (2*n*max(conv))"""
     n = len(sequence)
     if n < 1:
         return 0.0
 
     sum_a = np.sum(sequence)
     if sum_a < 1e-10:
         return 0.0
 
     conv = convolve_fft(sequence, sequence)
     max_conv = np.max(conv)
 
     if max_conv < 1e-10:
         return 0.0
 
     # Calculate fitness: (sum(a))^2 / (2*n*max(conv))
     fitness = (sum_a ** 2) / (2 * n * max_conv)
     return fitness
 
+def tournament_selection(population, fitnesses, tournament_size=3):
+    """Select an individual using tournament selection."""
+    selected_indices = random.sample(range(len(population)), tournament_size)
+    best_idx = max(selected_indices, key=lambda i: fitnesses[i])
+    return population[best_idx][:]
+
+def crossover(parent1, parent2):
+    """Single-point crossover."""
+    n = len(parent1)
+    if n < 2:
+        return parent1[:]
+        
+    crossover_point = random.randint(1, n - 1)
+    child = parent1[:crossover_point] + parent2[crossover_point:]
+    
+    # Normalize child
+    sum_child = np.sum(child)
+    if sum_child > 0:
+        child = [x / sum_child for x in child]
+    return child
+
+def mutate_individual(individual, mutation_rate=0.1):
+    """Mutate an individual with a certain probability."""
+    mutated = individual[:]
