+    def get_hexagon_edges(vertices: np.ndarray) -> List[np.ndarray]:
+        """Get list of edges from hexagon vertices"""
+        edges = []
+        n = len(vertices)
+        for i in range(n):
+            p1 = vertices[i]
+            p2 = vertices[(i+1) % n]
