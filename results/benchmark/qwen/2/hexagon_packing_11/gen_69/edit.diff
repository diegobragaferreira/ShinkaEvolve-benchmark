+    # Check containment of all inner hexagons
+    for i in range(n):
+        x, y = positions[i]
+        rot = rotations[i]
+        hex_vertices = hexagon_vertices(x, y, rot, 1)
+        
+        # Check if all vertices are within outer hexagon
