+def cartesian_to_polar(cartesian_data):
+    """Convert Cartesian coordinates to polar"""
+    polar = []
+    for x, y, angle in cartesian_data:
+        r = math.sqrt(x**2 + y**2)
+        theta = math.degrees(math.atan2(y, x)) % 360
+        polar.append([r, theta, angle])
+    return polar
