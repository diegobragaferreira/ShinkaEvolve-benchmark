+    
+    # Compute centroid
+    centroid = np.mean(hull_points, axis=0)
+    
+    # Find maximum distance from centroid
+    distances = np.sqrt(np.sum((hull_points - centroid)**2, axis=1))
+    max_distance = np.max(distances)
+    
+    # Add margin for safety
