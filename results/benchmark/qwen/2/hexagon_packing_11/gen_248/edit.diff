+    # Fitness is negative inverse of side length plus penalties  
+    # We want to minimize side length, so maximize 1/side_length
+    fitness = -1.0 / outer_side_length
+    if penalty > 0:
+        fitness -= penalty  # Add penalty for constraint violations
+    
+    return (fitness,)
