+def generate_hexagon_vertices(center_x, center_y, side_length, rotation_deg):
+    """Generate vertices of a regular hexagon given center, side length, and rotation."""
+    rotation_rad = np.radians(rotation_deg)
+    angles = np.linspace(0, 2*np.pi, 7)[:-1] + rotation_rad
+    vertices = np.column_stack([
+        center_x + side_length * np.cos(angles),
+        center_y + side_length * np.sin(angles)
+    ])
+    return vertices
+
+def check_hexagon_containment(hexagon_vertices, outer_hex_vertices):
+    """Check if all vertices of inner hexagon are within outer hexagon."""
+    outer_polygon = Polygon(outer_hex_vertices)
+    for vertex in hexagon_vertices:
+        if not outer_polygon.contains(Point(vertex[0], vertex[1])):
+            return False
+    return True
+
+def check_hexagon_overlap(hex1_vertices, hex2_vertices):
+    """Check if two hexagons overlap using Shapely."""
+    poly1 = Polygon(hex1_vertices)
+    poly2 = Polygon(hex2_vertices)
+    return poly1.intersects(poly2)
+
+def calculate_outer_hexagon_radius(inner_hex_data, buffer=0.1):
+    """Calculate required outer hexagon radius to contain all inner hexagons."""
+    # Get all vertices of all inner hexagons
+    all_vertices = []
+    for i in range(len(inner_hex_data)):
+        center_x, center_y, angle = inner_hex_data[i]
+        vertices = generate_hexagon_vertices(center_x, center_y, 1.0, angle)
+        all_vertices.extend(vertices)
+    
+    # Center the points and find max distance from center
+    if len(all_vertices) == 0:
+        return 1.0
+    
+    all_vertices = np.array(all_vertices)
+    center = np.mean(all_vertices, axis=0)
+    distances = np.sqrt(np.sum((all_vertices - center)**2, axis=1))
+    max_distance = np.max(distances)
+    
+    # Add buffer to ensure containment
+    return max_distance * (1 + buffer)
+
+def compute_total_score(inner_hex_data, outer_hex_side_length):
+    """Compute the inverse of outer hexagon side length as the primary score."""
+    return 1.0 / outer_hex_side_length
+
+def evaluate_configuration(inner_hex_data, outer_hex_side_length):
+    """Evaluate the configuration for validity and compute score."""
+    # Generate outer hexagon vertices
+    outer_center = [0, 0]
+    outer_angle = 0
+    outer_vertices = generate_hexagon_vertices(outer_center[0], outer_center[1], outer_hex_side_length, outer_angle)
+    
+    # Check all inner hexagons for containment
+    for i in range(len(inner_hex_data)):
+        center_x, center_y, angle = inner_hex_data[i]
+        hex_vertices = generate_hexagon_vertices(center_x, center_y, 1.0, angle)
+        
+        # Check containment
+        if not check_hexagon_containment(hex_vertices, outer_vertices):
+            return -np.inf
+        
+        # Check overlap with all other hexagons
+        for j in range(i + 1, len(inner_hex_data)):
+            center_x2, center_y2, angle2 = inner_hex_data[j]
+            hex2_vertices = generate_hexagon_vertices(center_x2, center_y2, 1.0, angle2)
+            
+            if check_hexagon_overlap(hex_vertices, hex2_vertices):
+                return -np.inf
+    
+    return compute_total_score(inner_hex_data, outer_hex_side_length)
+
+def objective_function(params):
+    """Objective function for optimization."""
+    # Reshape params into 11 hexagons with (center_x, center_y, angle)
+    inner_hex_data = params.reshape(-1, 3)
+    
+    # Calculate outer hexagon side length needed
+    outer_hex_side_length = calculate_outer_hexagon_radius(inner_hex_data)
+    
+    # Evaluate the configuration
+    score = evaluate_configuration(inner_hex_data, outer_hex_side_length)
+    
+    # Return negative because we're minimizing
+    return -score
 
