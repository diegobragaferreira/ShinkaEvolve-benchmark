 @jit(nopython=True)
 def hexagon_vertices_jit(center_x, center_y, angle_deg, radius=1.0):
     """Compute hexagon vertices efficiently using numba"""
     vertices = np.zeros((6, 2))
     angle_rad = np.radians(angle_deg)
     for i in range(6):
         theta = angle_rad + i * np.pi/3
         vertices[i, 0] = center_x + radius * np.cos(theta)
         vertices[i, 1] = center_y + radius * np.sin(theta)
     return vertices
 
 @jit(nopython=True)
 def point_in_hexagon_jit(px, py, center_x, center_y, angle_deg, radius=1.0):
     """Fast point-in-hexagon test using numba with improved precision"""
     # Transform point to hexagon's local coordinate system
     angle_rad = np.radians(angle_deg)
     rel_x = px - center_x
     rel_y = py - center_y
 
     # Rotate point back to align with hexagon axes
     cos_a = np.cos(-angle_rad)
     sin_a = np.sin(-angle_rad)
     rot_x = rel_x * cos_a - rel_y * sin_a
     rot_y = rel_x * sin_a + rel_y * cos_a
 
     # Hexagon dimensions
     hex_width = radius * np.sqrt(3)
     half_width = hex_width / 2
     max_y = radius * np.sqrt(3) / 2
 
     # Check bounds with small epsilon for numerical stability
     if abs(rot_x) > half_width * 1.0001 or abs(rot_y) > max_y * 1.0001:
         return False
     return True
 
 @jit(nopython=True)
 def check_containment_buffered(hex_vertices, outer_center_x, outer_center_y, outer_radius):
     """Check containment with small buffer for floating-point precision issues"""
     # Check if all vertices are within the outer hexagon with a small buffer
     outer_circumradius = outer_radius * np.sqrt(3) / 2
 
     # Add small buffer to circumradius for numerical stability
     buffered_radius = outer_circumradius * 0.9999
 
     for i in range(6):
         vertex = hex_vertices[i]
         dist_from_center = np.sqrt((vertex[0] - outer_center_x)**2 + (vertex[1] - outer_center_y)**2)
         if dist_from_center > buffered_radius:
             return False
     return True
 
