+def heuristic_solution() -> np.ndarray:
+    """Fallback solution using hexagonal packing heuristic"""
+    n = 26
+    circles = np.zeros((n, 3))
+
+    # Place circles in a hexagonal lattice pattern
+    # This is not optimal but gives a reasonable starting point
+    
+    # Estimate grid size
+    rows = int(math.ceil(math.sqrt(n)))
+    cols = int(math.ceil(n / rows))
+    
+    # Use a more sophisticated grid layout
+    spacing_x = 1.0 / (cols + 2)
+    spacing_y = 1.0 / (rows + 2)
+    
+    # Hexagonally packed pattern
+    idx = 0
+    for i in range(rows):
+        for j in range(cols):
+            if idx >= n:
+                break
+                
+            # Offset every other row
+            offset = (i % 2) * 0.5 * spacing_x
+            x = (j + 1) * spacing_x + offset
+            y = (i + 1) * spacing_y
+            # Radius is limited by proximity to edges
+            r = min(x, 1-x, y, 1-y) * 0.35
+            
+            # Ensure positive radius
+            r = max(0.001, r)
+            circles[idx] = [x, y, r]
+            idx += 1
+
+    # If we don't have enough circles, fill remaining positions with small radii
+    for i in range(idx, n):
+        circles[i] = [0.5, 0.5, 0.01]
+
+    return circles
