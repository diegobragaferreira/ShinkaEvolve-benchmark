+class CrossoverOperator:
+    """Handles crossover operations with adaptive probabilities"""
+    
+    @staticmethod
+    def adaptive_crossover(parent1: np.ndarray, parent2: np.ndarray) -> np.ndarray:
+        """Constraint-aware crossover that considers overlap risks between parent circles"""
+        child = parent1.copy()
+
+        # Calculate pairwise distances to assess overlap risk
+        points1 = parent1[:, :2]
+        points2 = parent2[:, :2]
+
+        # For each circle, determine crossover probability based on overlap risk
+        for i in range(len(child)):
+            # Calculate proximity to other circles in both parents
+            dist1_min = np.min([np.sqrt((parent1[i, 0] - parent1[j, 0])**2 + (parent1[i, 1] - parent1[j, 1])**2)
+                               for j in range(len(parent1)) if j != i] + [100])
+            dist2_min = np.min([np.sqrt((parent2[i, 0] - parent2[j, 0])**2 + (parent2[i, 1] - parent2[j, 1])**2)
+                               for j in range(len(parent2)) if j != i] + [100])
+
+            # Use minimum distance to neighbors as indicator of overlap risk
+            avg_neighbor_dist = (dist1_min + dist2_min) / 2
+
+            # Higher crossover probability for distant circles (lower risk), lower for close ones
+            # This creates an adaptive crossover rate based on geometric proximity
+            crossover_prob = max(0.4, 0.9 - avg_neighbor_dist * 0.8)
+
+            # Apply crossover with adaptive probability
+            if np.random.rand() < crossover_prob:
+                # Determine which genes to swap with different probabilities
+                # Position genes (x,y) more likely to be swapped for distant circles
+                if np.random.rand() < 0.8:  # 80% chance to swap position
+                    child[i, 0] = parent2[i, 0]
