                 mutated[i, 2] += np.random.normal(0, max_mutation/2)
                 # Ensure radius remains positive
                 mutated[i, 2] = max(0.001, mutated[i, 2])
 
     # Apply constraint repair
     mutated = repair_constraints(mutated)
 
     return mutated
 
