+    def _objective_function(self, flat_params: np.ndarray) -> float:
+        """
+        Objective function for optimization.
+        Flat params format: [x1, y1, r1, x2, y2, r2, ..., x26, y26, r26]
+        """
+        # Reshape flat parameters back to circles
+        circles = flat_params.reshape(-1, 3)
+        
+        # Calculate sum of radii (negative because we want to maximize)
+        obj_value = -self._calculate_sum_radii(circles)
+        
+        return obj_value
+    
+    def _constraint_function(self, flat_params: np.ndarray) -> np.ndarray:
+        """
+        Constraint function for optimization.
+        Returns array of constraint violations (positive = violation).
+        """
+        circles = flat_params.reshape(-1, 3)
+        constraints = []
+        
+        # Containment constraints: radius <= x, y, 1-x, 1-y
+        for i in range(self.n_circles):
+            x, y, r = circles[i]
+            constraints.extend([
+                r - x,      # r <= x
+                r - y,      # r <= y
+                r - (1-x),  # r <= 1-x
+                r - (1-y)   # r <= 1-y
+            ])
+            
+        # Overlap constraints
+        if self.n_circles > 1:
+            for i in range(self.n_circles):
+                for j in range(i+1, self.n_circles):
+                    x1, y1, r1 = circles[i]
+                    x2, y2, r2 = circles[j]
+                    dist = np.sqrt((x1 - x2)**2 + (y1 - y2)**2)
+                    # Violation if dist < r1 + r2 (i.e., negative value means violation)
+                    constraints.append(-(dist - (r1 + r2)))
+                    
+        return np.array(constraints)
+    
+    def _optimize_single_step(self, circles: np.ndarray) -> np.ndarray:
+        """Optimize a single configuration using mathematical programming."""
+        # Flatten the circles array for optimization
+        flat_init = circles.flatten()
+        
+        # Define bounds for variables: (x, y, r) for each circle
+        bounds = []
+        for i in range(self.n_circles):
+            # X bounds: [0, 1]
+            bounds.append((0, 1))
+            # Y bounds: [0, 1]  
+            bounds.append((0, 1))
+            # R bounds: [0.01, 0.5]
+            bounds.append((0.01, 0.5))
+        
+        # Define constraints
+        # Note: For scipy minimize, inequality constraints are of form g(x) <= 0
+        # So we need to rewrite our constraints accordingly
+        constraints = {
+            'type': 'ineq',
+            'fun': lambda x: -self._constraint_function(x)  # Transform to g(x) <= 0
+        }
+        
+        try:
+            # Use SLSQP method which handles constraints well
+            result = minimize(
+                fun=self._objective_function,
+                x0=flat_init,
+                method='SLSQP',
+                bounds=bounds,
+                constraints=constraints,
+                options={'maxiter': 500, 'ftol': 1e-6}
+            )
+            
+            if result.success:
+                optimized_circles = result.x.reshape(-1, 3)
+                return optimized_circles
+        except:
+            pass
+            
+        # If optimization fails, return original circles
+        return circles
