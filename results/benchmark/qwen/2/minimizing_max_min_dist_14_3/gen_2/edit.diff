+def generate_initial_points(n: int) -> np.ndarray:
+    """Generate initial point configuration"""
+    # Try to create a good starting configuration
+    # Use Fibonacci spiral on sphere for even distribution
+    points = []
+    phi = math.acos(-1 + (2 * 1) / n)  # angle between points
+
+    for i in range(n):
+        theta = math.sqrt(n * math.pi) * phi
+        x = math.sin(theta) * math.cos(i * 2 * math.pi / math.sqrt(n))
+        y = math.sin(theta) * math.sin(i * 2 * math.pi / math.sqrt(n))
+        z = math.cos(theta)
+        points.append([x, y, z])
+
+    return np.array(points)
+
+
+def compute_min_max_ratio(points: np.ndarray) -> Tuple[float, float]:
+    """Compute min/max distance ratio for given points"""
+    distances = pdist(points)
+    min_dist = np.min(distances)
+    max_dist = np.max(distances)
+
+    if max_dist > 0:
+        return min_dist / max_dist, min_dist / max_dist
+    else:
+        return 0.0, 0.0
+
+
+def optimize_points(initial_points: np.ndarray, max_iter: int = 10000) -> np.ndarray:
+    """Optimize point configuration using simulated annealing"""
