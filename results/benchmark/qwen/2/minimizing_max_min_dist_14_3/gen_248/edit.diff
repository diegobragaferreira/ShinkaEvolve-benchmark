+    def _project_to_sphere(self, points: np.ndarray) -> np.ndarray:
+        """Project points onto unit sphere."""
+        norms = np.linalg.norm(points, axis=1)
+        norms = np.where(norms == 0, 1, norms)
+        return points / norms[:, np.newaxis]
