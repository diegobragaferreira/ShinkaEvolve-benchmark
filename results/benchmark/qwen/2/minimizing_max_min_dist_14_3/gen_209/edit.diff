     def fibonacci_sphere(n):
         """Generate n points distributed approximately uniformly on a sphere."""
         points = []
         phi = (1 + np.sqrt(5)) / 2  # golden ratio
         for i in range(n):
             z = 1 - (i / (n - 1)) * 2  # z goes from 1 to -1
