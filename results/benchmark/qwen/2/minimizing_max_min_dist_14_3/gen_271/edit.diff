 class SphereClusterOptimizer:
     def __init__(self):
         self.best_points = None
         self.best_ratio = 0.0
 
     def compute_min_max_ratio(self, points: np.ndarray) -> float:
         """Compute the ratio of minimum to maximum distances."""
         if len(points) < 2:
             return 0.0
         distances = pdist(points)
         return np.min(distances) / np.max(distances) if np.max(distances) > 0 else 0
 
     def icosahedron_vertices(self) -> np.ndarray:
         """Generate vertices of a regular icosahedron."""
         phi = (1 + np.sqrt(5)) / 2  # golden ratio
         vertices = []
         # Add vertices at (±1, ±φ, 0), (0, ±1, ±φ), (±φ, 0, ±1)
         for i in [1, -1]:
             for j in [1, -1]:
                 vertices.append([i, j * phi, 0])
                 vertices.append([0, i, j * phi])
                 vertices.append([i * phi, 0, j])
         return np.array(vertices)
 
     def project_to_sphere(self, points: np.ndarray) -> np.ndarray:
         """Project points onto unit sphere."""
         norms = np.linalg.norm(points, axis=1)
         norms = np.where(norms == 0, 1, norms)
         return points / norms[:, np.newaxis]
 
     def compute_clusters(self, points: np.ndarray, threshold: float = 0.5) -> List[List[int]]:
         """Group points into clusters based on proximity."""
         n = len(points)
         if n <= 1:
             return [[i] for i in range(n)]
 
         # Compute distance matrix
         distances = cdist(points, points)
         np.fill_diagonal(distances, np.inf)
 
         # Initialize clusters
         clusters = []
         used = np.zeros(n, dtype=bool)
 
         for i in range(n):
             if not used[i]:
                 # Start new cluster
                 cluster = [i]
                 used[i] = True
 
                 # Find all points within threshold distance
                 distances_from_i = distances[i]
                 neighbors = np.where((distances_from_i < threshold) & ~used)[0]
 
                 for neighbor in neighbors:
                     cluster.append(neighbor)
                     used[neighbor] = True
 
                 clusters.append(cluster)
 
         return clusters
 
     def cluster_repulsion_force(self, points: np.ndarray, clusters: List[List[int]]) -> np.ndarray:
         """Compute repulsion forces within and between clusters."""
         n = len(points)
         forces = np.zeros_like(points)
 
         # Within-cluster repulsion (stronger)
         for cluster in clusters:
             if len(cluster) <= 1:
                 continue
             cluster_points = points[cluster]
             cluster_center = np.mean(cluster_points, axis=0)
 
             # Repel each point from cluster center
             for i, idx in enumerate(cluster):
                 vec_to_center = cluster_center - points[idx]
                 # Normalize and scale by inverse distance
                 dist = np.linalg.norm(vec_to_center)
                 if dist > 1e-10:
                     force = vec_to_center / (dist * dist * dist + 1e-10)
                     forces[idx] += 2.0 * force  # Stronger force within cluster
 
         # Between-cluster repulsion (weaker)
         if len(clusters) > 1:
             for i, cluster1 in enumerate(clusters):
                 for j, cluster2 in enumerate(clusters[i+1:], i+1):
                     # Compute centers
                     center1 = np.mean(points[cluster1], axis=0)
                     center2 = np.mean(points[cluster2], axis=0)
                     vec_between = center1 - center2
 
                     dist = np.linalg.norm(vec_between)
                     if dist > 1e-10:
                         # Repel clusters
                         force = vec_between / (dist * dist * dist + 1e-10) * 0.5
                         for idx in cluster1:
                             forces[idx] -= force * 0.2
                         for idx in cluster2:
                             forces[idx] += force * 0.2
 
         return forces
 
     def generate_initial_configurations(self, num_configs: int = 5) -> List[np.ndarray]:
