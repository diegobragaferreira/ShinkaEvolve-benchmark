+    def _calculate_ratio(self, points: np.ndarray) -> float:
+        """Calculate the ratio of minimum to maximum distances."""
+        d_min, d_max = self._calculate_distances_fast(points)
+        if d_max <= 0:
+            return 0.0
+        return d_min / d_max
