+        if len(points) < 2:
+            return 0.0, 0.0
+
+        try:
+            # Use pdist for efficient pairwise distance calculation
+            distances = pdist(points)
+            d_min = np.min(distances)
+            d_max = np.max(distances)
+            return d_min, d_max
+        except Exception:
+            return 0.0, 0.0
