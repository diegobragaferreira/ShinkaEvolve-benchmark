+def perturb_points(points, temperature, perturbation_scale=0.01):
+    """Perturb points with temperature-dependent magnitude"""
+    n_points = points.shape[0]
+
+    # Select random point to perturb
+    idx = np.random.randint(0, n_points)
+
+    # Generate perturbation vector
+    perturbation = np.random.randn(3) * perturbation_scale * temperature
+
+    # Apply perturbation
+    new_points = points.copy()
+    new_points[idx] += perturbation
+
+    # Project back to unit sphere
+    norm = np.linalg.norm(new_points[idx])
+    if norm > 0:
+        new_points[idx] = new_points[idx] / norm
+
+    return new_points
