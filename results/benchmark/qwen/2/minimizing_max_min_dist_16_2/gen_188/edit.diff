+    @staticmethod
+    def _compute_min_max_ratio(points: np.ndarray) -> float:
+        """Compute the minimum to maximum distance ratio for given points."""
+        if len(points) < 2:
+            return 0.0
+
+        distances = pdist(points)
+        min_dist = np.min(distances)
+        max_dist = np.max(distances)
+
+        if max_dist == 0:
+            return 0.0
+
+        return min_dist / max_dist
+
+class AdaptiveOptimizer:
+    """Manages adaptive optimization strategies based on configuration quality."""
+    
+    def __init__(self):
+        self.config_generator = PointConfigurationGenerator()
+    
+    def objective_with_regularization(self, x: np.ndarray) -> float:
+        """Objective function with regularization to avoid numerical issues."""
+        points = x.reshape(-1, 2)
+        distances = pdist(points)
+
+        min_dist = np.min(distances)
+        max_dist = np.max(distances)
+
+        eps = 1e-12
+        if max_dist < eps:
+            return -1.0
+
+        ratio = min_dist / (max_dist + eps)
+        return -ratio
+
+    def _run_local_optimization(self, x0: np.ndarray, bounds: List[Tuple[float, float]], 
+                               maxiter: int = 1000, ftol: float = 1e-10, gtol: float = 1e-10) -> minimize.OptimizeResult:
+        """Perform local optimization with specified parameters."""
+        try:
+            return minimize(
+                self.objective_with_regularization,
+                x0,
+                method='L-BFGS-B',
+                bounds=bounds,
+                options={'maxiter': maxiter, 'ftol': ftol, 'gtol': gtol}
+            )
+        except Exception as e:
+            warnings.warn(f"Local optimization failed: {e}")
+            return type('obj', (object,), {'x': x0, 'success': False})()
+
+    def _run_global_optimization(self, bounds: List[Tuple[float, float]], 
+                                timeout: float, popsize: int = 25) -> Optional[np.ndarray]:
+        """Perform global optimization using differential evolution."""
+        try:
+            result_de = differential_evolution(
+                self.objective_with_regularization,
+                bounds,
+                seed=42,
+                maxiter=int(timeout/2),
