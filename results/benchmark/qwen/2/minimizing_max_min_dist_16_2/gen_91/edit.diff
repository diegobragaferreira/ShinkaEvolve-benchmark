                 current_best_points = bh_points.copy()
 
         except Exception as e:
             print(f"Basin hopping failed for config {i}: {e}")
 
         try:
             # Second: Try Nelder-Mead as a fallback
             nm_result = minimize(
                 objective,
                 initial_guess.flatten(),
                 method='Nelder-Mead',
                 options={'maxiter': 500, 'adaptive': True},
                 timeout=max_time - (time.time() - start_time)
             )
 
             nm_points = nm_result.x.reshape(-1, 2)
             nm_ratio = compute_min_max_ratio(nm_points)
 
             if nm_ratio > current_best_ratio:
                 current_best_ratio = nm_ratio
                 current_best_points = nm_points.copy()
 
         except Exception as e:
             print(f"Nelder-Mead failed for config {i}: {e}")
 
         try:
