         current_best_ratio = -np.inf
         current_best_points = initial_guess.copy()
 
         try:
             # First: Try Basin Hopping which is good for escaping local minima
             bh_result = basinhopping(
                 objective,
                 initial_guess.flatten(),
                 niter=100,
                 T=1.0,
                 stepsize=0.1,
                 minimizer_kwargs={'method': 'L-BFGS-B', 'bounds': bounds},
                 callback=callback,
