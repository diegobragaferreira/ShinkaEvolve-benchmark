+            entropy = self.calculate_voronoi_entropy(points)
+            entropy_factor = np.exp(-entropy / 10.0)  # Scale entropy effect
+            
+            # Combined fitness: higher ratio AND more uniform distribution
+            if ratio > 0:
+                fitness = ratio * entropy_factor
+            else:
+                fitness = 0.0
+                
+            return fitness
