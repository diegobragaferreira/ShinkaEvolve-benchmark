+def fast_pairwise_distances(points):
+    """Fast computation of pairwise distances using numba."""
     n = points.shape[0]
     distances = np.zeros((n, n))
     for i in range(n):
         for j in range(i+1, n):
             dx = points[i, 0] - points[j, 0]
             dy = points[i, 1] - points[j, 1]
             dist = np.sqrt(dx*dx + dy*dy)
             distances[i, j] = dist
             distances[j, i] = dist
     return distances
 
