     def _compute_distance_ratio(self, points):
         """Compute the minimum/maximum distance ratio"""
         if len(points) < 2:
             return 0
 
         distances = pdist(points)
         if len(distances) == 0:
             return 0
 
         d_min = np.min(distances)
         d_max = np.max(distances)
 
         # Avoid division by zero
         if d_max <= 1e-12:
             return 0
 
         return d_min / d_max
 
