                         objective_func,
                         bounds,
                         seed=42 + iteration,
                         maxiter=10,
                         popsize=10,
                         tol=1e-9,
                         mutation=(0.7, 1.0),
                         recombination=0.7,
                         disp=False
                     )
 
             # Check for improvement
