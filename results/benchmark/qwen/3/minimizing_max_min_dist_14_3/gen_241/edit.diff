+    def crossover(parent1, parent2):
+        """Single-point crossover for spherical coordinates"""
+        crossover_point = np.random.randint(1, len(parent1))
+        child = np.vstack([
+            parent1[:crossover_point],
+            parent2[crossover_point:]
+        ])
+        return child
+
