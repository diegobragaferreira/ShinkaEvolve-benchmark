 def create_initial_placement():
     """Create initial point placement using a combination of methods."""
     # Method 1: Fibonacci spiral on sphere (good initial spread)
     points = []
     phi = np.pi * (3 - np.sqrt(5))  # golden angle
 
     for i in range(14):
         y = 1 - (i / float(14 - 1)) * 2  # y goes from 1 to -1
         radius = np.sqrt(1 - y * y)  # radius at y
 
         theta = phi * i  # golden angle increment
 
         x = np.cos(theta) * radius
         z = np.sin(theta) * radius
 
         points.append([x, y, z])
 
     initial_points = np.array(points)
 
     # Add some randomness to avoid perfect symmetry
     np.random.seed(42)
     noise = np.random.normal(0, 0.05, (14, 3))
     initial_points += noise
 
     # Normalize to unit sphere
     initial_points = spherical_map(initial_points)
 
     # Scale to unit cube [0,1]^3
     initial_points = (initial_points + 1) / 2
 
     return initial_points
 
