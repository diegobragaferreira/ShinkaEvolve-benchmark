+    def compute_voronoi_cell_volumes(points):
+        """Compute approximate Voronoi cell volumes for points on unit sphere."""
+        if len(points) < 2:
+            return np.array([])
+        
+        # Normalize points to unit sphere (important for spherical Voronoi)
+        norms = np.linalg.norm(points, axis=1, keepdims=True)
+        normalized_points = points / np.maximum(norms, 1e-10)
+        
+        try:
+            # For spherical Voronoi, we need a proper setup
+            sv = SphericalVoronoi(normalized_points, radius=1.0, center=np.array([0,0,0]))
+            
+            # Get cell volumes (approximate) - for points on unit sphere, 
+            # volumes can be computed from the spherical polygons
+            volumes = sv.calculate_volumes()
+            return volumes
+        except:
+            # Fallback: compute approximate volumes based on neighbor distances
+            distances = cdist(normalized_points, normalized_points)
+            np.fill_diagonal(distances, np.inf)
+            
+            # Use minimum distance as proxy for cell size
+            min_distances = np.min(distances, axis=1)
+            # Inverse relationship - smaller distances mean larger cells
+            volumes = 1.0 / (min_distances + 1e-10)
+            return volumes
