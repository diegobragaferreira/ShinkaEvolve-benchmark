     def _calculate_ratio(self, points):
         """Calculate the min/max distance ratio for a given layout."""
         distances = pdist(points)
         
         if len(distances) == 0:
             return 0.0
         
         min_dist = np.min(distances)
         max_dist = np.max(distances)
         
         if max_dist <= 0:
             return 0.0
         
