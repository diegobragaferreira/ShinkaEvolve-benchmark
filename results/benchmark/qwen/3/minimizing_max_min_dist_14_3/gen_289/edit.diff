+        d_min = np.min(distances)
+        d_max = np.max(distances)
+        
+        if d_max <= 0:
+            return float('inf') + below_penalty + above_penalty
+            
+        # Return negative ratio plus penalty (to minimize)
+        return -(d_min / d_max) + below_penalty + above_penalty
