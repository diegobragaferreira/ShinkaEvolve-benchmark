     def calculate_ratio(points: np.ndarray) -> float:
         """Calculate min/max distance ratio"""
         if len(points) < 2:
             return 0
         
         # Compute pairwise distances using scipy
         distances = pdist(points)
         
         if len(distances) == 0:
             return 0
             
         d_min = np.min(distances)
         d_max = np.max(distances)
         
         if d_max <= 0:
             return 0
             
         return d_min / d_max
     
