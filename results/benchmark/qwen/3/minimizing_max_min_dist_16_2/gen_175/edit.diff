+            clustering_indicator = 0.0
+            
+        # Normalized standard deviation as measure of spread consistency
+        if mean_dist > 0:
+            spread_consistency = std_dist / mean_dist
+        else:
+            spread_consistency = 1.0
+            
+        return clustering_indicator, spread_consistency
