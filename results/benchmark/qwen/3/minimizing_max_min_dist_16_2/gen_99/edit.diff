+            else:
+                warnings.warn(f"L-BFGS-B optimization failed: {result.message}")
+                return points, FitnessEvaluator.compute_ratio(points)
+                
+        except Exception as e:
+            warnings.warn(f"L-BFGS-B optimization error: {str(e)}")
+            return points, FitnessEvaluator.compute_ratio(points)
