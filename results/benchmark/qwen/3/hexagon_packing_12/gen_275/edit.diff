+        except:
+            return False
+            
+    def check_containment(self, inner_hex: Polygon, outer_hex: Polygon) -> bool:
+        """Check if inner hexagon is fully contained within outer hexagon."""
+        try:
+            return outer_hex.contains(inner_hex)
+        except:
+            return False
