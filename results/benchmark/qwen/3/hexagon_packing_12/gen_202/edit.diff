     def optimize_positions(self, initial_config, outer_center_x, outer_center_y):
         """Optimize positions using staged optimization with early stopping."""
         def objective(params):
             # Reconstruct configuration from flattened parameters
             config = initial_config.copy()
             # Update positions only
             idx = 0
             for i in range(len(config)):
                 config[i][0] = params[idx]
                 config[i][1] = params[idx + 1]
                 idx += 2
 
             validity, inv_radius = self.evaluate_configuration(config, outer_center_x, outer_center_y)
             if not validity:
                 return 1e10  # Large penalty for invalid configurations
             return -inv_radius  # Negative because we want to maximize
 
         # Flatten initial configuration for optimization
         initial_params = []
         for i in range(len(initial_config)):
             initial_params.extend([initial_config[i][0], initial_config[i][1]])
 
         # Multi-stage optimization with progressive tightening
         stages = [
             {'bounds': [(-8, 8), (-8, 8)] * len(initial_config), 'maxiter': 500, 'ftol': 1e-8},
             {'bounds': [(-6, 6), (-6, 6)] * len(initial_config), 'maxiter': 300, 'ftol': 1e-10},
             {'bounds': [(-5, 5), (-5, 5)] * len(initial_config), 'maxiter': 200, 'ftol': 1e-12}
         ]
 
         current_params = initial_params.copy()
 
         for stage in stages:
             # Check time budget before continuing
             if self.get_current_time() > self.max_time * 0.9:
                 break
 
             try:
                 result = minimize(objective, current_params, method='L-BFGS-B',
                                 bounds=stage['bounds'],
                                 options={'maxiter': stage['maxiter'], 'ftol': stage['ftol']})
                 if result.success:
                     current_params = result.x.copy()
                 else:
                     # If it failed, just continue with current params
                     break
             except Exception:
                 break  # Continue with what we have
 
         # Reconstruct optimized configuration
         optimized_config = initial_config.copy()
         idx = 0
         for i in range(len(optimized_config)):
             optimized_config[i][0] = current_params[idx]
             optimized_config[i][1] = current_params[idx + 1]
             idx += 2
 
         return optimized_config
 
