                     delta = np.random.normal(0, 15)
                     mutated[i] += delta
                     mutated[i] = mutated[i] % 360
             else:  # outer side length parameter
                 # Mutate outer side length with larger step
                 delta = np.random.normal(0, 0.3)
                 mutated[i] = max(1.0, mutated[i] + delta)
 
