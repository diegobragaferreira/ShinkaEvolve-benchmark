         x = radius * np.cos(angle)
         y = radius * np.sin(angle)
         angle_deg = random.uniform(0, 360)
         config.extend([x, y, angle_deg])
 
     # Add outer side length parameter
     config.append(random.uniform(5.0, 10.0))
 
     return np.array(config)
 
