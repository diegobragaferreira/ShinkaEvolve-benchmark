+            )
+            for j in range(i+1, len(hex_data)):
+                hex2_vertices = self.config_manager.create_hexagon_vertices(
+                    hex_data[j][0], hex_data[j][1], 
+                    self.config_manager.hex_side_length, hex_data[j][2]
