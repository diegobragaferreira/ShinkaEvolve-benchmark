+class SymmetryAwareMutation:
+    """Handles mutation strategies that preserve geometric symmetries"""
+    
+    @staticmethod
+    def mutate_symmetrically(hex_data: np.ndarray, mutation_strength: float = 0.2) -> np.ndarray:
+        """Apply symmetric mutation to maintain hexagonal properties"""
+        mutated_data = hex_data.copy()
+        
+        # Mutate center hexagon
+        mutated_data[0][0] += random.uniform(-mutation_strength, mutation_strength)
+        mutated_data[0][1] += random.uniform(-mutation_strength, mutation_strength)
+        
+        # Mutate radial positions while preserving symmetry patterns
+        for i in range(1, len(hex_data)):
+            if i <= 6:  # First ring
+                mutated_data[i][0] += random.uniform(-mutation_strength, mutation_strength)
+                mutated_data[i][1] += random.uniform(-mutation_strength, mutation_strength)
+            elif i <= 10:  # Second ring (corners)
+                mutated_data[i][0] += random.uniform(-mutation_strength, mutation_strength)
+                mutated_data[i][1] += random.uniform(-mutation_strength, mutation_strength)
+            else:  # Far positions
+                mutated_data[i][0] += random.uniform(-mutation_strength, mutation_strength)
+                mutated_data[i][1] += random.uniform(-mutation_strength, mutation_strength)
+                
+        return mutated_data
