+        # Second ring - similarly perturbed 
+        for i in range(6):
+            angle = 30 + i * 60 + (np.random.rand() - 0.5) * 5
+            radius = 3.464 + (np.random.rand() - 0.5) * 0.3
+            x = radius * np.cos(np.radians(angle))
+            y = radius * np.sin(np.radians(angle))
+            config.append([x, y, 0])
+            
+        return np.array(config)
