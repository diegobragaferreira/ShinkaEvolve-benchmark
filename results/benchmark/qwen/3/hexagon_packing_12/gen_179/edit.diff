+class AdaptiveGradientRefiner:
+    """Adaptive gradient-based refiner for local optimization"""
+    
+    @staticmethod
+    def adaptive_gradient_descent(config: np.ndarray, max_iter: int = 100, 
+                                initial_step_size: float = 0.1, tolerance: float = 1e-6) -> np.ndarray:
+        """Apply adaptive gradient descent with curvature-aware steps"""
+        best_config = config.copy()
+        best_score = SpatialHexagonEvaluator.evaluate_configuration(best_config)
+        
+        step_size = initial_step_size
+        prev_grad = None
+        
+        for iteration in range(max_iter):
+            # Calculate gradients for each position
+            gradients = np.zeros_like(config[:, :2])
+            
+            # Compute finite differences for gradient estimation
+            eps = 1e-4
+            for i in range(len(config)):
+                pos = config[i, :2].copy()
+                
+                # Estimate partial derivatives
+                grad_x = 0
+                grad_y = 0
+                
+                # Perturb x coordinate
+                pos_x_plus = pos.copy()
+                pos_x_plus[0] += eps
+                config_plus_x = config.copy()
+                config_plus_x[i, :2] = pos_x_plus
+                score_plus_x = SpatialHexagonEvaluator.evaluate_configuration(config_plus_x)
+                
+                pos_x_minus = pos.copy()
+                pos_x_minus[0] -= eps
+                config_minus_x = config.copy()
+                config_minus_x[i, :2] = pos_x_minus
+                score_minus_x = SpatialHexagonEvaluator.evaluate_configuration(config_minus_x)
+                
+                grad_x = (score_plus_x - score_minus_x) / (2 * eps)
+                
+                # Perturb y coordinate
+                pos_y_plus = pos.copy()
+                pos_y_plus[1] += eps
+                config_plus_y = config.copy()
+                config_plus_y[i, :2] = pos_y_plus
+                score_plus_y = SpatialHexagonEvaluator.evaluate_configuration(config_plus_y)
+                
+                pos_y_minus = pos.copy()
+                pos_y_minus[1] -= eps
+                config_minus_y = config.copy()
+                config_minus_y[i, :2] = pos_y_minus
+                score_minus_y = SpatialHexagonEvaluator.evaluate_configuration(config_minus_y)
+                
+                grad_y = (score_plus_y - score_minus_y) / (2 * eps)
+                
+                gradients[i] = [grad_x, grad_y]
+            
+            # Adaptive step sizing based on curvature (as estimated by gradient magnitude)
+            avg_grad_magnitude = np.mean(np.linalg.norm(gradients, axis=1))
+            if avg_grad_magnitude > 1e-8:
+                # Reduce step size if gradients are large (more curvature)
+                curvature_factor = 1.0 / (avg_grad_magnitude + 1e-8)
+                step_size = min(initial_step_size * curvature_factor, initial_step_size * 2.0)
+            else:
+                step_size = initial_step_size
+            
+            # Update positions
+            updated_positions = best_config[:, :2] - step_size * gradients
+            
+            # Check if update improves score
+            new_config = best_config.copy()
+            new_config[:, :2] = updated_positions
+            
+            new_score = SpatialHexagonEvaluator.evaluate_configuration(new_config)
+            
+            if new_score > best_score:
+                best_score = new_score
+                best_config = new_config.copy()
+            else:
+                # Reduce step size if no improvement
+                step_size *= 0.9
+                
+            if abs(new_score - best_score) < tolerance:
+                break
+                
+        return best_config
