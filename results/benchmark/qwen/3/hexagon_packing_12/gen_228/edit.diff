         self.best_score = 0
         self.iteration_count = 0
 
     def objective_function(self, params, hex_data, outer_radius):
         """Objective function for optimization - maximizes 1/outer_radius"""
         # Reconstruct configuration from flattened parameters
         config = hex_data.copy()
         param_idx = 0
 
         # Positions only (angles fixed at 0 for simplicity in this phase)
         for i in range(len(config)):
             config[i][0] = params[param_idx]
             config[i][1] = params[param_idx + 1]
             param_idx += 2
 
         # Evaluate configuration
         validity, inv_radius = self.evaluate_config(config, outer_radius)
 
         if not validity:
             # Large penalty for invalid configurations
             return 1e10
         return -inv_radius  # Negative because we want to maximize (minimize negative)
 
     def evaluate_config(self, hex_data, outer_radius):
         """Evaluate a single configuration"""
         # Check for overlaps
         for i in range(len(hex_data)):
             hex1_vertices = HexagonGeometry.hexagon_vertices(
                 hex_data[i][0], hex_data[i][1], 1, hex_data[i][2]
             )
