+    elif lattice_type == "kagome":
+        # Kagome lattice arrangement
+        # Central hexagon
+        config.extend([0.0, 0.0, 0.0])
+        
+        # Hexagonal ring
+        for i in range(6):
+            angle = i * np.pi/3
