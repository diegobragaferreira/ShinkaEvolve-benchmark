+def point_in_polygon_jit(px, py, polygon_points):
+    """Fast point-in-polygon test using ray casting algorithm"""
+    n = len(polygon_points)
+    inside = False
+    
+    p1x, p1y = polygon_points[0]
+    for i in range(1, n + 1):
+        p2x, p2y = polygon_points[i % n]
