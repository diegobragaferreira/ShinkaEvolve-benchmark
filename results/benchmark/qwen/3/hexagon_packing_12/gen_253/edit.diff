     def temperature_based_selection(self, population, fitness_scores, temperature):
         """Select individuals using temperature-controlled simulated annealing"""
         # Normalize fitness scores
         if len(fitness_scores) == 0:
             return population
 
         max_fitness = max(fitness_scores)
         if max_fitness == 0:
             # All fitness scores are zero, return population as-is
             return population
 
         # Avoid division by zero
         normalized_fitness = [(f / max_fitness) if max_fitness > 0 else 0 for f in fitness_scores]
 
         # Apply softmax with temperature
         exp_values = [math.exp(f / temperature) for f in normalized_fitness]
         total = sum(exp_values)
         if total == 0:
             # If all exponentials are zero, keep uniform distribution
             probabilities = [1.0 / len(exp_values)] * len(exp_values)
         else:
             probabilities = [exp / total for exp in exp_values]
 
         # Select indices based on probabilities
         selected_indices = np.random.choice(len(population), size=len(population), p=probabilities)
         return [population[i] for i in selected_indices]
 
