 class HexagonGeometry:
     """Handles all hexagon-related geometric computations with optimized performance."""
 
     def __init__(self):
         self.side_length = 1.0
         # Precompute vertex angles for efficiency
         self.vertex_angles = np.linspace(0, 2*np.pi, 7)
 
     def vertices(self, center_x: float, center_y: float, angle_deg: float = 0) -> np.ndarray:
         """Generate vertices of a regular hexagon given center and rotation."""
         angle_rad = np.deg2rad(angle_deg)
         angles = self.vertex_angles + angle_rad
         # Vectorized computation for better performance
         vertices = np.column_stack([
             center_x + self.side_length * np.cos(angles),
             center_y + self.side_length * np.sin(angles)
         ])
         return vertices
 
 class PackingValidator:
     """Validates packing configurations for constraints with numerical stability."""
 
     def __init__(self, hex_geometry: HexagonGeometry):
         self.hex_geom = hex_geometry
 
     def check_overlap(self, hex1_vertices: np.ndarray, hex2_vertices: np.ndarray) -> bool:
         """Check if two hexagons overlap using Shapely with buffer for numerical stability."""
         try:
             poly1 = Polygon(hex1_vertices)
             poly2 = Polygon(hex2_vertices)
             # Buffer helps with floating-point precision issues
             return poly1.buffer(1e-10).intersects(poly2.buffer(1e-10))
         except:
             # Fallback for edge cases - simple distance check
             centroid1 = np.mean(hex1_vertices, axis=0)
             centroid2 = np.mean(hex2_vertices, axis=0)
             distance = np.linalg.norm(centroid1 - centroid2)
             return distance < 2.0  # Overlapping if centroids are closer than 2 units
 
     def check_containment(self, hex_vertices: np.ndarray, outer_hex_side_length: float) -> bool:
         """Check if all hexagon vertices are contained within outer hexagon."""
         try:
             outer_vertices = self.hex_geom.vertices(0, 0, outer_hex_side_length)
             outer_polygon = Polygon(outer_vertices)
 
             for vertex in hex_vertices:
                 point = Point(vertex[0], vertex[1])
                 if not outer_polygon.contains(point):
                     return False
             return True
         except:
             # Fallback containment check using distance from center
             center = np.array([0.0, 0.0])
             for vertex in hex_vertices:
                 dist = np.linalg.norm(np.array(vertex) - center)
                 if dist > outer_hex_side_length:
                     return False
             return True
 
     def validate_packing(self, inner_hex_data: np.ndarray, outer_hex_side_length: float) -> Tuple[bool, float]:
         """Validate entire packing configuration with early termination."""
