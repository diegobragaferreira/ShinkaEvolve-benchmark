 import numpy as np
+from scipy.optimize import minimize
+from shapely.geometry import Polygon
+import time
 
+def hexagon_vertices(center_x, center_y, side_length=1, rotation=0):
+    """Generate vertices of a regular hexagon."""
+    angles = np.linspace(0, 2*np.pi, 7) + np.radians(rotation)
+    vertices = [(center_x + side_length * np.cos(a), center_y + side_length * np.sin(a)) for a in angles]
+    return vertices
+
+def check_containment(hexagon_poly, outer_hex_poly):
+    """Check if a hexagon is fully contained within the outer hexagon."""
+    return outer_hex_poly.contains(hexagon_poly)
+
+def check_overlap(hex1, hex2):
+    """Check if two hexagons overlap."""
+    return hex1.intersects(hex2)
+
+def compute_outer_hexagon_radius(inner_hex_data, outer_center=(0,0)):
+    """Compute the minimal radius needed for the outer hexagon to contain all inner hexagons."""
+    max_dist = 0
+    for i in range(len(inner_hex_data)):
+        x, y, angle = inner_hex_data[i]
+        vertices = hexagon_vertices(x, y, 1, angle)
+        for vx, vy in vertices:
+            dist = np.sqrt((vx - outer_center[0])**2 + (vy - outer_center[1])**2)
+            max_dist = max(max_dist, dist)
+    return max_dist
+
+def objective_function(params):
+    """Objective function to maximize 1/R (minimize R)."""
+    # Unpack parameters: 12 hexagons * 3 params each = 36 params
+    # We'll pack them as [x1,y1,a1,x2,y2,a2,...,x12,y12,a12] where a is in degrees
+    inner_hex_data = params.reshape(-1, 3)
+    
+    # Compute the outer hexagon size needed to contain all inner hexagons
+    outer_radius = compute_outer_hexagon_radius(inner_hex_data)
+    # Return negative because we want to maximize 1/R, so minimize -1/R = -1/outer_radius
+    return -1.0 / outer_radius
+
+def constraint_function(params):
+    """Constraint function to ensure no overlaps and containment."""
+    inner_hex_data = params.reshape(-1, 3)
+    
+    # Create shapely polygons for all hexagons
+    hexagons = []
+    for i in range(len(inner_hex_data)):
+        x, y, angle = inner_hex_data[i]
+        vertices = hexagon_vertices(x, y, 1, angle)
+        hexagons.append(Polygon(vertices))
+    
+    # Check containment (we assume outer hexagon is centered at origin with some radius)
+    # We use a large enough outer hexagon for now, but we'll optimize the radius
+    
+    # Check overlaps between all pairs
+    penalty = 0
+    for i in range(len(hexagons)):
+        for j in range(i+1, len(hexagons)):
+            if hexagons[i].intersects(hexagons[j]):
+                # Penalty for overlap - the more overlapping, the higher the penalty
+                try:
+                    intersection_area = hexagons[i].intersection(hexagons[j]).area
+                    penalty += intersection_area * 1000  # Large penalty multiplier
+                except:
+                    penalty += 1000  # Fallback penalty
+                    
+    return penalty
+
