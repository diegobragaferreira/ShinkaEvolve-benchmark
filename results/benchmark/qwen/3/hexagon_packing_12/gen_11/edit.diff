+def calculate_outer_hex_side_length(inner_hex_data, outer_hex_center=(0,0), outer_hex_rotation=0):
+    """Calculate minimum outer hexagon side length required to contain all inner hexagons."""
+    max_dist = 0
+
+    for i in range(len(inner_hex_data)):
+        center_x, center_y, angle = inner_hex_data[i]
+        hex_vertices = hexagon_vertices(center_x, center_y, 1, angle)
+
+        # Find maximum distance from center to any vertex
+        distances = np.sqrt((hex_vertices[:, 0] - center_x)**2 + (hex_vertices[:, 1] - center_y)**2)
+        max_vertex_distance = np.max(distances)
+
+        # Distance from outer center to this hexagon's center
+        center_distance = np.sqrt((center_x - outer_hex_center[0])**2 + (center_y - outer_hex_center[1])**2)
+
+        # Total required radius (outer boundary distance)
+        total_radius = center_distance + max_vertex_distance
+
+        # Convert to side length of hexagon (for regular hexagon: r = s * sqrt(3)/2)
+        side_length = (total_radius * 2) / np.sqrt(3)
+        max_dist = max(max_dist, side_length)
+
+    return max_dist
+
