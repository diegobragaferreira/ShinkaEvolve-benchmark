     def create_unit_hexagon(center: Tuple[float, float] = (0, 0), rotation: float = 0) -> Polygon:
         """Create a unit regular hexagon with given center and rotation"""
         angle_offset = math.radians(rotation)
         radius = 1
         vertices = []
