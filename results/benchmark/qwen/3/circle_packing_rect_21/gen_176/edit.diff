+def generate_voronoi_initialization(n: int, max_iterations: int = 100) -> np.ndarray:
+    """
+    Generate initial circle positions using Voronoi-based Lloyd's algorithm.
+    This creates well-distributed points that lead to better packing.
+    """
+    # Create initial random points
