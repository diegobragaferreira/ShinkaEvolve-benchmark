         """Apply random mutations to individual with adaptive magnitude"""
         mutated = individual.copy()
         for i in range(len(mutated)):
             if random.random() < mutation_rate:
                 # Adaptive mutation magnitude based on generation progress
                 mutation_magnitude = 0.03 + (0.07 * random.random())  # Range [0.03, 0.1]
