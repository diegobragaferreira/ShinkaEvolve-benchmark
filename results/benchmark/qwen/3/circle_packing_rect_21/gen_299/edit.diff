+def calculate_distribution_penalty(circles, index, x, y):
+    """Calculate penalty for poor spatial distribution."""
+    if len(circles) < 2:
+        return 0.0
+
+    # Calculate distances to all other circles
+    distances = []
+    for i, (cx, cy, _) in enumerate(circles):
+        if i != index:
+            dist = np.sqrt((x - cx)**2 + (y - cy)**2)
+            distances.append(dist)
+
+    if not distances:
+        return 0.0
+
+    # Penalize if average distance is too small (too clustered) or too large (too spread out)
+    avg_distance = np.mean(distances)
+
+    # Penalty based on deviation from optimal spacing
+    # We want to avoid both overcrowding and underpacking
+    ideal_spacing = np.mean([c[2] for c in circles if c[2] > 0.001]) * 2.0
+
+    # If average distance is too small or too large, apply penalty
