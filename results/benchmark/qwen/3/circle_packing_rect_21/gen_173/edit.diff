+                y = 0.1 + (j * 0.8 / (grid_size - 1)) if grid_size > 1 else 0.5
+                additional_points.append((x * rect_width, y * rect_height))
+        
+        # Combine and remove duplicates
+        all_points = seed_points + additional_points
