+    def generate_voronoi_seed_points(rect_width, rect_height, n_points):
+        """Generate seed points using Voronoi-based approach"""
+        # Start with strategic corner placements
+        seed_points = []
+        
+        # Add corners
+        seed_points.extend([
+            (0.1 * rect_width, 0.1 * rect_height),
