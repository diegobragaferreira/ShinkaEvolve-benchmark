+def compute_outer_hexagon_radius(inner_hex_data, outer_hex_center=(0,0), initial_guess=5):
+    """Compute minimum outer hexagon radius needed to contain all inner hexagons."""
+    min_radius = initial_guess
+
+    # For each inner hexagon, calculate its bounding circle radius
+    for i in range(len(inner_hex_data)):
+        center_x, center_y, angle = inner_hex_data[i]
+        # Each unit hexagon has circumradius = 1
+        hex_radius = 1
+
+        # Distance from outer center to hex center plus hex radius
+        dist_to_center = np.sqrt((center_x - outer_hex_center[0])**2 + (center_y - outer_hex_center[1])**2)
+        required_radius = dist_to_center + hex_radius
+
+        min_radius = max(min_radius, required_radius)
+
+    return min_radius
+
+
+def fitness_function(inner_hex_data, outer_hex_center=(0,0), outer_hex_angle=0):
+    """Calculate fitness based on how well the hexagons fit."""
+    # Calculate maximum outer hexagon radius required
+    outer_radius = compute_outer_hexagon_radius(inner_hex_data, outer_hex_center)
+
+    # Count overlapping pairs
+    overlap_count = 0
+    n = len(inner_hex_data)
+
+    # Check all pairs of hexagons for overlap
+    for i in range(n):
+        for j in range(i+1, n):
+            cx1, cy1, angle1 = inner_hex_data[i]
+            cx2, cy2, angle2 = inner_hex_data[j]
+
+            # Generate vertices for hexagons
+            hex1_vertices = generate_hexagon_vertices(cx1, cy1, angle1)
+            hex2_vertices = generate_hexagon_vertices(cx2, cy2, angle2)
+
+            # Check overlap
+            if check_overlap_hexagons(hex1_vertices, hex2_vertices):
+                overlap_count += 1
+
+    # Calculate total penalty
+    penalty = overlap_count * 1000  # Large penalty for overlaps
+
+    # Fitness is negative of outer radius plus penalties
+    return -outer_radius - penalty
+
