+def generate_hexagon_vertices(center_x, center_y, angle_degrees, side_length=1):
+    """Generate vertices of a regular hexagon given center, angle, and side length."""
+    angle_rad = np.radians(angle_degrees)
+    angles = np.linspace(0, 2*np.pi, 7)[:-1]  # 6 angles + close the loop
+    vertices = np.zeros((6, 2))
+    for i, angle in enumerate(angles):
+        vertices[i, 0] = center_x + side_length * np.cos(angle + angle_rad)
+        vertices[i, 1] = center_y + side_length * np.sin(angle + angle_rad)
+    return vertices
+
+
+def check_hexagon_containment(hex_vertices, outer_hex_center, outer_hex_angle, outer_hex_side_length):
+    """Check if a hexagon is fully contained within the outer hexagon."""
+    outer_vertices = generate_hexagon_vertices(outer_hex_center[0], outer_hex_center[1], outer_hex_angle, outer_hex_side_length)
+
+    # Check if all vertices of inner hexagon are within outer hexagon
+    for vertex in hex_vertices:
+        # Use point-in-polygon test
+        x, y = vertex
+        # For simplicity, just check distance from center
+        dx = x - outer_hex_center[0]
+        dy = y - outer_hex_center[1]
+        distance_from_center = np.sqrt(dx*dx + dy*dy)
+        # Maximum distance from center of inner hexagon to corner is sqrt(3)/2 * side_length = sqrt(3)/2
+        max_inner_distance = np.sqrt(3)/2
+        # Outer hexagon has radius = side_length * sqrt(3) = side_length * sqrt(3)
+        max_outer_distance = outer_hex_side_length * np.sqrt(3)
+
+        # Check if point is within outer hexagon bounds
+        if distance_from_center + max_inner_distance > max_outer_distance:
+            return False
+
+    return True
+
+
+def get_hexagon_radius(side_length):
+    """Get the circumradius of a regular hexagon"""
+    return side_length
+
+
+def check_overlap_hexagons(hex1_vertices, hex2_vertices):
+    """Check if two hexagons overlap using separating axis theorem."""
+    # Extract vertices
+    v1 = hex1_vertices
+    v2 = hex2_vertices
+
+    # Get all axes (normal vectors of edges)
+    axes = []
+
+    # For first hexagon
+    for i in range(len(v1)):
+        edge = v1[(i+1)%len(v1)] - v1[i]
+        normal = np.array([-edge[1], edge[0]])
+        # Normalize the normal vector
+        norm = np.linalg.norm(normal)
+        if norm > 1e-10:
+            normal /= norm
+            axes.append(normal)
+
+    # For second hexagon
+    for i in range(len(v2)):
+        edge = v2[(i+1)%len(v2)] - v2[i]
+        normal = np.array([-edge[1], edge[0]])
+        # Normalize the normal vector
+        norm = np.linalg.norm(normal)
+        if norm > 1e-10:
+            normal /= norm
+            axes.append(normal)
+
+    # Project both polygons onto each axis
+    for axis in axes:
+        # Project first polygon
+        proj1 = [np.dot(vertex, axis) for vertex in v1]
+        min1, max1 = min(proj1), max(proj1)
+
+        # Project second polygon
+        proj2 = [np.dot(vertex, axis) for vertex in v2]
+        min2, max2 = min(proj2), max(proj2)
+
+        # If projections don't overlap, polygons don't overlap
+        if max1 < min2 or max2 < min1:
+            return False
+
+    return True
+
