+def optimize_hexagon_positions(initial_config, max_iterations=1000, population_size=50):
+    """Evolutionary optimization of hexagon positions."""
+    # Create initial population
+    population = []
+
+    for _ in range(population_size):
+        # Add small random noise to initial configuration
+        mutated_config = initial_config + np.random.normal(0, 0.2, initial_config.shape)
+        population.append(mutated_config)
+
+    best_fitness = float('-inf')
+    best_individual = None
+
+    # Evolutionary loop
+    for iteration in range(max_iterations):
+        # Evaluate fitness for all individuals
+        fitness_scores = []
+        for individual in population:
+            # Ensure no overlaps in the current configuration
+            fitness = fitness_function(individual)
+            fitness_scores.append(fitness)
+
+        # Find best individual in current population
+        best_idx = np.argmax(fitness_scores)
+        if fitness_scores[best_idx] > best_fitness:
+            best_fitness = fitness_scores[best_idx]
+            best_individual = deepcopy(population[best_idx])
+
+        # Selection (tournament selection)
+        new_population = []
+        for _ in range(population_size):
+            # Tournament selection
+            tournament_size = 3
+            tournament_indices = random.sample(range(population_size), tournament_size)
+            tournament_fitness = [fitness_scores[i] for i in tournament_indices]
+            winner_idx = tournament_indices[np.argmax(tournament_fitness)]
+            new_population.append(deepcopy(population[winner_idx]))
+
+        # Crossover and mutation
+        for i in range(0, population_size, 2):
+            parent1 = new_population[i]
+            parent2 = new_population[(i+1) % population_size]
+
+            # Single-point crossover
+            crossover_point = random.randint(0, len(parent1))
+            child1 = deepcopy(parent1)
+            child2 = deepcopy(parent2)
+
+            child1[crossover_point:] = parent2[crossover_point:]
