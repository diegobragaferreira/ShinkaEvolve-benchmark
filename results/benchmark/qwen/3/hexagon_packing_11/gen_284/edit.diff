+            
+        # Resolve conflicts by moving hexagons apart
+        for i, j in overlapping_pairs:
+            # Get vectors between centers
+            dx = hex_data[j][0] - hex_data[i][0]
+            dy = hex_data[j][1] - hex_data[i][1]
+            
+            # Normalize
