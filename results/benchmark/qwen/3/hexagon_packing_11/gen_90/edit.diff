+def create_unit_hexagon(center=(0, 0), rotation=0):
+    """Create a unit regular hexagon centered at 'center' with given rotation."""
+    angle_rad = np.radians(rotation)
+    # Vertices of a unit hexagon centered at origin
+    hex_vertices = []
+    for i in range(6):
