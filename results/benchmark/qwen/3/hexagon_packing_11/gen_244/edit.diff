             if len(fitness_history) >= 10:
                 improvement = fitness_history[0] - fitness_history[-1]
                 if improvement < 0.1 and best_penalty < 100.0:
                     break
             
             # Select elite (top performers)
             elite = [ind for _, ind, valid in fitness_scores[:self.elite_size]]
             
             # Generate next generation
             new_population = elite.copy()
             
             while len(new_population) < self.pop_size:
                 # Adaptive tournament selection
                 parent1 = EvolutionaryOperators.tournament_selection(fitness_scores, generation, self.pop_size)
                 parent2 = EvolutionaryOperators.tournament_selection(fitness_scores, generation, self.pop_size)
                 
                 # Crossover with higher probability
                 child1, child2 = EvolutionaryOperators.crossover_parents(parent1, parent2, crossover_rate=0.9)
                 
                 # Mutate with adaptive parameters
                 child1 = EvolutionaryOperators.mutate_individual(child1, generation, self.pop_size, 
                                                                 mutation_rate=0.2, max_displacement=0.5, 
                                                                 max_rotation=30.0)
                 child2 = EvolutionaryOperators.mutate_individual(child2, generation, self.pop_size, 
                                                                 mutation_rate=0.2, max_displacement=0.5, 
                                                                 max_rotation=30.0)
                 
                 new_population.extend([child1, child2])
             
             # Trim to exact population size
             population = new_population[:self.pop_size]
         
         # Fine-tune using binary search for best solution
         if best_individual is not None:
             # Use binary search to find minimal outer radius for best solution
             estimated_min_radius = HexagonGeometry.compute_min_outer_radius(best_individual)
             min_test_radius = max(self.min_outer_radius, estimated_min_radius)
             
             # Binary search to find minimum valid radius
             final_radius = self.binary_search_outer_radius(best_individual, min_test_radius, self.max_outer_radius)
             
             # Verify final result
             final_penalty, final_valid, _ = self.evaluate_packing(best_individual, final_radius)
             if final_valid and final_penalty < best_penalty:
                 best_penalty = final_penalty
                 best_outer_radius = final_radius
         
         # Construct final return values
         inner_hex_data = best_individual if best_individual is not None else np.zeros((11, 3))
         outer_hex_data = np.array([0.0, 0.0, 0.0])  # Centered at origin
         
         return inner_hex_data, outer_hex_data, best_outer_radius
 
 def hexagon_packing_11():
