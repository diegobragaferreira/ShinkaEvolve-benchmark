+# Helper function to generate a regular hexagon vertex list
+def hexagon_vertices(center_x, center_y, angle_deg, side_length=1):
+    """Generate vertices of a regular hexagon"""
+    angle_rad = np.radians(angle_deg)
+    angles = np.linspace(0, 2*np.pi, 7) + angle_rad
+    x = center_x + side_length * np.cos(angles)
+    y = center_y + side_length * np.sin(angles)
+    return np.column_stack((x, y))
+
+
+# Check if two hexagons intersect
+def hexagons_intersect(hex1_vertices, hex2_vertices):
+    """Check if two hexagons intersect using separating axis theorem"""
+    # Get all edges of both hexagons
+    def get_edges(vertices):
+        edges = []
+        for i in range(len(vertices)):
+            edges.append(vertices[i] - vertices[(i+1) % len(vertices)])
+        return np.array(edges)
+
+    edges1 = get_edges(hex1_vertices)
+    edges2 = get_edges(hex2_vertices)
+
+    # Combine all axes (normal vectors to edges)
+    normals = np.vstack([edges1, edges2])
+    normals = normals[:, ::-1]  # Perpendicular vectors
+    normals[:, 0] *= -1
+
+    # Normalize
+    norms = np.linalg.norm(normals, axis=1)
+    normals = normals / norms.reshape(-1, 1)
+
+    # Project both polygons onto each axis
+    for normal in normals:
+        proj1 = np.dot(hex1_vertices, normal)
+        proj2 = np.dot(hex2_vertices, normal)
+
+        # Check for separation
+        if max(proj1) < min(proj2) or max(proj2) < min(proj1):
+            return False  # Separated on this axis
+
+    return True  # No separation found, they intersect
+
