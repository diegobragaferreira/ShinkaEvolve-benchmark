+# Check if a hexagon is contained within the outer hexagon
+def is_hexagon_contained(hex_vertices, outer_vertices):
+    """Check if all vertices of hex are within outer hexagon"""
+    from shapely.geometry import Polygon
+
+    outer_poly = Polygon(outer_vertices)
+    for vertex in hex_vertices:
+        point = Point(vertex[0], vertex[1])
+        if not outer_poly.contains(point):
+            return False
+    return True
+
+
+# Check if hexagons are disjoint
+def are_all_disjoint(inner_hexes, outer_radius):
+    """Check if all inner hexagons are disjoint and contained"""
+    # Create outer hexagon vertices
+    outer_vertices = hexagon_vertices(0, 0, 0, outer_radius)
+
+    n = len(inner_hexes)
+
+    # Check containment
+    for i in range(n):
+        center_x, center_y, angle_deg = inner_hexes[i]
+        hex_vertices = hexagon_vertices(center_x, center_y, angle_deg)
+        if not is_hexagon_contained(hex_vertices, outer_vertices):
+            return False
+
+    # Check intersections
+    for i in range(n):
+        for j in range(i+1, n):
+            hex1_vertices = hexagon_vertices(inner_hexes[i][0], inner_hexes[i][1], inner_hexes[i][2])
+            hex2_vertices = hexagon_vertices(inner_hexes[j][0], inner_hexes[j][1], inner_hexes[j][2])
+            if hexagons_intersect(hex1_vertices, hex2_vertices):
+                return False
+
+    return True
+
+
+def compute_outer_hexagon_radius(inner_hexes):
+    """Compute minimum outer hexagon radius that contains all inner hexagons"""
+    # Binary search parameters
+    min_radius = 0.0
+    max_radius = 20.0  # reasonable upper bound
+
+    # Check if even the largest possible radius works
+    if not are_all_disjoint(inner_hexes, max_radius):
+        return None
+
+    while max_radius - min_radius > 1e-6:
+        mid_radius = (min_radius + max_radius) / 2
+        if are_all_disjoint(inner_hexes, mid_radius):
+            max_radius = mid_radius
+        else:
+            min_radius = mid_radius
+
+    return max_radius
+
