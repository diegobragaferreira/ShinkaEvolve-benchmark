+# Create a random individual
+def create_random_individual():
+    """Create a random valid individual"""
+    # Initial random positions and orientations
+    individual = []
+
+    # Use a more structured initial placement
+    # Center hexagon
+    individual.append([0.0, 0.0, 0.0])
+
+    # Generate 10 random positions around the center
+    for _ in range(10):
+        r = np.random.uniform(0.5, 6.0)  # Distance from center
+        theta = np.random.uniform(0, 2*np.pi)
+        x = r * np.cos(theta)
+        y = r * np.sin(theta)
+        angle = np.random.uniform(0, 360)
+        individual.append([x, y, angle])
+
+    return np.array(individual)
+
+
+# Crossover operator
+def crossover(parent1, parent2):
+    """Single-point crossover for hexagon positions and orientations"""
+    n = len(parent1)
+    crossover_point = np.random.randint(1, n)  # Don't cross over the center
+
+    child1 = np.copy(parent1)
+    child2 = np.copy(parent2)
+
+    # Swap positions and orientations after crossover point
+    child1[crossover_point:] = parent2[crossover_point:]
+    child2[crossover_point:] = parent1[crossover_point:]
+
+    return child1, child2
+
+
+# Mutation operator
+def mutate(individual, mutation_rate=0.1, max_mutation=1.0):
+    """Mutate an individual with Gaussian noise"""
+    mutated = individual.copy()
+
+    # Only mutate positions and orientations, not the center
+    for i in range(1, len(mutated)):  # Start from index 1 to skip center hexagon
+        if np.random.rand() < mutation_rate:
+            # Mutate position and orientation
+            mutated[i][0] += np.random.normal(0, max_mutation * 0.5)
+            mutated[i][1] += np.random.normal(0, max_mutation * 0.5)
+            mutated[i][2] += np.random.normal(0, max_mutation * 10)
+
+            # Keep angle in [0, 360)
+            mutated[i][2] %= 360
+
+    return mutated
+
+
+# Tournament selection
+def tournament_selection(population, fitnesses, tournament_size=3):
+    """Select an individual using tournament selection"""
+    tournament_indices = np.random.choice(len(population), tournament_size)
+    tournament_fitnesses = [fitnesses[i] for i in tournament_indices]
+    winner_index = tournament_indices[np.argmax(tournament_fitnesses)]
+    return population[winner_index]
+
+
+def evaluate_fitness(individual):
+    """Evaluate the fitness of an individual (higher is better)"""
+    try:
+        outer_radius = compute_outer_hexagon_radius(individual)
+        if outer_radius is None:
+            # Invalid configuration, very low fitness
+            return -float('inf')
+        else:
+            # Higher is better: inverse of radius
+            return 1.0 / outer_radius
+    except Exception:
+        return -float('inf')
+
+
+def evolutionary_search():
+    """Run evolutionary search to optimize hexagon packing"""
+    # Parameters
+    pop_size = 50
+    num_generations = 100
+    mutation_rate = 0.2
+
+    # Initialize population
+    population = [create_random_individual() for _ in range(pop_size)]
+
+    best_fitness = -float('inf')
+    best_individual = None
+    best_radius = float('inf')
+
+    # Evaluate initial population
+    fitnesses = [evaluate_fitness(ind) for ind in population]
+
+    for gen in range(num_generations):
+        # Track best solution in this generation
+        current_best_idx = np.argmax(fitnesses)
+        current_best_fitness = fitnesses[current_best_idx]
+        current_best_individual = population[current_best_idx]
+
+        if current_best_fitness > best_fitness:
+            best_fitness = current_best_fitness
+            best_individual = current_best_individual
+            best_radius = 1.0 / best_fitness if best_fitness != -float('inf') else float('inf')
+
+        # Create new population
+        new_population = []
+
+        # Elitism: keep best individual
+        new_population.append(best_individual)
+
+        # Generate offspring
+        while len(new_population) < pop_size:
+            parent1 = tournament_selection(population, fitnesses)
+            parent2 = tournament_selection(population, fitnesses)
+            child1, child2 = crossover(parent1, parent2)
+            child1 = mutate(child1, mutation_rate)
+            child2 = mutate(child2, mutation_rate)
+
+            new_population.extend([child1, child2])
+
+        # Trim to exact population size
+        population = new_population[:pop_size]
+
+        # Re-evaluate fitnesses
+        fitnesses = [evaluate_fitness(ind) for ind in population]
+
+    # Final check for best solution
+    final_fitnesses = [evaluate_fitness(ind) for ind in population]
+    final_best_idx = np.argmax(final_fitnesses)
+    final_best_individual = population[final_best_idx]
+
+    # Get final radius
+    final_radius = compute_outer_hexagon_radius(final_best_individual)
+
+    return final_best_individual, final_radius
 
 
