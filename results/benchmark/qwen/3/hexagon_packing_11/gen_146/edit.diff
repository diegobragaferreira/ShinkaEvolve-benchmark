 def geometric_local_refinement(initial_config):
     """
     Specialized local refinement that works with geometric constraints
     and preserves the hexagonal structure while fine-tuning positions.
     """
     def objective_func(params):
         # Reshape parameters back into hexagon data
         hex_data = params.reshape(-1, 3)
         return evaluate_layout(hex_data)
 
     # Flatten current configuration for optimization
     flat_params = initial_config.flatten()
 
     # Use trust-constr method that handles constraints well for geometric problems
     try:
         result = minimize(objective_func, flat_params, method='trust-constr',
                          options={'maxiter': 100, 'verbose': 0})
 
         # Reshape back to 2D array
         refined_config = result.x.reshape(-1, 3)
         return refined_config
     except:
         # If local optimization fails, return original
         return initial_config
 
