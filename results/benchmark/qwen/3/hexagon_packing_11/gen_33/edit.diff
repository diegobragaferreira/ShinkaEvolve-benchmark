+def get_hexagon_vertices(center_x, center_y, rotation_deg, side_length=1):
+    """Get vertices of a regular hexagon with given center, rotation, and side length."""
+    angle_offset = np.radians(rotation_deg)
+    vertices = []
+    for i in range(6):
+        angle = angle_offset + i * np.pi / 3
+        x = center_x + side_length * np.cos(angle)
+        y = center_y + side_length * np.sin(angle)
+        vertices.append((x, y))
+    return np.array(vertices)
+
+
