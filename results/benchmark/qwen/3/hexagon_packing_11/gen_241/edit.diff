+class OptimizationPipeline:
+    """Manages the complete optimization pipeline."""
+    
+    def __init__(self, n_hexagons: int = 11):
+        self.n_hexagons = n_hexagons
+        self.validator = HexagonPackingValidator()
+        self.evaluator = HexagonPackingEvaluator()
+        
+    def create_initial_population(self, pop_size: int) -> List[np.ndarray]:
+        """Create an initial population of hexagon arrangements."""
+        population = []
+        
+        # Generate a structured initial arrangement  
+        base_arrangement = np.array([
+            [0, 0, 0],           # center
+            [-2.5, 0, 0],        # left
+            [2.5, 0, 0],         # right
+            [-1.25, 2.17, 0],    # top-left
+            [1.25, 2.17, 0],     # top-right
+            [-1.25, -2.17, 0],   # bottom-left
+            [1.25, -2.17, 0],    # bottom-right
+            [-3.75, 2.17, 0],    # far top-left
+            [3.75, 2.17, 0],     # far top-right
+            [-3.75, -2.17, 0],   # far bottom-left
+            [3.75, -2.17, 0],    # far bottom-right
+        ])
+        
+        for _ in range(pop_size):
+            # Add some noise to the base arrangement
+            individual = base_arrangement.copy().astype(float)
+            for i in range(len(individual)):
+                individual[i][0] += np.random.normal(0, 0.1)
+                individual[i][1] += np.random.normal(0, 0.1)
+                individual[i][2] += np.random.normal(0, 5)
+                individual[i][2] = individual[i][2] % 360
+                
+            population.append(individual)
+            
+        return population
+
+    def evaluate_population_parallel(self, population: List[np.ndarray]) -> List[float]:
+        """Evaluate population fitness in parallel."""
+        def evaluate_single_individual(individual: np.ndarray) -> float:
+            if not self.validator.validate_individual(individual):
+                return 0.0  # Invalid individuals get zero fitness
+            return self.evaluator.evaluate_fitness(individual)
+        
+        # Use joblib for parallel evaluation
+        results = Parallel(n_jobs=-1, verbose=0)(
+            delayed(evaluate_single_individual)(individual) for individual in population
+        )
+        return results
+
+    def optimize_stage_1(self, bounds: List[Tuple[float, float]]) -> Tuple[np.ndarray, float]:
+        """Stage 1: Coarse global optimization with differential evolution."""
+        def objective(params: np.ndarray) -> float:
+            # Reshape params back to hex_data format
+            hex_data = params.reshape(-1, 3)
+            if not self.validator.validate_individual(hex_data):
+                return 1e6  # Large penalty for invalid solutions
+            return -self.evaluator.evaluate_fitness(hex_data)  # Negative because we want to maximize
+        
+        try:
+            result = differential_evolution(
+                objective,
+                bounds,
+                seed=42,
+                maxiter=50,
+                popsize=15,
+                tol=1e-6,
+                mutation=(0.5, 1),
+                recombination=0.7,
+                disp=False
+            )
+            if result.success:
+                return result.x.reshape(-1, 3), result.fun
+        except Exception as e:
+            warnings.warn(f"Differential evolution stage 1 failed: {e}")
+            
+        # Fallback to initial solution
+        return None, float('inf')
+
+    def optimize_stage_2(self, initial_solution: np.ndarray, bounds: List[Tuple[float, float]]) -> np.ndarray:
+        """Stage 2: Fine-grained local optimization with L-BFGS-B."""
+        def refine_objective(params: np.ndarray) -> float:
+            hex_data = params.reshape(-1, 3)
+            if not self.validator.validate_individual(hex_data):
+                return 1e6
+            return -self.evaluator.evaluate_fitness(hex_data)
+        
+        try:
+            refined_result = minimize(
+                refine_objective,
+                initial_solution.flatten(),
+                method='L-BFGS-B',
+                bounds=bounds,
+                options={'maxiter': 50, 'ftol': 1e-8, 'gtol': 1e-8}
+            )
+            if refined_result.success:
