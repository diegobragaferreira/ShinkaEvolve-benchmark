+def compute_autoconvolution_norms(f_values: List[float]) -> Tuple[float, float, float]:
+    """
+    Compute the three norms needed for C2 calculation with proper numerical handling
+    Uses FFT-based convolution for efficiency and correct scaling
+    """
+    n = len(f_values)
+    if n == 0:
+        return 0.0, 0.0, 0.0
+    
+    # Ensure non-negative values and convert to numpy for efficiency
+    f_array = np.array(f_values)
+    f_array = np.maximum(f_array, 0.0)
+    
+    # Compute autoconvolution using FFT for efficiency
+    # Pad to power of 2 for efficient FFT
+    padded_n = 1
+    while padded_n < 2*n - 1:
+        padded_n <<= 1
+    
+    # Zero-padding
+    f_padded = np.zeros(padded_n)
+    f_padded[:n] = f_array
+    
+    # FFT-based convolution
+    f_fft = fftpack.fft(f_padded)
+    g_fft = f_fft * np.conj(f_fft)  # Element-wise multiplication
+    g_padded = fftpack.ifft(g_fft).real
+    
+    # Extract the valid convolution part
+    g = g_padded[n-1:n-1+(2*n-1)]
+    
+    # Apply proper scaling for step function integration
+    dx = 0.5 / n  # Width of each step on interval [-1/4, 1/4]
+    g = g * dx  # Scale by step width
+    
+    # Compute norms using the piecewise linear integration approach
+    g_abs = np.abs(g)
+    
+    # L2 norm squared using trapezoidal-like formula: (dx/3)(g₀² + g₀g₁ + g₁²)
+    g2_sq = 0.0
+    for i in range(len(g_abs)-1):
+        g2_sq += (dx/3) * (g_abs[i]**2 + g_abs[i]*g_abs[i+1] + g_abs[i+1]**2)
+    
+    # L1 norm (sum of absolute values times dx)
+    g1 = np.sum(g_abs) * dx
+    
+    # L-infinity norm
+    g_inf = np.max(g_abs)
+    
+    # Handle edge cases
+    if g1 <= 1e-15:
+        g1 = 1e-15
+    if g_inf <= 1e-15:
+        g_inf = 1e-15
+        
+    return g2_sq, g1, g_inf
+
+def calculate_c2(f_values: List[float]) -> float:
+    """
+    Calculate the C2 constant from the step function values.
+    """
+    try:
+        g_norm_2_sq, g_norm_1, g_norm_inf = compute_autoconvolution_norms(f_values)
+        c2 = g_norm_2_sq / (g_norm_1 * g_norm_inf)
+        return c2
+    except:
+        return 0.0
