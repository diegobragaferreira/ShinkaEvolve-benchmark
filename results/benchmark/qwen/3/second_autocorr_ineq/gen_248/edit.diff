+        peak_pos = random.randint(0, n-1)
+        combined[peak_pos] += random.uniform(0.3, 0.8)
+    
+    # Ensure non-negativity and reasonable scale
+    combined = np.maximum(combined, 0)
+    combined = combined / (np.max(combined) + 1e-10) * 2.0
