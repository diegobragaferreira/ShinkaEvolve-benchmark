+            
+            # Optimize with gradient method
+            c2_val, optimized = adaptive_gradient_optimization(perturbed, num_iterations//2)
+            
+            if c2_val > best_c2:
+                best_c2 = c2_val
+                best_solution = optimized.tolist()
+        except:
+            continue
+    
+    return best_solution
 
