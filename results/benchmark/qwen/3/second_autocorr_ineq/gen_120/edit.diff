+# Configuration object for evolutionary parameters
+EvolutionConfig = namedtuple('EvolutionConfig', [
+    'pop_size', 'max_generations', 'mutation_rate', 'crossover_rate',
+    'elitism_rate', 'selection_pressure', 'min_length', 'max_length'
