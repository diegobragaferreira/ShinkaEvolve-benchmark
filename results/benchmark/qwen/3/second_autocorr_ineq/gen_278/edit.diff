+class StepFunction:
+    """Represents a step function with optimized memory management and operations."""
+    
+    def __init__(self, heights: List[float], validate: bool = True):
+        self.heights = np.array(heights, dtype=np.float64)
+        self.length = len(heights)
+        if validate:
+            self._validate()
+    
+    def _validate(self):
+        """Validate that all heights are non-negative."""
+        if np.any(self.heights < 0):
+            raise ValueError("All step heights must be non-negative")
+    
+    def get_heights(self) -> np.ndarray:
+        return self.heights.copy()
+    
+    def get_length(self) -> int:
+        return self.length
+    
+    def clip_negative(self) -> 'StepFunction':
+        """Ensure all heights are non-negative."""
+        clipped_heights = np.maximum(self.heights, 0.0)
+        return StepFunction(clipped_heights.tolist(), validate=False)
+    
+    def normalize(self, scale_factor: float = 100.0) -> 'StepFunction':
+        """Normalize the step function heights."""
+        if np.sum(self.heights) > 0:
+            normalized = self.heights / np.sum(self.heights) * scale_factor
+        else:
+            normalized = self.heights.copy()
+        return StepFunction(normalized.tolist(), validate=False)
