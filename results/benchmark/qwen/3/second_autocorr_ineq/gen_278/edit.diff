+class EvolutionaryOptimizer:
+    """Main evolutionary algorithm class with enhanced optimization pipeline."""
+    
+    def __init__(self, 
+                 population_size: int = 20,
+                 generations: int = 50,
+                 initial_individual_length: int = 100,
+                 mutation_rate: float = 0.1,
+                 elite_size: int = 1,
+                 tournament_size: int = 3):
+        self.population_size = population_size
+        self.generations = generations
+        self.initial_individual_length = initial_individual_length
+        self.mutation_rate = mutation_rate
+        self.elite_size = elite_size
+        self.tournament_size = tournament_size
+        self.best_fitness = -float('inf')
+        self.best_individual = None
+        self.fitness_history = []
+        self.start_time = None
+        self.time_limit = 90.0  # 90 seconds maximum execution time
+    
+    def _check_time_limit(self) -> bool:
+        """Check if time limit has been exceeded."""
+        if self.start_time is None:
+            self.start_time = time.time()
+        return (time.time() - self.start_time) > self.time_limit
+    
+    def generate_individual(self) -> StepFunction:
+        """Generate a random individual (step function heights)."""
+        # Use multi-scale Gaussian pattern for better initialization
+        heights = MultiScaleGaussianPatternGenerator.generate(self.initial_individual_length)
+        return StepFunction(heights.tolist(), validate=False)
+    
+    def mutate_individual(self, individual: StepFunction, generation: int) -> StepFunction:
+        """Mutate an individual by perturbing some elements with adaptive rate."""
+        mutated_heights = individual.get_heights().copy()
+        mutation_strength = 0.1 * (1.0 - generation / self.generations) + 0.01
+        
+        # Apply mutations to random positions
+        mutation_mask = np.random.random(len(mutated_heights)) < self.mutation_rate
+        if np.any(mutation_mask):
+            noise = np.random.normal(0, mutation_strength, len(mutated_heights))
+            mutated_heights[mutation_mask] += noise[mutation_mask]
+            mutated_heights = np.maximum(mutated_heights, 0.0)  # Ensure non-negativity
+        
+        return StepFunction(mutated_heights.tolist(), validate=False)
+    
+    def crossover(self, parent1: StepFunction, parent2: StepFunction) -> Tuple[StepFunction, StepFunction]:
+        """Perform crossover between two parents."""
+        h1 = parent1.get_heights()
+        h2 = parent2.get_heights()
+        
+        if len(h1) == 0 or len(h2) == 0:
+            return parent1, parent2
+        
+        # Uniform crossover
+        child1_heights, child2_heights = [], []
+        max_len = max(len(h1), len(h2))
+        min_len = min(len(h1), len(h2))
+        
+        for i in range(max_len):
+            if i < min_len and np.random.random() < 0.5:
+                child1_heights.append(h1[i])
+                child2_heights.append(h2[i])
+            elif i < len(h1):
+                child1_heights.append(h1[i])
+                child2_heights.append(h2[i] if i < len(h2) else h1[i])
+            else:
+                child1_heights.append(h2[i])
+                child2_heights.append(h1[i] if i < len(h1) else h2[i])
+                
+        return StepFunction(child1_heights, validate=False), StepFunction(child2_heights, validate=False)
+    
+    def tournament_selection(self, population: List[StepFunction], 
+                           fitness_scores: List[float]) -> StepFunction:
+        """Select an individual using tournament selection."""
+        tournament_indices = np.random.choice(len(population), 
+                                             size=self.tournament_size, 
+                                             replace=False)
+        best_idx = tournament_indices[np.argmax([fitness_scores[i] for i in tournament_indices])]
+        return population[best_idx]
+    
+    def evolve_generation(self, population: List[StepFunction], 
+                         fitness_scores: List[float], 
+                         generation: int) -> List[StepFunction]:
+        """Evolve one generation of the population."""
+        new_population = []
+        pop_size = len(population)
+        
+        # Elitism: keep best individuals
+        sorted_indices = np.argsort(fitness_scores)[::-1][:self.elite_size]
+        for idx in sorted_indices:
+            new_population.append(population[idx])
+        
+        # Generate rest through selection, crossover, and mutation
+        for _ in range(pop_size - self.elite_size):
+            # Check time limit before each operation
+            if self._check_time_limit():
+                break
+                
+            # Selection
+            parent1 = self.tournament_selection(population, fitness_scores)
+            parent2 = self.tournament_selection(population, fitness_scores)
+            
+            # Crossover
+            child1, child2 = self.crossover(parent1, parent2)
+            
+            # Mutation
+            child1 = self.mutate_individual(child1, generation)
+            child2 = self.mutate_individual(child2, generation)
+            
+            new_population.extend([child1, child2])
+        
+        # Trim to exact population size
+        return new_population[:pop_size]
+    
+    def evaluate_population(self, population: List[StepFunction]) -> List[float]:
+        """Evaluate fitness for entire population."""
+        fitness_scores = []
+        for individual in population:
+            # Check time limit during evaluation
+            if self._check_time_limit():
+                break
+            fitness = FitnessCalculator.calculate_c2(individual)
+            fitness_scores.append(fitness)
+        return fitness_scores
+    
+    def evolve(self) -> StepFunction:
+        """Run the evolutionary process."""
+        # Initialize population
+        population = [self.generate_individual() for _ in range(self.population_size)]
+        
+        # Evolve
+        for gen in range(self.generations):
+            # Check time limit before each generation
+            if self._check_time_limit():
+                print(f"Time limit reached at generation {gen}")
+                break
+            
+            # Evaluate fitness
+            fitness_scores = self.evaluate_population(population)
+            
+            # Track best
+            max_fitness = max(fitness_scores)
+            if max_fitness > self.best_fitness:
+                self.best_fitness = max_fitness
+                best_individual_idx = fitness_scores.index(max_fitness)
+                self.best_individual = population[best_individual_idx]
+            
+            # Print progress every 10 generations
+            if gen % 10 == 0:
+                print(f"Generation {gen}: Best C2 = {self.best_fitness:.6f}")
+            
+            # Evolve
+            population = self.evolve_generation(population, fitness_scores, gen)
+            
+            # Store fitness history
+            self.fitness_history.append(max_fitness)
+        
+        # Return best individual found
+        return self.best_individual if self.best_individual is not None else self.generate_individual()
+    
+    def get_statistics(self) -> dict:
+        """Get optimization statistics."""
+        return {
+            'best_fitness': self.best_fitness,
+            'generations_run': len(self.fitness_history),
+            'final_fitness_history': self.fitness_history[-10:] if len(self.fitness_history) > 10 else self.fitness_history
+        }
