+class FitnessCalculator:
+    """Computes fitness (C2 values) with proper error handling."""
+    
+    @staticmethod
+    def calculate_c2(step_func: StepFunction) -> float:
+        """
+        Calculate C₂ = ||g||₂² / (||g||₁ · ||g||∞) where g = f * f.
+        
+        Args:
+            step_func: StepFunction object
+            
+        Returns:
+            C₂ value
+        """
+        try:
+            result = AutoconvolutionEvaluator.compute_autoconvolution_norms(step_func)
+            
+            # Avoid division by zero
+            if result.norm1 <= 1e-12 or result.norm_inf <= 1e-12:
+                return 0.0
+                
+            return result.norm2_sq / (result.norm1 * result.norm_inf)
+        except Exception as e:
+            return 0.0
