+def compute_convolution_norms(f_values, domain_length=0.5):
+    """
+    Compute the three norms needed for C2 calculation using the provided step function.
+    Uses efficient convolution via FFT for better performance.
+    """
+    n_steps = len(f_values)
+    if n_steps == 0:
+        return 0.0, 0.0, 0.0
+
+    # Step size
+    dx = domain_length / n_steps
+
+    # Use FFT for fast convolution
+    # Pad to ensure proper convolution
+    padded_length = 2 * n_steps - 1
+    f_padded = np.pad(f_values, (0, padded_length - n_steps), mode='constant')
+    
+    # Convolution via FFT
+    f_fft = fftpack.fft(f_padded)
+    g_fft = f_fft * np.conj(f_fft)  # Autoconvolution in frequency domain
+    g = np.real(fftpack.ifft(g_fft))[:padded_length]
+    
+    # Compute norms using trapezoidal integration
+    # ||g||₂² = sum(g_i² * dx) - trapezoidal rule equivalent for piecewise linear
+    g2_sq = 0.0
+    for i in range(len(g)-1):
+        g2_sq += (dx/3) * (g[i]**2 + g[i]*g[i+1] + g[i+1]**2)
+
+    # ||g||₁ = sum(|g_i| * dx)
+    g1 = np.sum(np.abs(g)) * dx
+
+    # ||g||∞ = max(|g_i|)
+    ginf = np.max(np.abs(g))
+
+    return g2_sq, g1, ginf
+
+def compute_c2(f_values):
+    """Compute C₂ = ||g||₂² / (||g||₁ · ||g||∞)"""
+    g2_sq, g1, ginf = compute_convolution_norms(f_values)
+
+    if g1 == 0 or ginf == 0:
+        return 0.0
+
+    return g2_sq / (g1 * ginf)
 
