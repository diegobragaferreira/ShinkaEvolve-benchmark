 def compute_convolution_norms(f_values, domain_length=0.5):
     """Wrapper function for norm computation"""
     return compute_convolution_norms_numba(f_values, domain_length)
 
 def compute_c2(f_values):
     """Compute C₂ = ||g||₂² / (||g||₁ · ||g||∞)"""
     return compute_c2_numba(f_values)
 
 def adaptive_local_search(initial_f, max_iterations=100):
     """Perform adaptive local search to improve the solution"""
     best_f = initial_f.copy()
     best_c2 = compute_c2(best_f)
 
     # Track recent improvements
     recent_improvements = []
     patience = 0
     max_patience = 20
 
     # Adaptive parameters
     base_mutation_rate = 0.2
     min_mutation_rate = 0.05
     max_mutation_rate = 0.5
 
     for iteration in range(max_iterations):
         test_f = best_f.copy()
 
         # Dynamic mutation rate adjustment
         current_mutation_rate = base_mutation_rate
         if len(recent_improvements) >= 10:
             recent_avg = np.mean(recent_improvements[-10:])
             if recent_avg < 1e-6:
                 # Slow progress, increase mutation rate
                 current_mutation_rate = min(max_mutation_rate, current_mutation_rate * 1.5)
             elif recent_avg > 1e-4:
                 # Fast progress, decrease mutation rate for fine tuning
                 current_mutation_rate = max(min_mutation_rate, current_mutation_rate * 0.8)
 
         # Determine number of modifications based on progress
         if len(recent_improvements) < 5:
             num_modifications = max(1, len(test_f) // 15)
         else:
             avg_improvement = np.mean(recent_improvements[-5:])
             if avg_improvement < 1e-6:
                 num_modifications = max(1, len(test_f) // 30)
             else:
                 num_modifications = max(1, len(test_f) // 10)
 
         # Apply random modifications with adaptive strategy
         mod_indices = np.random.choice(len(test_f), num_modifications, replace=False)
         for idx in mod_indices:
             # Adaptive change magnitude based on current value
             change_magnitude = current_mutation_rate * test_f[idx] if test_f[idx] > 0 else current_mutation_rate
             change_factor = np.random.normal(0, change_magnitude)
             new_value = test_f[idx] * (1 + change_factor)
             test_f[idx] = max(0, new_value)  # Ensure non-negativity
 
         # Evaluate and accept improvement
         test_c2 = compute_c2(test_f)
         improvement = test_c2 - best_c2
 
         if test_c2 > best_c2:
             best_c2 = test_c2
             best_f = test_f
             recent_improvements.append(improvement)
             patience = 0
         else:
             recent_improvements.append(improvement)
             patience += 1
 
         # Early stopping if no improvement for too long
         if patience >= max_patience:
             break
 
     return best_f, best_c2
 
 def evolutionary_optimization(initial_f, n_steps, max_generations=20):
     """Perform evolutionary optimization with adaptive parameters"""
     # Adaptive population size
     pop_size = max(20, min(100, n_steps // 10))
 
     # Generate initial population
     population = []
     for i in range(pop_size):
         if i == 0:
             individual = initial_f.copy()
         else:
             # Create variations of the initial solution
             individual = initial_f.copy()
             # Add small random noise
             for j in range(len(individual)):
                 if np.random.random() < 0.1:
                     individual[j] *= np.random.normal(1, 0.1)
             individual = np.maximum(individual, 0)
         population.append(individual)
 
     best_individual = None
     best_c2 = -float('inf')
 
     for generation in range(max_generations):
         # Evaluate population
         fitness_scores = []
         for individual in population:
             c2 = compute_c2(individual)
             fitness_scores.append(c2)
             if c2 > best_c2:
                 best_c2 = c2
                 best_individual = individual.copy()
 
         # Sort population
         sorted_indices = np.argsort(fitness_scores)[::-1]
         sorted_population = [population[i] for i in sorted_indices]
 
         # Create new population
         new_population = [sorted_population[0].copy()]  # Elitism
 
         # Generate offspring
         while len(new_population) < pop_size:
             # Tournament selection
             parent1_idx = np.random.choice(len(sorted_population), 3, replace=False)
             parent1_idx = parent1_idx[np.argmax([fitness_scores[i] for i in parent1_idx])]
 
             parent2_idx = np.random.choice(len(sorted_population), 3, replace=False)
             parent2_idx = parent2_idx[np.argmax([fitness_scores[i] for i in parent2_idx])]
 
             parent1 = sorted_population[parent1_idx]
             parent2 = sorted_population[parent2_idx]
 
             # Uniform crossover
             child = []
             for i in range(len(parent1)):
                 if np.random.random() < 0.5:
                     child.append(parent1[i])
                 else:
                     child.append(parent2[i])
 
             # Mutation
             for i in range(len(child)):
                 if np.random.random() < 0.1:
                     if child[i] > 0:
                         child[i] *= np.random.normal(1, 0.1)
                     else:
                         child[i] = np.random.exponential(0.1)
             child = np.maximum(child, 0)
 
             new_population.append(child)
 
         population = new_population[:pop_size]
 
         # Diversity maintenance - periodically reinitialize some individuals
         if generation % 5 == 0 and generation > 0:
             for i in range(0, len(population), 4):
                 if i < len(population):
                     population[i] = construct_initial_pattern(n_steps).tolist()
 
     return best_individual, best_c2
 
 def construct_function() -> list[float]:
     """Function to construct step-function with high C2 value using evolutionary approach."""
     # Set seed for reproducibility
     np.random.seed(42)
 
     # Use a moderate number of steps for balance between resolution and speed
     n_steps = 3000  # Increased from 2000 for better resolution
 
     # Construct initial pattern
     f_values = construct_initial_pattern(n_steps).tolist()
 
     # Stage 1: Differential Evolution
     try:
         # Define bounds for each variable
         bounds = [(0, 100) for _ in range(n_steps)]
 
         # Run differential evolution with more iterations now that we have more time
         result = differential_evolution(
             lambda x: -compute_c2(x),  # Minimize negative C2
             bounds,
             maxiter=30,  # More iterations
             popsize=15,  # Larger population
             seed=42,
             disp=False
         )
 
         # Use the result if it improved upon our initial function
         if result.success and -result.fun > compute_c2(f_values):
             f_values = result.x.tolist()
 
     except Exception:
         # If differential evolution fails, proceed with other approaches
         pass
 
     # Stage 2: Evolutionary Optimization
     try:
         evol_individual, evol_c2 = evolutionary_optimization(f_values, n_steps, max_generations=25)
         if evol_c2 > compute_c2(f_values):
             f_values = evol_individual
     except Exception:
         pass
 
     # Stage 3: Adaptive Local Search
     refined_f, final_c2 = adaptive_local_search(f_values, max_iterations=150)
 
     return refined_f
 
