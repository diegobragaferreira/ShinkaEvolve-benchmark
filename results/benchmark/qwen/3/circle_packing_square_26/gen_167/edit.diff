+            x2, y2, r2 = circles[j]
+            distance = math.sqrt((x1 - x2)**2 + (y1 - y2)**2)
+            if distance < r1 + r2:
+                overlap = (r1 + r2 - distance)
+                penalty += overlap**2
+                
+    return penalty
 
