     def is_valid(circles: np.ndarray) -> bool:
         """Check if circles are within bounds and non-overlapping"""
         # Check containment
         for i in range(len(circles)):
             x, y, r = circles[i]
             if x - r < 0 or x + r > 1 or y - r < 0 or y + r > 1:
                 return False
 
         # Check overlaps using KDTree for efficiency
         positions = circles[:, :2]
         radii = circles[:, 2]
 
         try:
             tree = cKDTree(positions)
             # Find neighbors within distance of (r1 + r2)
             pairs = tree.query_pairs(r=2.0, output_type='ndarray')
 
             for i, j in pairs:
                 dist = np.linalg.norm(positions[i] - positions[j])
                 if dist < radii[i] + radii[j]:
                     return False
 
         except Exception:
             # Fallback to slower pairwise check if needed
             for i in range(len(circles)):
                 for j in range(i+1, len(circles)):
                     x1, y1, r1 = circles[i]
                     x2, y2, r2 = circles[j]
                     dist = np.sqrt((x1-x2)**2 + (y1-y2)**2)
                     if dist < r1 + r2:
                         return False
 
         return True
 
     def evaluate_fitness(circles: np.ndarray) -> float:
         """Evaluate fitness of a solution"""
         if not is_valid(circles):
             # Calculate penalty based on severity of violation
             penalty = 0.0
 
             # Check containment violations
             for i in range(len(circles)):
                 x, y, r = circles[i]
                 containment_penalty = 0
 
                 # Penalty for being outside bounds
                 if x - r < 0:
                     containment_penalty += abs(x - r)
                 if x + r > 1:
                     containment_penalty += abs(x + r - 1)
                 if y - r < 0:
                     containment_penalty += abs(y - r)
                 if y + r > 1:
                     containment_penalty += abs(y + r - 1)
 
                 penalty += containment_penalty * 1000
 
                 # If circle is completely out of bounds, massive penalty
                 if (x - r < 0 or x + r > 1 or y - r < 0 or y + r > 1):
                     penalty += 100000
 
             # Check overlap violations
             positions = circles[:, :2]
             radii = circles[:, 2]
 
             try:
                 tree = cKDTree(positions)
                 pairs = tree.query_pairs(r=2.0, output_type='ndarray')
 
                 for i, j in pairs:
                     if i < j:  # Only count each pair once
                         dist = np.linalg.norm(positions[i] - positions[j])
                         overlap = (radii[i] + radii[j]) - dist
                         if overlap > 0:
                             penalty += overlap * 100000
             except Exception:
                 # Fallback pairwise check
                 for i in range(len(circles)):
