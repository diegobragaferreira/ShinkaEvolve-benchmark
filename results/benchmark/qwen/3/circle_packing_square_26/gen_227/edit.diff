+            return True
+
+        # Use spatial indexing for efficiency
+        if spatial_indexer is not None and n > SPATIAL_INDEXING_THRESHOLD:
+            # Multi-scale approach: use KDTree for large populations with adaptive search radii
+            positions = [(c.x, c.y) for c in circles]
+            tree = cKDTree(positions)
+
+            # For very large populations, use a different strategy
+            if n > SPATIAL_INDEXING_THRESHOLD * 2:
+                # Use a hybrid approach: first check direct neighbors via spatial grid,
+                # then verify with KDTree for any remaining potential overlaps
+                for i, circle in enumerate(circles):
+                    # Get neighbors from spatial index
+                    neighbor_indices = spatial_indexer.get_neighbors_advanced(circle)
+                    # Check against actual neighbors in tree with small search radius
+                    indices = tree.query_ball_point([circle.x, circle.y], circle.r * 2.5)
+                    # Combine and deduplicate
+                    combined_indices = list(set(neighbor_indices + indices))
+
+                    for j in combined_indices:
+                        if i != j:
