+class QuadTree:
+    """Quadtree implementation for efficient spatial queries"""
+    
+    def __init__(self, boundary, capacity=4):
+        self.boundary = boundary  # [x_min, y_min, x_max, y_max]
+        self.capacity = capacity
+        self.points = []
+        self.divided = False
+        self.nw = None
+        self.ne = None
+        self.sw = None
+        self.se = None
+    
+    def subdivide(self):
+        x_min, y_min, x_max, y_max = self.boundary
+        mid_x = (x_min + x_max) / 2
+        mid_y = (y_min + y_max) / 2
+        
+        # Create four quadrants
+        self.nw = QuadTree([x_min, y_min, mid_x, mid_y], self.capacity)
+        self.ne = QuadTree([mid_x, y_min, x_max, mid_y], self.capacity)
+        self.sw = QuadTree([x_min, mid_y, mid_x, y_max], self.capacity)
+        self.se = QuadTree([mid_x, mid_y, x_max, y_max], self.capacity)
+        
+        self.divided = True
+    
+    def insert(self, point, radius):
+        x, y = point
+        
+        # Check if point is within boundary
+        if not self.in_boundary(x, y):
+            return False
+            
+        if len(self.points) < self.capacity and not self.divided:
+            self.points.append((x, y, radius))
+            return True
+        
+        if not self.divided:
+            self.subdivide()
+            
+        # Try inserting into children
+        if self.nw.insert(point, radius):
+            return True
+        if self.ne.insert(point, radius):
+            return True
+        if self.sw.insert(point, radius):
+            return True
+        if self.se.insert(point, radius):
+            return True
+            
+        return False
+    
+    def in_boundary(self, x, y):
+        x_min, y_min, x_max, y_max = self.boundary
+        return x_min <= x <= x_max and y_min <= y <= y_max
+    
+    def query_range(self, x, y, radius):
+        """Find all points within a circular range"""
+        found = []
+        
+        # Check if this node's boundary intersects with the query circle
+        x_min, y_min, x_max, y_max = self.boundary
+        center_dist_x = abs(x - (x_min + x_max) / 2)
+        center_dist_y = abs(y - (y_min + y_max) / 2)
+        boundary_dist_x = (x_max - x_min) / 2
+        boundary_dist_y = (y_max - y_min) / 2
+        
+        if center_dist_x > radius + boundary_dist_x or center_dist_y > radius + boundary_dist_y:
+            return found
+            
+        # Check points in this node
+        for px, py, pr in self.points:
+            dist_sq = (px - x)**2 + (py - y)**2
+            if dist_sq <= (radius + pr)**2:
+                found.append((px, py, pr))
+        
+        # Recursively check children
+        if self.divided:
+            found.extend(self.nw.query_range(x, y, radius))
+            found.extend(self.ne.query_range(x, y, radius))
+            found.extend(self.sw.query_range(x, y, radius))
+            found.extend(self.se.query_range(x, y, radius))
+            
+        return found
 
 class OptimizerComponents:
     """Container for all optimization components"""
     
     @staticmethod
     def generate_voronoi_seeds(n_points: int, boundary_margin: float = 0.1) -> np.ndarray:
         """Generate well-distributed seed points using Voronoi diagram."""
         points = np.random.rand(n_points, 2) * (1 - 2*boundary_margin) + boundary_margin
         return points
 
     @staticmethod
     def compute_voronoi_radii(points: np.ndarray, boundary_margin: float = 0.1) -> np.ndarray:
         """Compute radii based on Voronoi cell areas."""
         vor = Voronoi(points)
         radii = []
         for i, point in enumerate(points):
             distances = cdist([point], np.delete(points, i, axis=0))[0]
             min_distance = np.min(distances)
             max_radius = min(point[0], 1-point[0], point[1], 1-point[1])
             estimated_radius = min(min_distance/2.0, max_radius)
             radii.append(max(estimated_radius, 0.001))
         return np.array(radii)
 
     @staticmethod
     def initialize_structured_placement(n_circles: int) -> np.ndarray:
         """Initialize circles with structured grid placement."""
         individual = np.zeros((n_circles, 3))
         rows = int(np.ceil(np.sqrt(n_circles)))
         cols = int(np.ceil(n_circles / rows))
         
         spacing_x = 1.0 / (cols + 1)
         spacing_y = 1.0 / (rows + 1)
         
         for i in range(n_circles):
             row = i // cols
             col = i % cols
             
             base_x = (col + 1) * spacing_x
             base_y = (row + 1) * spacing_y
             
             individual[i, 0] = np.clip(base_x + np.random.uniform(-spacing_x/4, spacing_x/4), 0.01, 0.99)
             individual[i, 1] = np.clip(base_y + np.random.uniform(-spacing_y/4, spacing_y/4), 0.01, 0.99)
             
             max_radius = min(0.5 - individual[i, 0], 0.5 - individual[i, 1],
                            individual[i, 0], individual[i, 1])
             individual[i, 2] = np.random.uniform(0.001, max_radius * 0.8)
         
         return individual
 
