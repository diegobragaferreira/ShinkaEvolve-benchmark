                                    optimized[i, 2] + 0.001, 1 - optimized[i, 2] - 0.001)
             optimized[i, 1] = np.clip(optimized[i, 1] + np.random.normal(0, 0.005), 
                                    optimized[i, 2] + 0.001, 1 - optimized[i, 2] - 0.001)
