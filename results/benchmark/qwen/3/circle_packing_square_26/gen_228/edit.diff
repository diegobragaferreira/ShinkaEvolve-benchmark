+        """Check if circles at indices i and j overlap"""
+        x1, y1, r1 = circles[i]
+        x2, y2, r2 = circles[j]
+        distance = np.sqrt((x1 - x2)**2 + (y1 - y2)**2)
+        return distance < (r1 + r2 - 1e-8)
