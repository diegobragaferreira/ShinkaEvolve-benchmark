+class BoundaryValidator:
+    """Validates boundary constraints for circle positioning"""
+    
+    @staticmethod
+    def is_valid_position(x: float, y: float, r: float) -> bool:
+        """Check if a circle position is valid (within bounds)"""
+        return (r <= x <= 1 - r and r <= y <= 1 - r)
+    
+    @staticmethod
+    def enforce_bounds(circles: np.ndarray) -> np.ndarray:
+        """Enforce boundary constraints by adjusting positions and radii"""
+        result = circles.copy()
+        
+        for i in range(len(result)):
+            x, y, r = result[i]
+            
+            # Ensure circle fits in the unit square
+            max_radius = min(x, 1-x, y, 1-y)
+            r = min(r, max_radius)
+            r = max(0.001, min(0.49, r))
