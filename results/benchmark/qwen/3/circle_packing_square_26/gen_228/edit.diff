+class SpatialIndexManager:
+    """Efficient spatial indexing manager for circle collision detection"""
+    
+    def __init__(self, grid_resolution: int = 20):
+        self.grid_resolution = grid_resolution
+        self.grid_cells = {}
+        self.kdtree = None
+        self.positions_cache = None
+    
+    def build_index(self, circles: np.ndarray) -> None:
+        """Build spatial index for efficient neighbor queries"""
+        self.grid_cells.clear()
+        
+        # Build grid-based index
+        positions = [(x, y) for x, y, r in circles]
+        self.positions_cache = np.array(positions)
+        
+        for i, (x, y, r) in enumerate(circles):
+            grid_x = int(x * self.grid_resolution)
+            grid_y = int(y * self.grid_resolution)
+            cell_key = (grid_x, grid_y)
+            
+            if cell_key not in self.grid_cells:
+                self.grid_cells[cell_key] = []
+            self.grid_cells[cell_key].append(i)
+        
+        # Build KDTree for efficient nearest neighbor queries
+        if len(positions) > 0:
+            self.kdtree = cKDTree(self.positions_cache)
+    
+    def get_neighbors(self, x: float, y: float, radius: float) -> List[int]:
+        """Get candidate neighbors efficiently"""
+        neighbors = []
+        
+        # Grid-based approach
+        grid_x = int(x * self.grid_resolution)
+        grid_y = int(y * self.grid_resolution)
+        
+        # Check nearby cells
+        for dx in [-1, 0, 1]:
+            for dy in [-1, 0, 1]:
+                cell_key = (grid_x + dx, grid_y + dy)
+                if cell_key in self.grid_cells:
+                    neighbors.extend(self.grid_cells[cell_key])
+        
+        # KDTree approach for more precise results
+        if self.kdtree is not None:
+            query_radius = 2 * (radius + 0.01)
+            try:
+                kdtree_indices = self.kdtree.query_ball_point([x, y], query_radius)
+                neighbor_set = set(neighbors)
+                for idx in kdtree_indices:
+                    if idx not in neighbor_set:
+                        neighbors.append(idx)
+            except:
+                pass  # Fall back to grid-based if KDTree fails
+        
+        return neighbors
