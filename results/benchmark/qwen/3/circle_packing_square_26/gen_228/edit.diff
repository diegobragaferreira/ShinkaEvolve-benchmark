+class OverlapValidator:
+    """Validates overlap constraints between circles"""
+    
+    @staticmethod
+    def calculate_overlap_distance(pos1: Tuple[float, float], r1: float, 
+                                  pos2: Tuple[float, float], r2: float) -> float:
+        """Calculate actual overlap distance between two circles"""
+        x1, y1 = pos1
+        x2, y2 = pos2
+        distance = np.sqrt((x1 - x2)**2 + (y1 - y2)**2)
+        return max(0, (r1 + r2) - distance)
