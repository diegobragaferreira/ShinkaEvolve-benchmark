+                    distance = np.sqrt(distance_squared)
+                    if distance > 0:  # Avoid division by zero
+                        # Normalize direction vector
+                        dx /= distance
+                        dy /= distance
+
+                        # Calculate overlap amount
+                        overlap = (r1 + r2) - distance
+
+                        # Move circles apart with more aggressive force
+                        move_amount = overlap * 0.7  # Increased from 0.5
+
+                        # Apply movement inversely proportional to radii
+                        scale_factor = r1 / (r1 + r2 + 1e-8)
+                        optimized[i, 0] -= dx * move_amount * scale_factor * 0.6
+                        optimized[i, 1] -= dy * move_amount * scale_factor * 0.6
+                        optimized[j, 0] += dx * move_amount * (1 - scale_factor) * 0.6
+                        optimized[j, 1] += dy * move_amount * (1 - scale_factor) * 0.6
+
+                        resolved = True
+
+        # Enforce bounds and containment constraints
+        for i in range(len(optimized)):
+            x, y, r = optimized[i]
+            # Ensure circle stays within bounds
+            x = np.clip(x, r + 0.001, 1 - r - 0.001)
+            y = np.clip(y, r + 0.001, 1 - r - 0.001)
+            optimized[i] = [x, y, r]
+
+        # Early stopping if no overlaps were resolved
+        if not resolved:
