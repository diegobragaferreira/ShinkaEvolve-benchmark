     def _compute_boundary_penalty(self, circles: np.ndarray, weight: float) -> float:
         """Compute penalty based on boundary violations"""
         penalty = 0.0
 
         for x, y, r in circles:
             # Calculate boundary violations
             if x - r < 0:
                 penalty += abs(x - r) * weight
             elif x + r > 1:
                 penalty += abs(x + r - 1) * weight
             if y - r < 0:
                 penalty += abs(y - r) * weight
             elif y + r > 1:
                 penalty += abs(y + r - 1) * weight
 
         return penalty
 
     def _compute_overlap_penalty(self, circles: np.ndarray, weight: float) -> float:
         """Compute penalty based on overlap violations"""
         penalty = 0.0
 
         # Compute actual overlap amounts for more accurate penalty
         n = len(circles)
         for i in range(n):
             for j in range(i+1, n):
                 x1, y1, r1 = circles[i]
                 x2, y2, r2 = circles[j]
                 distance = math.sqrt((x1 - x2)**2 + (y1 - y2)**2)
 
                 if distance < (r1 + r2):
                     overlap = (r1 + r2 - distance)
                     penalty += overlap * weight
 
         return penalty
 
 class AdvancedVoronoiInitialization:
     """Implements advanced Voronoi-like initialization with adaptive spacing"""
 
     @staticmethod
     def generate_poisson_disk_distribution(n: int, radius_min: float = 0.05) -> np.ndarray:
         """Generate points using Poisson disk sampling for uniform distribution"""
         # Simple implementation of Poisson disk sampling with rejection method
         points = []
         max_attempts = 10000
         radius_squared = radius_min * radius_min
 
         # Generate candidates and accept them with minimum distance constraint
         for _ in range(max_attempts):
             if len(points) >= n:
                 break
             x = random.uniform(radius_min, 1 - radius_min)
             y = random.uniform(radius_min, 1 - radius_min)
 
             # Check distance to all existing points
             valid = True
             for px, py in points:
                 dx = x - px
                 dy = y - py
                 if dx*dx + dy*dy < radius_squared:
                     valid = False
                     break
 
             if valid:
                 points.append((x, y))
 
         # If we didn't get enough points, fill with random distribution
         while len(points) < n:
             points.append((random.uniform(radius_min, 1 - radius_min),
                           random.uniform(radius_min, 1 - radius_min)))
 
         # Convert to circles with appropriate radii
         circles = np.zeros((n, 3))
         for i, (x, y) in enumerate(points[:n]):
             r = radius_min + random.uniform(0, radius_min * 0.5)
             circles[i] = [x, y, r]
 
         return circles
 
     @staticmethod
     def generate_voronoi_distribution(n: int) -> np.ndarray:
         """Generate high-quality Voronoi-like distribution using iterative optimization"""
         circles = np.zeros((n, 3))
 
         # Start with a regular grid pattern
         rows = int(np.ceil(np.sqrt(n)))
         cols = int(np.ceil(n / rows))
 
         # Space the grid points to maximize coverage
         spacing_x = 0.9 / (cols + 1)
         spacing_y = 0.9 / (rows + 1)
 
         points = []
         for i in range(rows):
             for j in range(cols):
                 if len(points) < n:
                     x = 0.05 + (j + 1) * spacing_x
                     y = 0.05 + (i + 1) * spacing_y
                     points.append((x, y))
 
         # Fill remaining points with random distribution
         while len(points) < n:
             points.append((random.uniform(0.05, 0.95), random.uniform(0.05, 0.95)))
 
         # Apply more sophisticated Voronoi-inspired spacing
         for i in range(n):
             x_base, y_base = points[i]
 
             # Apply more controlled randomness with preference for spreading
             jitter_x = random.uniform(-spacing_x * 0.3, spacing_x * 0.3)
             jitter_y = random.uniform(-spacing_y * 0.3, spacing_y * 0.3)
 
             x = max(0.01, min(0.99, x_base + jitter_x))
             y = max(0.01, min(0.99, y_base + jitter_y))
 
             # Assign initial radius with more diversity
             r = 0.02 + random.uniform(0, 0.05)
 
             circles[i] = [x, y, r]
 
         return circles
 
     @staticmethod
     def generate_adaptive_grid(n: int) -> np.ndarray:
         """Generate grid-based distribution with adaptive spacing"""
         circles = np.zeros((n, 3))
 
         # Create an adaptive grid that becomes denser near edges
         rows = int(np.ceil(np.sqrt(n)))
         cols = int(np.ceil(n / rows))
 
         # Use variable spacing to create more organic distribution
         spacing_x = 0.85 / (cols + 1)
         spacing_y = 0.85 / (rows + 1)
 
         center_x = 0.5
         center_y = 0.5
 
         for i in range(n):
             row = i // cols
             col = i % cols
 
             # Add bias towards center for better packing
             x_base = (col + 1) * spacing_x
             y_base = (row + 1) * spacing_y
 
             # Create distance-based adjustment to cluster toward center
             dist_from_center = math.sqrt((x_base - center_x)**2 + (y_base - center_y)**2)
             adjustment_factor = 1.0 - min(0.7, dist_from_center * 0.5)
 
             x = 0.05 + x_base * adjustment_factor
             y = 0.05 + y_base * adjustment_factor
 
             # Apply small random perturbation
             x = max(0.01, min(0.99, x + random.uniform(-spacing_x * 0.2, spacing_x * 0.2)))
             y = max(0.01, min(0.99, y + random.uniform(-spacing_y * 0.2, spacing_y * 0.2)))
 
             # Assign radius with some variation
             r = 0.02 + random.uniform(0, 0.04)
 
             circles[i] = [x, y, r]
 
         return circles
 
 class EvolutionaryOptimizer:
     """Main evolutionary optimization class with enhanced strategies"""
 
     def __init__(self, population_size: int = 120, generations: int = 250):
         self.population_size = population_size
         self.generations = generations
         self.spatial_indexer = SpatialIndexer()
         self.validator = ConstraintValidator()
         self.evaluator = FitnessEvaluator()
         self.init_strategy = AdvancedVoronoiInitialization()
 
     def initialize_population(self, n: int) -> np.ndarray:
         """Initialize population with advanced hybrid approach"""
         population = []
 
         # Use a combination of initialization strategies
         for i in range(self.population_size):
             # Alternate between initialization methods with different weights
             rand_val = random.random()
             if rand_val < 0.4:  # 40% chance for Poisson disk
                 # Poisson disk distribution
                 circles = self.init_strategy.generate_poisson_disk_distribution(n)
             elif rand_val < 0.7:  # 30% chance for Voronoi-like
                 # Voronoi-like distribution
                 circles = self.init_strategy.generate_voronoi_distribution(n)
             elif rand_val < 0.9:  # 20% chance for adaptive grid
                 # Adaptive grid
                 circles = self.init_strategy.generate_adaptive_grid(n)
             else:  # 10% chance for pure random
                 # Pure random with structured bounds
                 circles = np.zeros((n, 3))
                 for j in range(n):
                     x = random.uniform(0.05, 0.95)
                     y = random.uniform(0.05, 0.95)
                     r = random.uniform(0.01, 0.08)
                     circles[j] = [x, y, r]
 
             # Apply constraint enforcement
             circles = self.validator.enforce_bounds(circles)
 
             # Add noise to ensure diversity in initial population
             for j in range(n):
                 if random.random() < 0.1:  # 10% chance to perturb
                     circles[j, 0] = max(0.01, min(0.99, circles[j, 0] + random.gauss(0, 0.01)))
                     circles[j, 1] = max(0.01, min(0.99, circles[j, 1] + random.gauss(0, 0.01)))
                     circles[j, 2] = max(0.001, min(0.49, circles[j, 2] + random.gauss(0, 0.005)))
 
             population.append(circles)
 
         return np.array(population)
 
     def mutate(self, circles: np.ndarray, generation: int, total_generations: int) -> np.ndarray:
         """Enhanced mutation with adaptive rates and specialized operators"""
         mutated = circles.copy()
 
         # Adaptive mutation rate based on generation progress
         # Start high and decrease gradually for better exploration then exploitation
         progress = generation / total_generations
         mutation_rate = 0.2 * (1 - progress * 0.8) + 0.05
 
         # Add fitness-dependent mutation intensity
         total_radius = np.sum(circles[:, 2])
         intensity_factor = 1.0 + 0.5 * (total_radius / 10.0)  # Higher for larger radii
 
         n = len(mutated)
 
         # Mutate circles with adaptive rate and intensity
         for i in range(n):
             if random.random() < mutation_rate:
                 # Choose which component to mutate with probabilities favoring position over radius
                 choice = random.choices([0, 1, 2], weights=[0.45, 0.45, 0.1])[0]
 
                 if choice == 0:  # X coordinate - larger mutation for exploration
                     delta = random.gauss(0, 0.03 * intensity_factor)
                     mutated[i, 0] = max(0.01, min(0.99, mutated[i, 0] + delta))
                 elif choice == 1:  # Y coordinate - larger mutation for exploration
                     delta = random.gauss(0, 0.03 * intensity_factor)
                     mutated[i, 1] = max(0.01, min(0.99, mutated[i, 1] + delta))
                 else:  # Radius - smaller mutation for fine-tuning
                     delta = random.gauss(0, 0.01 * intensity_factor)
                     mutated[i, 2] = max(0.001, min(0.49, mutated[i, 2] + delta))
 
         # Apply refinement steps
         mutated = self._refine_after_mutation(mutated)
         mutated = self.validator.enforce_bounds(mutated)
 
         return mutated
 
