         # Update overall best
         if best_sequence is not None:
             _, inv_c1_final = compute_c1_constant(best_sequence)
             if inv_c1_final > best_overall_inv_c1:
                 best_overall_inv_c1 = inv_c1_final
                 best_overall_sequence = best_sequence.copy()
 
     return best_overall_sequence if best_overall_sequence is not None else [1.0]
 
