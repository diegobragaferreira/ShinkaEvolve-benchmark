+def convolve_adaptive(a: np.ndarray, b: np.ndarray, threshold: int = 100) -> np.ndarray:
+    """Adaptive convolution switching between FFT and direct based on input size and signal characteristics."""
+    n = len(a)
+    if n > threshold:
+        # Use FFT for large sequences
+        conv_result = fftconvolve(a, b, mode='full')
+        return conv_result[:2*n-1]
+    else:
+        # Use direct convolution for smaller sequences
+        conv_result = np.convolve(a, b, mode='full')
+        return conv_result[:2*n-1]
+
+def compute_c1_constant(sequence: List[float]) -> Tuple[float, float]:
+    """Compute C1 constant and 1/C1 value for a given sequence."""
+    a = np.array(sequence)
+    n = len(a)
+
+    # Use adaptive convolution method
+    b = convolve_adaptive(a, a)
+
+    max_conv = np.max(b)
+    sum_a = np.sum(a)
+
+    if sum_a < 0.01:
+        return float('inf'), 0.0
+
+    c1 = 2 * n * max_conv / (sum_a ** 2)
+    inv_c1 = 1.0 / c1 if c1 > 0 else 0.0
+
+    return c1, inv_c1
+
