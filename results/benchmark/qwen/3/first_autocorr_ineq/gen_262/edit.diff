+def compute_curvature(seq, eps=1e-4):
+    """Estimate the curvature for optimization."""
+    n = len(seq)
+    if n < 2:
+        return np.zeros(n)
+    
+    curvature = np.zeros(n)
+    for i in range(n):
+        left = np.array(seq)
+        right = np.array(seq)
+        left[max(0, i-1)] -= eps
+        right[min(n-1, i+1)] += eps
+        left = np.clip(left, 0, 1000)
+        right = np.clip(right, 0, 1000)
+        
+        l_conv = np.convolve(left, left, mode='full')[:2*n-1]
+        r_conv = np.convolve(right, right, mode='full')[:2*n-1]
+        
+        max_l = np.max(l_conv)
+        max_r = np.max(r_conv)
+        curvature[i] = (max_r - 2*max_l + max_l) / (eps**2)
+    return curvature
+
