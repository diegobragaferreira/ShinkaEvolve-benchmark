+class AutocorrelationOptimizer:
+    def __init__(self, max_iterations=50, fft_threshold=100):
+        self.max_iterations = max_iterations
+        self.fft_threshold = fft_threshold
+        
+    def compute_convolution(self, sequence):
+        """Compute convolution using FFT for efficiency when applicable."""
+        n = len(sequence)
+        if n > self.fft_threshold:
+            # Use FFT-based convolution for large sequences
+            padded_length = 2 * n - 1
+            fft_seq = fft(sequence, n=padded_length)
+            conv_result = ifft(fft_seq * np.conj(fft_seq)).real
+            return conv_result[:n]
+        else:
+            # Use standard convolution for small sequences
+            return np.convolve(sequence, sequence, mode='full')[:n]
