+    sum_seq = np.sum(sequence)
+    if sum_seq < 0.01:
+        return float('inf')
+
+    c1 = 2 * n * max_conv / (sum_seq ** 2)
+    return c1
+
+def compute_inv_c1(sequence):
+    """Compute 1/C₁ for a given sequence"""
+    c1 = compute_autocorrelation_constant(sequence)
+    if c1 == float('inf'):
+        return 0.0
+    return 1.0 / c1
 
