+def calculate_c1(sequence):
+    """Calculate the C1 constant for a given sequence."""
+    if len(sequence) == 0 or np.sum(sequence) < 0.01:
+        return float('inf')  # Invalid sequence
+
+    # Use FFT for better performance on larger sequences
+    if len(sequence) > 100:
+        convolved = fft_convolve(sequence, sequence, mode='full')
+    else:
+        convolved = np.convolve(sequence, sequence, mode='full')
+
+    max_conv = np.max(convolved)
+    sum_squares = np.sum(sequence) ** 2
+    n = len(sequence)
+
+    # Avoid division by zero
+    if sum_squares == 0:
+        return float('inf')
+
+    return (2 * n * max_conv) / sum_squares
+
+def evaluate_individual(individual):
+    """Evaluate the fitness of an individual."""
+    try:
+        # Clip values to be within bounds
+        clipped_ind = [max(0, min(1000, x)) for x in individual]
+
+        # Calculate C1
+        c1 = calculate_c1(clipped_ind)
+
+        # Return inverse of C1 to maximize 1/C1
+        if c1 == 0:
+            return 0,
+        elif np.isinf(c1):
+            return 0,
+        else:
+            return (1.0 / c1),
+    except Exception:
+        return (0,)
+
