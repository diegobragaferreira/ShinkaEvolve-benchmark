+def normalize_sequence(sequence: List[float]) -> List[float]:
+    """Normalize sequence to unit sum, but avoid division by zero."""
+    s = sum(sequence)
+    if s < 0.01:
+        # Add small epsilon to prevent division by zero
+        s = 0.01
+    return [x / s for x in sequence]
