+def get_good_direction_to_move_into(sequence):
+    """
+    Returns the direction to move into the sequence using LP optimization.
+    """
+    n = len(sequence)
+    if n == 0:
+        return None
+
+    sum_sequence = np.sum(sequence)
+    normalized_sequence = np.array(sequence) * np.sqrt(2 * n) / max(sum_sequence, 1e-10)
+
+    try:
+        # Compute maximum convolution value
+        # More precise convolution calculation
+        padded_len = 2 * n - 1
+        a_padded = np.pad(normalized_sequence, (0, padded_len - n), 'constant')
+        fft_a = fft(a_padded)
+        conv_fft = fft_a * np.conj(fft_a)
+        conv_result = ifft(conv_fft).real[:n]
+        rhs = np.max(conv_result)
+
+        # Solve LP optimization
+        g_fun = solve_convolution_lp(normalized_sequence, rhs)
+
+        if g_fun is None or np.any(np.isnan(g_fun)):
+            return None
+
+        # Normalize the resulting sequence
+        sum_g = np.sum(g_fun)
+        if sum_g < 1e-8:
+            return None
+
+        normalized_g_fun = g_fun * np.sqrt(2 * n) / max(sum_g, 1e-10)
+
+        # Apply small perturbation to maintain diversity
+        t = 0.05  # Increased from 0.01 to provide more aggressive movement
+        new_sequence = [
+            (1 - t) * x + t * y for x, y in zip(sequence, normalized_g_fun)
+        ]
+
+        # Ensure non-negativity
+        new_sequence = [max(0, x) for x in new_sequence]
+
+        return new_sequence
+
+    except Exception as e:
+        return None
