+def solve_convolution_lp(f_sequence, rhs):
+    """Solves the convolution LP with improved numerical stability."""
+    n = len(f_sequence)
+    if n == 0:
+        return None
+
+    try:
+        # Create constraint matrix efficiently
+        a_ub = []
+        b_ub = []
+
+        # Generate convolution constraints
+        for k in range(2 * n - 1):
+            row = np.zeros(n)
+            for i in range(n):
+                j = k - i
+                if 0 <= j < n:
+                    row[j] = f_sequence[i]
+            a_ub.append(row)
+            b_ub.append(rhs)
+
+        # Non-negativity constraints
+        a_ub_nonneg = -np.eye(n)
+        b_ub_nonneg = np.zeros(n)
+
+        a_ub = np.vstack([a_ub, a_ub_nonneg])
+        b_ub = np.hstack([b_ub, b_ub_nonneg])
+
+        # Objective: minimize sum of variables (which corresponds to maximizing 1/C1)
+        c = np.ones(n)
+
+        # Solve with bounds - use more robust solver settings
+        bounds = [(0, 1000) for _ in range(n)]  # Clip values to reasonable bounds
+
+        # Use different solver options for better stability
+        result = minimize(
+            lambda x: np.sum(x),
+            x0=np.ones(n),
+            bounds=bounds,
+            method='L-BFGS-B',
+            options={'maxiter': 100}
+        )
+
+        if result.success:
+            return result.x
+        else:
+            return None
+
+    except Exception as e:
+        return None
