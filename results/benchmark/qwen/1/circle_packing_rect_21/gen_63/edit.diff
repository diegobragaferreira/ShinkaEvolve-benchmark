         for i in range(0, len(individual), 3):
             x, y, r = individual[i], individual[i+1], individual[i+2]
             circles.append((x, y, r))
 
         # Check if all circles are within bounds
         for x, y, r in circles:
             if not is_valid_position(x, y, r):
                 return (-1e6,)  # Penalty for out of bounds
 
         # Check for overlaps
         for i in range(len(circles)):
             for j in range(i+1, len(circles)):
                 if check_overlap(circles[i], circles[j]):
                     return (-1e6,)  # Penalty for overlaps
 
         # Return negative sum of radii (minimization problem)
         total_radius = sum(r for _, _, r in circles)
         return (-total_radius,)
 
