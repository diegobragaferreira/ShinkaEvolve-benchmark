+    offset_x = (width - grid_width) / 2
+    offset_y = (height - grid_height) / 2
+
+    # Generate positions
+    positions = []
+    for i in range(rows):
+        for j in range(cols):
+            x = offset_x + j * dx + (i % 2) * dx / 2
+            y = offset_y + i * dy
+
