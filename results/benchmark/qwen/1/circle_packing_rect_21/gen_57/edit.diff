+class SpatialHashGrid:
+    """Efficient spatial indexing for collision detection"""
+    
+    def __init__(self, width: float, height: float, cell_size: float = None):
+        self.width = width
+        self.height = height
+        self.cell_size = cell_size or (min(width, height) * 0.1)
+        self.grid = {}
+        
+    def _hash(self, x: float, y: float) -> Tuple[int, int]:
+        return (int(x // self.cell_size), int(y // self.cell_size))
+    
+    def add_circle(self, idx: int, x: float, y: float, r: float):
+        """Add a circle to the spatial hash grid"""
+        hash_key = self._hash(x, y)
+        if hash_key not in self.grid:
+            self.grid[hash_key] = []
+        self.grid[hash_key].append((idx, x, y, r))
+        
+    def get_neighbors(self, x: float, y: float, r: float) -> List[Tuple[int, float, float, float]]:
+        """Get all circles in neighboring cells"""
+        neighbors = []
+        center_hash = self._hash(x, y)
+        
+        # Check 3x3 neighborhood
+        for dx in [-1, 0, 1]:
+            for dy in [-1, 0, 1]:
+                neighbor_hash = (center_hash[0] + dx, center_hash[1] + dy)
+                if neighbor_hash in self.grid:
+                    for circle in self.grid[neighbor_hash]:
+                        neighbors.append(circle)
+                        
+        return neighbors
+    
+    def clear(self):
+        self.grid.clear()
+
+def calculate_voronoi_criticality(circles: np.ndarray, rect_width: float, rect_height: float) -> np.ndarray:
+    """
+    Calculate Voronoi cell areas for each circle to determine constraint density
+    """
+    # Add boundary points to ensure proper Voronoi computation
+    n = len(circles)
+    
+    # Create points including rectangle boundaries for proper Voronoi
+    points = circles[:, :2].copy()
+    
+    # Add boundary guard points to avoid infinite cells
+    boundary_points = [
+        [0, 0], [rect_width, 0], [0, rect_height], [rect_width, rect_height],
+        [rect_width/2, 0], [rect_width/2, rect_height],
+        [0, rect_height/2], [rect_width, rect_height/2]
+    ]
+    
+    # Add boundary points to avoid infinite Voronoi cells
+    extended_points = np.vstack([points, boundary_points])
+    
+    try:
+        vor = Voronoi(extended_points)
+        
+        # For each original point, compute Voronoi cell area
+        criticalities = np.zeros(n)
+        
+        for i in range(n):
+            # Find Voronoi vertices for the i-th point
+            region_indices = np.where(np.array(vor.point_region) == i)[0]
+            if len(region_indices) > 0:
+                region_id = region_indices[0]
+                vertices = vor.regions[region_id]
+                if -1 not in vertices and len(vertices) > 2:
+                    # Get the actual vertices for this region
+                    region_vertices = np.array([vor.vertices[v] for v in vertices])
+                    # Compute area using shoelace formula
+                    area = 0.5 * np.abs(np.dot(region_vertices[:, 0], np.roll(region_vertices[:, 1], 1)) - 
+                                       np.dot(region_vertices[:, 1], np.roll(region_vertices[:, 0], 1)))
+                    criticalities[i] = area
+                else:
+                    criticalities[i] = 1.0  # Default if bad region
+            else:
+                criticalities[i] = 1.0
+                
+    except:
+        # Fallback to simple inverse radius estimation
+        criticalities = 1.0 / (circles[:, 2] + 1e-8)
+        
+    # Normalize criticalities to [0.1, 1.0] range
+    if np.max(criticalities) > 0:
+        normalized = (criticalities - np.min(criticalities)) / (np.max(criticalities) - np.min(criticalities) + 1e-8)
+        normalized = 0.1 + 0.9 * normalized
+    else:
+        normalized = np.ones(n) * 0.5
+        
+    return normalized
