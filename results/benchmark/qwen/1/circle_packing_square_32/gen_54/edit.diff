     def _simple_grid_initialization(n_circles: int) -> np.ndarray:
         """Fallback grid-based initialization"""
         circles = np.zeros((n_circles, 3))
         placed = 0
         for i in range(6):
             for j in range(6):
                 if placed >= n_circles:
                     break
                 x = 0.1 + i * 0.15
                 y = 0.1 + j * 0.15
                 r = 0.05
                 circles[placed] = [x, y, r]
                 placed += 1
             if placed >= n_circles:
                 break
         return circles
 
