+class SpatialGrid:
+    """A spatial grid for efficient collision detection"""
+    def __init__(self, grid_size=0.15):
+        self.grid_size = grid_size
+        self.grid = {}
+        
+    def _hash(self, x, y):
+        """Hash coordinates to grid cell"""
+        return (int(x / self.grid_size), int(y / self.grid_size))
+    
+    def add_circle(self, circle):
+        """Add a circle to the spatial grid"""
+        x, y, r = circle
+        cell = self._hash(x, y)
+        if cell not in self.grid:
+            self.grid[cell] = []
+        self.grid[cell].append(circle)
+    
+    def remove_circle(self, circle):
+        """Remove a circle from the spatial grid"""
+        x, y, r = circle
+        cell = self._hash(x, y)
+        if cell in self.grid:
+            try:
+                self.grid[cell].remove(circle)
+            except ValueError:
+                pass
+    
+    def get_neighbors(self, circle):
+        """Get neighboring circles in nearby cells"""
+        x, y, r = circle
+        neighbors = []
+        cell = self._hash(x, y)
+        
+        # Check all 9 surrounding cells
+        for dx in [-1, 0, 1]:
+            for dy in [-1, 0, 1]:
+                neighbor_cell = (cell[0] + dx, cell[1] + dy)
+                if neighbor_cell in self.grid:
+                    neighbors.extend(self.grid[neighbor_cell])
+        
+        return neighbors
