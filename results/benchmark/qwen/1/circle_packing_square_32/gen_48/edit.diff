         if x - r < 0 or x + r > 1 or y - r < 0 or y + r > 1:
             return False
     return True
 
+def check_overlap_fast(circles):
+    """Fast overlap check using KDTree"""
+    if len(circles) < 2:
+        return True
+        
+    # Build KDTree for fast nearest neighbor search
+    points = np.array([[x, y] for x, y, r in circles])
+    tree = cKDTree(points)
+    
+    # For each circle, check if any other circle is within its combined radius
+    for i, (x, y, r) in enumerate(circles):
+        # Find neighbors within distance 2*r (sum of radii)
+        neighbors = tree.query_ball_point([x, y], 2*r, p=2)
+        # Exclude self
+        neighbors = [idx for idx in neighbors if idx != i]
+        
+        # Check actual distances
+        for j in neighbors:
+            x2, y2, r2 = circles[j]
+            distance = np.sqrt((x-x2)**2 + (y-y2)**2)
+            if distance < r + r2:
+                return False
+                
+    return True
