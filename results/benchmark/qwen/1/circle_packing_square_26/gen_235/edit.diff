 class CircleValidator:
     """Handles validation of circle configurations"""
 
     @staticmethod
     def is_valid_configuration(circles: np.ndarray) -> bool:
         """Check if a configuration of circles is valid (no overlaps, fully contained)."""
         n = len(circles)
         if n == 0:
             return True
 
         # Check containment constraints
         for i in range(n):
             x, y, r = circles[i]
             if r <= 0 or x < r + BOUNDARY_MARGIN or x > 1-r - BOUNDARY_MARGIN or y < r + BOUNDARY_MARGIN or y > 1-r - BOUNDARY_MARGIN:
                 return False
 
         # Check overlap constraints efficiently
         # Only check pairs that could potentially overlap based on bounding boxes
         for i in range(n):
             x1, y1, r1 = circles[i]
             # Only compare with circles that could possibly overlap
             for j in range(i+1, n):
                 x2, y2, r2 = circles[j]
                 # Quick bounding box check
                 if abs(x1 - x2) > (r1 + r2 + BOUNDARY_MARGIN) or abs(y1 - y2) > (r1 + r2 + BOUNDARY_MARGIN):
                     continue
 
                 distance_squared = (x1-x2)**2 + (y1-y2)**2
                 min_distance_squared = (r1 + r2)**2
                 if distance_squared < min_distance_squared:
                     return False
 
         return True
 
 class FitnessEvaluator:
     """Handles fitness evaluation for circle configurations"""
 
     @staticmethod
     def evaluate_fitness(circles: np.ndarray) -> float:
         """Evaluate fitness as the sum of radii."""
         return np.sum(circles[:, 2])
 
