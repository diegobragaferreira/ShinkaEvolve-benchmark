+def evaluate_fitness(individual: list) -> Tuple[float,]:
+    """Evaluate fitness of individual (list of [x,y,r])"""
+    # Convert to array for easier manipulation
+    circles = np.array(individual).reshape(-1, 3)
+    
+    # Extract positions and radii
+    positions = circles[:, :2]
+    radii = circles[:, 2]
