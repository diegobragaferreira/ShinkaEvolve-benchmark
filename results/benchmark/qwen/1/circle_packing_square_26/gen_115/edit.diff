+def calculate_maximum_radius(circles: np.ndarray, idx: int) -> float:
+    """Calculate the maximum possible radius for circle at index idx"""
+    x, y, _ = circles[idx]
+    
+    # Boundary constraints
+    max_radius_boundary = min(x, y, 1-x, 1-y)
+    
+    # Non-overlap constraints
+    max_radius_overlap = max_radius_boundary
+    for i in range(len(circles)):
+        if i != idx:
+            x_i, y_i, r_i = circles[i]
+            # Distance to center of circle i
+            dist = np.sqrt((x - x_i)**2 + (y - y_i)**2)
+            # Max radius is limited by distance to this circle minus its radius
+            max_radius_from_circle = dist - r_i
+            if max_radius_from_circle > 0:
+                max_radius_overlap = min(max_radius_overlap, max_radius_from_circle)
+    
+    return max_radius_overlap
+
+def optimize_single_circle(circles: np.ndarray, idx: int, max_iter: int = 100) -> np.ndarray:
+    """Optimize a single circle's position and radius using constrained optimization"""
+    optimized = circles.copy()
+    
+    # Define the objective: maximize radius
+    def objective(r):
+        x, y = r[0], r[1]
+        radius = r[2]
+        
+        # Penalty for going out of bounds
+        penalty = 0
+        if x < radius or x > 1-radius or y < radius or y > 1-radius:
+            penalty = 1000
+        
+        # Penalty for overlapping with others
+        for i in range(len(circles)):
+            if i != idx:
+                x_i, y_i, r_i = circles[i]
+                dist = np.sqrt((x - x_i)**2 + (y - y_i)**2)
+                if dist < radius + r_i:
+                    penalty += 1000 * (radius + r_i - dist)
+        
+        return -(radius + penalty)  # Negative because we want to maximize
+    
+    # Initial guess
+    x_guess, y_guess, r_guess = optimized[idx]
+    
+    # Bounds for optimization
+    bounds = Bounds([0 + 1e-6, 0 + 1e-6, 1e-6], [1 - 1e-6, 1 - 1e-6, 1 - 1e-6])
+    
+    # Optimize
+    try:
+        result = minimize(objective, [x_guess, y_guess, r_guess], method='L-BFGS-B', bounds=bounds, options={'maxiter': max_iter})
