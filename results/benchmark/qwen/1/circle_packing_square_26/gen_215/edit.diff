     def _speciate_population(self, population):
         """Apply speciation to preserve diversity by clustering similar individuals."""
         if len(population) < 10:
             return population
             
         # Convert individuals to feature vectors for clustering
         features = []
         for ind in population:
             circles = np.array(ind).reshape(-1, 3)
             # Create feature vector: mean and std of radii + mean of positions
             radii = circles[:, 2]
             positions = circles[:, :2]
             features.append(np.concatenate([
                 [np.mean(radii), np.std(radii)],
                 np.mean(positions, axis=0),
                 np.std(positions, axis=0)
             ]))
         
         # Simple k-means style clustering
         n_clusters = max(1, len(population) // 10)  # Aim for 10% diversity
         clustered_pop = []
         
         # Group similar individuals together
         if len(features) > 0:
             # For simplicity, just take top individuals
             sorted_indices = np.argsort([-self._evaluate_fitness(ind)[0] for ind in population])
             top_individuals = [population[i] for i in sorted_indices[:len(population)//2]]
             rest_individuals = [population[i] for i in sorted_indices[len(population)//2:]]
             
             # Preserve diversity by keeping a mix
             clustered_pop.extend(top_individuals)
             # Add some from the rest
             import random
             random.shuffle(rest_individuals)
             clustered_pop.extend(rest_individuals[:len(population)//4])
         
         return clustered_pop if clustered_pop else population
 
