+    
+    # Compute autoconvolution manually for better performance
+    n = len(f_vals)
+    g = np.zeros(2*n - 1)
+    
+    # Manual convolution loop 
+    for i in range(n):
+        for j in range(n):
+            g[i + j] += f_vals[i] * f_vals[j]
+    
+    # Trim to center portion for proper intervalmapping [-1/4, 1/4]
