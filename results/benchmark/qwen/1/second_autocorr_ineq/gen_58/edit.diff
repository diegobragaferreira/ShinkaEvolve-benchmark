     # ||g||₁ - sum of absolute values
     norm_g_1 = np.sum(g_abs)
     
     # ||g||∞ - maximum absolute value
     norm_g_inf = np.max(g_abs)
     
     # Avoid division by zero
     if norm_g_1 == 0 or norm_g_inf == 0:
