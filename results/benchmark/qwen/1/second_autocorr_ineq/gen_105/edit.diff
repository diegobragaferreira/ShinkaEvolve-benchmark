 def compute_flatness_penalty(g_vals):
     """
     Compute penalty based on variance of g_vals to encourage flatness
     """
     if len(g_vals) < 2:
         return 0.0
     mean_val = np.mean(g_vals)
     if mean_val <= 1e-15:
         return 0.0
     variance = np.var(g_vals)
     return variance / (mean_val * mean_val)
 
