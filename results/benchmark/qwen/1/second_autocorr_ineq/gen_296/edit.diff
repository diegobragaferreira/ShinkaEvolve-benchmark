 @jax_jit
 def compute_c2_jax(g_vals):
     """JAX version of C2 computation"""
     if len(g_vals) == 0:
         return 0.0
 
     # Compute norms using JAX operations
     g_l2_sq = jnp.sum((g_vals[:-1]**2 + g_vals[:-1]*g_vals[1:] + g_vals[1:]**2) * STEP_WIDTH / 3.0)
     g_l1 = jnp.sum(jnp.abs(g_vals))
     g_max = jnp.max(jnp.abs(g_vals))
 
     # Compute C2 with better numerical handling
