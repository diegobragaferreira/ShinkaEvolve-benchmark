     @njit
     def compute_autoconvolution_numba(f):
         """Compute autoconvolution g = f * f using numba JIT"""
         n = len(f)
         # Autoconvolution using discrete convolution
         g = np.zeros(2*n - 1)
         for i in range(n):
             for j in range(n):
                 g[i + j] += f[i] * f[j]
         
         # Trim to center portion (length n-1)
         offset = (n - 1) // 2
         g_trimmed = g[offset:(2*n-1)-offset]
         return g_trimmed
     
