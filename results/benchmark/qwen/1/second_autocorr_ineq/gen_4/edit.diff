+def compute_autoconvolution_norms(f_values):
+    """
+    Compute the three norms needed for C2 calculation:
+    ||g||₂², ||g||₁, ||g||∞ where g = f*f
+    """
+    if len(f_values) == 0:
+        return 0.0, 0.0, 0.0
+    
+    # Create step function on [-1/4, 1/4] with equal spacing
+    n_steps = len(f_values)
