+    
+    # Compute autoconvolution g = f * f using fast convolution
+    # Using the fact that convolution of step functions has a known form
+    # But we'll use direct computation for accuracy
+    g = signal.convolve(f, f, mode='full')
+    
+    # Adjust indices to match the correct domain
+    # The convolution result spans from -0.5 to 0.5
+    # We want it on [-0.5, 0.5] with appropriate discretization
+    g_x = np.linspace(-0.5, 0.5, len(g))
+    
+    # For simplicity, we'll focus on the valid range [-0.25, 0.25] 
+    # and compute norms appropriately
+    g_valid_idx = np.where((g_x >= -0.25) & (g_x <= 0.25))[0]
+    g_valid = g[g_valid_idx]
+    
+    # Compute norms
+    # ||g||₂² using trapezoidal rule approximation for piecewise linear integration
+    if len(g_valid) < 2:
+        g_norm_2_sq = 0.0
+    else:
+        # For trapezoidal integration of g², we need pairs of points
+        # For a piecewise linear function, the integral of f² over segment [x_i, x_{i+1}] 
+        # with values y_i, y_{i+1} is approximately (x_{i+1}-x_i)/3 * (y_i² + y_i*y_{i+1} + y_{i+1}²)
+        g_norm_2_sq = 0.0
+        dx_g = 2 * 0.25 / (len(g_valid) - 1)  # width between points in g
+        for i in range(len(g_valid) - 1):
+            y1, y2 = g_valid[i], g_valid[i+1]
+            g_norm_2_sq += (dx_g / 3.0) * (y1*y1 + y1*y2 + y2*y2)
+    
+    # ||g||₁ = sum of absolute values divided by number of points
+    g_norm_1 = np.sum(np.abs(g_valid)) / len(g_valid) if len(g_valid) > 0 else 0.0
+    
+    # ||g||∞ = maximum absolute value
+    g_norm_inf = np.max(np.abs(g_valid)) if len(g_valid) > 0 else 0.0
+    
+    return g_norm_2_sq, g_norm_1, g_norm_inf
+
+def evaluate_c2(f_values):
+    """
+    Evaluate C2 = ||g||₂² / (||g||₁ · ||g||∞)
+    """
+    try:
+        g_norm_2_sq, g_norm_1, g_norm_inf = compute_autoconvolution_norms(f_values)
+        
+        # Avoid division by zero
+        if g_norm_1 == 0 or g_norm_inf == 0:
+            return 0.0
+        
+        c2 = g_norm_2_sq / (g_norm_1 * g_norm_inf)
+        return c2
+    except Exception:
+        return 0.0
 
