 def compute_autoconvolution_norms_jax(f_values):
     """
     Compute the three norms needed for C2 calculation using JAX
     """
     f = jnp.array(f_values, dtype=jnp.float64)
     # Ensure non-negative values
     f = jnp.maximum(f, 0.0)
 
     # Compute autoconvolution using JAX
     g_centered = compute_autoconvolution_jax(f)
 
     # Compute the norms
     g_squared = g_centered ** 2
     g_abs = jnp.abs(g_centered)
 
     # ||g||₂² - sum of squares
     norm_g_2_squared = jnp.sum(g_squared)
 
     # ||g||₁ - sum of absolute values
     norm_g_1 = jnp.sum(g_abs)
 
     # ||g||∞ - maximum absolute value
     norm_g_inf = jnp.max(g_abs)
 
     # Avoid division by zero
     safe_norm_g_1 = jnp.where(norm_g_1 <= 1e-15, 1e-15, norm_g_1)
     safe_norm_g_inf = jnp.where(norm_g_inf <= 1e-15, 1e-15, norm_g_inf)
 
     # Return C2 value
     c2 = norm_g_2_squared / (safe_norm_g_1 * safe_norm_g_inf)
 
     return c2
 
