+class GridSpatialIndex:
+    """Spatial index for efficient collision detection using a grid-based approach."""
+    
+    def __init__(self, cell_size: float = 2.0):
+        self.cell_size = cell_size
+        self.grid = {}
+    
+    def _get_cell_key(self, x: float, y: float) -> Tuple[int, int]:
+        """Get grid cell key for a point."""
+        return (int(x // self.cell_size), int(y // self.cell_size))
+    
+    def insert(self, hexagon: Hexagon, hex_id: int):
+        """Insert a hexagon into the spatial index."""
+        vertices = hexagon.get_vertices()
+        xs = [v[0] for v in vertices]
+        ys = [v[1] for v in vertices]
+        
+        min_x, max_x = min(xs), max(xs)
+        min_y, max_y = min(ys), max(ys)
+        
+        # Insert into all overlapping cells
+        start_col = int(min_x // self.cell_size)
+        end_col = int(max_x // self.cell_size)
+        start_row = int(min_y // self.cell_size)
+        end_row = int(max_y // self.cell_size)
+        
+        for col in range(start_col, end_col + 1):
+            for row in range(start_row, end_row + 1):
+                if (col, row) not in self.grid:
+                    self.grid[(col, row)] = []
+                self.grid[(col, row)].append(hex_id)
+    
+    def query(self, hexagon: Hexagon) -> List[int]:
+        """Query potential collisions for a hexagon."""
+        vertices = hexagon.get_vertices()
+        xs = [v[0] for v in vertices]
+        ys = [v[1] for v in vertices]
+        
+        min_x, max_x = min(xs), max(xs)
+        min_y, max_y = min(ys), max(ys)
+        
+        candidates = set()
+        start_col = int(min_x // self.cell_size)
+        end_col = int(max_x // self.cell_size)
+        start_row = int(min_y // self.cell_size)
+        end_row = int(max_y // self.cell_size)
+        
+        for col in range(start_col, end_col + 1):
+            for row in range(start_row, end_row + 1):
+                if (col, row) in self.grid:
+                    candidates.update(self.grid[(col, row)])
+        
+        return list(candidates)
