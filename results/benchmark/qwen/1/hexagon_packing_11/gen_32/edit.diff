+class Hexagon:
+    """Represents a regular hexagon with configurable position, rotation, and size."""
+    
+    def __init__(self, center_x: float, center_y: float, angle_deg: float, side_length: float = 1.0):
+        self.center_x = center_x
+        self.center_y = center_y
+        self.angle_deg = angle_deg
+        self.side_length = side_length
+    
+    def get_vertices(self) -> List[Tuple[float, float]]:
+        """Generate vertices of the hexagon."""
+        angle_rad = math.radians(self.angle_deg)
+        base_vertices = []
+        for i in range(6):
+            theta = angle_rad + i * math.pi / 3
+            x = math.cos(theta)
+            y = math.sin(theta)
+            base_vertices.append((x, y))
+
+        # Scale and translate
+        vertices = [(self.center_x + self.side_length * vx, self.center_y + self.side_length * vy) 
+                   for vx, vy in base_vertices]
+        return vertices
+    
+    def contains_point(self, point: Tuple[float, float]) -> bool:
+        """Check if a point is inside this hexagon."""
+        vertices = self.get_vertices()
+        poly = Polygon(vertices)
+        return poly.contains(Point(point[0], point[1]))
