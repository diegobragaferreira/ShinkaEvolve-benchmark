+    for i in range(len(inner_hex_data)):
+        x, y, angle = inner_hex_data[i]
+        # Get hexagon vertices
+        vertices = hexagon_vertices(x, y, np.radians(angle), side_length)
+        
+        # Find maximum distance from center to any vertex
