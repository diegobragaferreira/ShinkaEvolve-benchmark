+def build_spatial_grid(hexagons, positions, angles):
+    """Build quadtree-based spatial grid for collision detection"""
+    if len(hexagons) == 0:
+        return None
+    
+    # Determine bounds of all hexagons
+    min_x = min_y = float('inf')
+    max_x = max_y = float('-inf')
+    
+    for i in range(len(positions)):
+        pos = positions[i]
+        angle = angles[i]
+        hex_vertices = hexagon_vertices(pos[0], pos[1], angle)
+        for vx, vy in hex_vertices:
+            min_x = min(min_x, vx)
+            max_x = max(max_x, vx)
+            min_y = min(min_y, vy)
+            max_y = max(max_y, vy)
+    
+    # Add some padding
+    padding = 0.5
+    min_x -= padding
+    max_x += padding
+    min_y -= padding
+    max_y += padding
+    
+    # Create quadtree
+    boundary = (min_x, min_y, max_x, max_y)
+    tree = QuadTree(boundary, capacity=4)
+    
+    # Insert all hexagon centers
+    for i in range(len(positions)):
+        pos = positions[i]
+        tree.insert((pos[0], pos[1]), i)
+    
+    return tree
