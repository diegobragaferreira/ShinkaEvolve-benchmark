+def parallel_evaluate_solutions(solutions, outer_radius_estimate=None):
+    """Evaluate multiple solutions in parallel"""
+    results = Parallel(n_jobs=-1)(delayed(evaluate_single_solution)(sol, outer_radius_estimate) 
