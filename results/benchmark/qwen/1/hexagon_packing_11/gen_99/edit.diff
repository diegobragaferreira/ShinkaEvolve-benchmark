+
+def create_regular_hexagon(center=(0, 0), radius=1, rotation=0):
+    """Create a regular hexagon as a Shapely polygon"""
+    angles = np.linspace(0, 2*np.pi, 7) + np.radians(rotation)
+    x = center[0] + radius * np.cos(angles)
+    y = center[1] + radius * np.sin(angles)
+    return Polygon(list(zip(x, y)))
+
+
+def hexagon_vertices(center, radius, rotation):
+    """Get vertices of a regular hexagon"""
+    angles = np.linspace(0, 2*np.pi, 7) + np.radians(rotation)
+    return np.column_stack([center[0] + radius * np.cos(angles),
+                           center[1] + radius * np.sin(angles)])
+
+
+def check_containment(hexagon_poly, outer_hex_poly):
+    """Check if hexagon is fully contained within outer hexagon"""
+    return outer_hex_poly.contains(hexagon_poly) or outer_hex_poly.intersection(hexagon_poly).area > 0.1
+
+
+def check_overlap(hex1, hex2):
+    """Check if two hexagons overlap"""
+    poly1 = Polygon(hex1)
+    poly2 = Polygon(hex2)
+    return poly1.intersects(poly2)
+
+
+def evaluate_layout(inner_positions, inner_rotations, outer_radius):
+    """Evaluate a given hexagon layout"""
+    # Create outer hexagon
+    outer_hex = create_regular_hexagon((0, 0), outer_radius, 0)
+
+    # Check containment and overlap
+    total_penalty = 0
+
+    # Check each inner hexagon
+    for i, (pos, rot) in enumerate(zip(inner_positions, inner_rotations)):
+        hex_verts = hexagon_vertices(pos, 1, rot)
+        hex_poly = Polygon(hex_verts)
+
+        # Check containment
+        if not check_containment(hex_poly, outer_hex):
+            total_penalty += 1000  # Large penalty for violation
+
+        # Check overlap with others
+        for j in range(i+1, len(inner_positions)):
+            hex2_verts = hexagon_vertices(inner_positions[j], 1, inner_rotations[j])
+            hex2_poly = Polygon(hex2_verts)
+            if check_overlap(hex_verts, hex2_verts):
+                total_penalty += 1000  # Large penalty for overlap
+
+    return total_penalty
+
+
+def objective_function(params):
+    """Objective function to minimize (negative of 1/outer_radius)"""
+    # Parse parameters
+    # First 22 values: x,y positions for 11 hexagons
+    # Next 11 values: rotations for 11 hexagons
+    # Last value: outer hexagon radius
+
+    inner_positions = params[:22].reshape(-1, 2)
+    inner_rotations = params[22:33]
+    outer_radius = params[33]
+
+    # Ensure reasonable bounds on outer radius
+    if outer_radius < 1.0:
+        return 1e6
+
+    penalty = evaluate_layout(inner_positions, inner_rotations, outer_radius)
+
+    # Return negative 1/outer_radius plus penalties
+    return -1.0 / outer_radius + penalty
 
 
