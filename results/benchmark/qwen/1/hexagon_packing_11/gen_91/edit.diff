+def hexagon_collision(hex1_vertices, hex2_vertices):
+    """Fast collision detection using bounding circle and SAT"""
+    # Quick bounding circle check first
+    center1 = np.mean(hex1_vertices, axis=0)
+    center2 = np.mean(hex2_vertices, axis=0)
+    dist = np.linalg.norm(center1 - center2)
