+def tournament_selection(population, fitnesses, tournament_size=5):
+    """Select parent using tournament selection with variable tournament size"""
+    tournament_indices = random.sample(range(len(population)), tournament_size)
+    tournament_fitnesses = [fitnesses[i] for i in tournament_indices]
+    winner_idx = tournament_indices[np.argmax(tournament_fitnesses)]
+    return population[winner_idx]
+
+def crossover(parent1, parent2):
+    """Use uniform crossover with preserved structure"""
+    child1 = parent1.copy()
+    child2 = parent2.copy()
+    
+    # Uniform crossover with some structure preservation
+    for i in range(len(parent1)):
+        if random.random() < 0.5:
+            child1[i] = parent2[i]
+            child2[i] = parent1[i]
+    
+    return child1, child2
+
+def adaptive_mutation(individual, generation, max_generations, diversity):
+    """Apply adaptive mutation that decreases over time and increases with low diversity"""
+    mutated = individual.copy()
+    base_mutation_rate = 0.3 - (0.25 * generation / max_generations)
+    
+    # Increase mutation rate when diversity is low
+    if diversity < 0.001:
+        mutation_rate = base_mutation_rate * 2.0
+    else:
+        mutation_rate = base_mutation_rate
+    
+    mutation_rate = max(mutation_rate, 0.05)  # Minimum mutation rate
+    
+    # Mutate each gene
+    for i in range(len(mutated)):
+        if random.random() < mutation_rate:
+            # Position mutation with adaptive step size
+            if i % 3 < 2:  # x or y coordinate
+                step_size = 0.1 + (0.2 * (generation / max_generations))
+                mutated[i] += random.uniform(-step_size, step_size)
+                # Ensure within bounds
+                if i % 3 == 0:
+                    mutated[i] = max(-10, min(10, mutated[i]))
+                else:
+                    mutated[i] = max(-10, min(10, mutated[i]))
+            else:  # angle
+                mutated[i] += random.uniform(-15, 15)
+                mutated[i] %= 360
+                
+    return mutated
+
+def evaluate_fitness_with_cache(individual, cache={}):
+    """Evaluate fitness with caching for repeated calls"""
+    key = tuple(individual)
+    if key in cache:
+        return cache[key]
+    
+    fitness = evaluate_fitness(individual)
+    cache[key] = fitness
+    return fitness
+
+def run_evolutionary_optimization(start_time, max_time):
+    """Run evolutionary optimization process"""
+    pop_size = 50
+    max_generations = 500
+    elite_size = 5
+    
+    # Initialize population
+    population = initialize_population(pop_size)
+    
+    best_fitness = float('-inf')
+    best_individual = None
+    
+    # Evolution loop
+    for gen in range(max_generations):
+        if time.time() - start_time > max_time - 5:
+            break
+            
+        # Evaluate fitness for entire population
+        fitnesses = []
+        for individual in population:
+            fit = evaluate_fitness(individual)
+            fitnesses.append(fit)
+            
+        # Track best solution
+        current_best_idx = np.argmax(fitnesses)
+        current_best_fitness = fitnesses[current_best_idx]
+        
+        if current_best_fitness > best_fitness:
+            best_fitness = current_best_fitness
+            best_individual = population[current_best_idx].copy()
+            
+        # Elitism: keep best individuals
+        elite_indices = np.argsort(fitnesses)[-elite_size:]
+        elites = [population[i] for i in elite_indices]
+        
+        # Calculate diversity
+        if len(fitnesses) > 1:
+            diversity = np.std(fitnesses)
+        else:
+            diversity = 0
+            
+        # Create new population
+        new_population = elites.copy()
+        
+        # Fill rest with offspring
+        while len(new_population) < pop_size:
+            parent1 = tournament_selection(population, fitnesses, tournament_size=5)
+            parent2 = tournament_selection(population, fitnesses, tournament_size=5)
+            
+            child1, child2 = crossover(parent1, parent2)
+            child1 = adaptive_mutation(child1, gen, max_generations, diversity)
+            child2 = adaptive_mutation(child2, gen, max_generations, diversity)
+            
+            new_population.extend([child1, child2])
+            
+        # Trim to exact population size
+        population = new_population[:pop_size]
+        
+        # Occasionally apply local search to best individual
+        if gen % 20 == 0 and best_individual is not None:
+            # Simple hill climbing on the best individual
+            test_individual = best_individual.copy()
+            test_fitness = evaluate_fitness(test_individual)
+            
+            for _ in range(10):
+                # Small perturbations
+                test_ind = test_individual.copy()
+                for i in range(len(test_ind)):
+                    if i % 3 < 2:  # x or y coordinate
+                        test_ind[i] += random.uniform(-0.05, 0.05)
+                        test_ind[i] = max(-10, min(10, test_ind[i]))
+                    else:  # angle
+                        test_ind[i] += random.uniform(-2, 2)
+                        test_ind[i] %= 360
+                        
+                new_fitness = evaluate_fitness(test_ind)
+                if new_fitness > test_fitness:
+                    test_individual = test_ind
+                    test_fitness = new_fitness
+                    
+            if test_fitness > best_fitness:
+                best_fitness = test_fitness
+                best_individual = test_individual.copy()
+    
+    return best_individual, best_fitness
