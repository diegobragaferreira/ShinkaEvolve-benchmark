+    sin_a = np.sin(angle_rad)
+    
+    # Base vertices of unit hexagon centered at origin
+    base_vertices = np.array([
+        [1.0, 0.0],
+        [0.5, np.sqrt(3)/2],
+        [-0.5, np.sqrt(3)/2],
+        [-1.0, 0.0],
+        [-0.5, -np.sqrt(3)/2],
+        [0.5, -np.sqrt(3)/2]
+    ])
+    
+    # Apply rotation and translation
+    rotation_matrix = np.array([[cos_a, -sin_a], [sin_a, cos_a]])
