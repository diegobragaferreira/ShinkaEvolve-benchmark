+@njit
+def distance_point_to_hexagon_edge(point_x, point_y, hex_center_x, hex_center_y, angle_degrees):
+    """Fast distance calculation from point to hexagon boundary."""
+    vertices = hexagon_vertices(hex_center_x, hex_center_y, angle_degrees)
+    min_dist = float('inf')
+    for i in range(6):
+        p1 = vertices[i]
+        p2 = vertices[(i+1) % 6]
+        # Calculate distance from point to line segment
+        A = point_x - p1[0]
+        B = point_y - p1[1]
+        C = p2[0] - p1[0]
+        D = p2[1] - p1[1]
+        
+        dot = A * C + B * D
+        len_sq = C * C + D * D
+        if len_sq == 0:
+            dist = np.sqrt(A*A + B*B)
+        else:
