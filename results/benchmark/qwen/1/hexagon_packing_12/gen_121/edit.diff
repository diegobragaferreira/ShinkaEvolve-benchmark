+class HexagonGenerator:
+    """Handles generation and caching of hexagon vertices."""
+    
+    def __init__(self):
+        self._vertex_cache = {}
+        
+    def get_vertices(self, center=(0,0), rotation=0, side_length=1):
+        """Get vertices for a hexagon with caching."""
+        key = (center, rotation, side_length)
+        if key in self._vertex_cache:
+            return self._vertex_cache[key]
+            
+        angle = rotation * np.pi / 180
+        hex_vertices = []
+        for i in range(6):
+            theta = angle + i * np.pi / 3
+            x = side_length * np.cos(theta) + center[0]
+            y = side_length * np.sin(theta) + center[1]
+            hex_vertices.append((x, y))
+            
+        self._vertex_cache[key] = hex_vertices
+        return hex_vertices
