+class SpatialIndex:
+    """Quadtree-based spatial index for efficient overlap detection."""
+    
+    def __init__(self, max_elements=10):
+        self.max_elements = max_elements
+        self.root = None
+        
+    def build_index(self, hexagons):
+        """Build spatial index from hexagons."""
+        if not hexagons:
+            return
+            
+        # Determine bounding box
+        min_x = min_y = float('inf')
+        max_x = max_y = float('-inf')
+        
+        for hexagon in hexagons:
+            bounds = hexagon.bounds
+            min_x = min(min_x, bounds[0])
+            min_y = min(min_y, bounds[1])
+            max_x = max(max_x, bounds[2])
+            max_y = max(max_y, bounds[3])
+            
+        # Build tree
+        self.root = self._build_node((min_x, min_y, max_x, max_y), hexagons, 0)
+        
+    def _build_node(self, bounds, elements, depth):
+        """Recursively build quadtree node."""
+        node = {
+            'bounds': bounds,
+            'elements': elements[:],
+            'children': [],
+            'is_leaf': len(elements) <= self.max_elements or depth > 4
+        }
+        
+        if not node['is_leaf'] and len(elements) > self.max_elements:
+            # Split into quadrants
+            min_x, min_y, max_x, max_y = bounds
+            mid_x = (min_x + max_x) / 2
+            mid_y = (min_y + max_y) / 2
+            
+            quadrants = [
+                (min_x, min_y, mid_x, mid_y),     # bottom-left
+                (mid_x, min_y, max_x, mid_y),     # bottom-right
+                (min_x, mid_y, mid_x, max_y),     # top-left
+                (mid_x, mid_y, max_x, max_y)      # top-right
+            ]
+            
+            quadrant_elements = [[] for _ in range(4)]
+            
+            for element in elements:
+                bounds = element.bounds
+                cx = (bounds[0] + bounds[2]) / 2
+                cy = (bounds[1] + bounds[3]) / 2
+                
+                # Find which quadrant contains the center
+                for i, quadrant in enumerate(quadrants):
+                    q_min_x, q_min_y, q_max_x, q_max_y = quadrant
+                    if q_min_x <= cx <= q_max_x and q_min_y <= cy <= q_max_y:
+                        quadrant_elements[i].append(element)
+                        break
+                else:
+                    # Default to first quadrant if no match
+                    quadrant_elements[0].append(element)
+            
+            node['children'] = [
+                self._build_node(quadrant, elems, depth + 1)
+                for quadrant, elems in zip(quadrants, quadrant_elements)
+                if elems
+            ]
+            
+        return node
+    
+    def query_candidates(self, hexagon):
+        """Find candidate overlapping hexagons."""
+        if not self.root:
+            return []
+            
+        candidates = []
+        self._query_recursive(self.root, hexagon, candidates)
+        return candidates
+    
+    def _query_recursive(self, node, hexagon, candidates):
+        """Recursive query implementation."""
+        if node['is_leaf']:
+            candidates.extend(node['elements'])
+            return
+            
+        # Check if hexagon intersects with node bounds
+        bounds = node['bounds']
+        hex_bounds = hexagon.bounds
+        
+        if (hex_bounds[2] >= bounds[0] and hex_bounds[0] <= bounds[2] and
+            hex_bounds[3] >= bounds[1] and hex_bounds[1] <= bounds[3]):
+            
+            # Check children
+            for child in node['children']:
+                self._query_recursive(child, hexagon, candidates)
+            
+            # Also check elements in this node
+            for elem in node['elements']:
+                if hexagon.intersects(elem):
+                    candidates.append(elem)
