+def generate_hexagon_vertices(center_x, center_y, angle_degrees, side_length=1):
+    """Generate vertices of a regular hexagon given center, angle, and side length."""
+    angle_rad = np.radians(angle_degrees)
+    angles = np.linspace(0, 2*np.pi, 7)[:-1]  # 6 angles + close the polygon
+    vertices = []
+    for angle in angles:
+        x = center_x + side_length * np.cos(angle + angle_rad)
+        y = center_y + side_length * np.sin(angle + angle_rad)
+        vertices.append((x, y))
+    return vertices
+
