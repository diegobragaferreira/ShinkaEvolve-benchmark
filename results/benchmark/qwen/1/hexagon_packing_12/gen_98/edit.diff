+        """Get vertices of the hexagon in counter-clockwise order"""
+        angle_offset = math.radians(self.rotation_deg)
+        angle_step = 2 * math.pi / 6
+        vertices = []
+        for i in range(6):
+            angle = angle_offset + i * angle_step
+            x = self.center_x + self.side_length * math.cos(angle)
