+class Hexagon:
+    def __init__(self, center=(0, 0), rotation=0):
+        self.center = np.array(center)
+        self.rotation = rotation
+        self.radius = HEXAGON_RADIUS
+        
+    def create_polygon(self):
+        """Create a unit regular hexagon as a Shapely polygon"""
+        angle_step = np.pi / 3
+        points = []
+        for i in range(6):
+            angle = self.rotation + i * angle_step
+            x = self.center[0] + self.radius * np.cos(angle)
+            y = self.center[1] + self.radius * np.sin(angle)
+            points.append((x, y))
+        return Polygon(points)
+    
+    def get_vertices(self):
+        """Get all vertices of the hexagon"""
+        angle_step = np.pi / 3
+        vertices = []
+        for i in range(6):
+            angle = self.rotation + i * angle_step
+            x = self.center[0] + self.radius * np.cos(angle)
+            y = self.center[1] + self.radius * np.sin(angle)
+            vertices.append((x, y))
+        return vertices
+
+class PackingValidator:
+    @staticmethod
+    def check_containment(hexagon, outer_hexagon):
+        """Check if a hexagon is fully contained within outer hexagon"""
+        return outer_hexagon.contains(hexagon)
+    
+    @staticmethod
+    def check_overlap(hex1, hex2):
+        """Check if two hexagons overlap"""
+        return hex1.intersects(hex2)
+    
+    @staticmethod
+    def check_all_overlaps(hexagons, tree=None):
+        """Efficiently check all pairwise overlaps using spatial indexing"""
+        if tree is None:
+            # Create spatial index for quick neighbor searches
+            centers = np.array([h.center for h in hexagons])
+            tree = cKDTree(centers)
+        
+        n_hexagons = len(hexagons)
+        violations = 0
+        
+        # Only check nearby hexagons for overlaps (using spatial indexing)
+        for i in range(n_hexagons):
+            # Find neighbors within a reasonable distance
+            indices = tree.query_ball_point(hexagons[i].center, 3.0)
+            for j in indices:
+                if i < j:  # Avoid double counting
+                    if PackingValidator.check_overlap(hexagons[i].create_polygon(), hexagons[j].create_polygon()):
+                        violations += 1
+                        
+        return violations
+
+class GeometryUtils:
+    @staticmethod
+    def calculate_outer_hexagon_radius(inner_hex_data):
+        """Calculate minimum outer hexagon radius required to contain all inner hexagons"""
+        max_dist = 0
+        for i in range(len(inner_hex_data)):
+            center_x, center_y, _ = inner_hex_data[i]
+            # Distance from origin to hexagon center plus half the diagonal of the hexagon
+            dist_to_center = np.sqrt(center_x**2 + center_y**2)
+            # Hexagon diagonal is sqrt(3) * radius (approximately 1.732)
+            hex_diag = HEXAGON_RADIUS * np.sqrt(3)
+            max_dist = max(max_dist, dist_to_center + hex_diag)
+        return max_dist
