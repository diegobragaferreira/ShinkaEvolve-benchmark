 class SpatialConstraintValidator:
     """Handles constraint validation with spatial acceleration."""
     
     def __init__(self, outer_center: Tuple[float, float] = (0, 0)):
         self.outer_center = outer_center
         self.hex_geometry = HexagonGeometry()
     
     def validate_containment(self, hex_vertices: np.ndarray, outer_side_length: float) -> bool:
         """Check if all vertices of a hexagon are inside the outer hexagon."""
         outer_vertices = self.hex_geometry.create_vertices(self.outer_center, outer_side_length, 0)
         outer_polygon = Polygon(outer_vertices)
 
         for vertex in hex_vertices:
             point = Point(vertex)
             if not outer_polygon.contains(point):
                 return False
         return True
     
     def validate_overlaps_efficient(self, hex_polygons: List[Polygon], max_distance: float = 2.0) -> bool:
         """Efficiently check for overlaps using spatial indexing."""
         try:
             # Extract centers for spatial indexing
             centers = np.array([[p.centroid.x, p.centroid.y] for p in hex_polygons])
             
             # Build KDTree for spatial acceleration
             tree = cKDTree(centers)
             
             # Find nearby pairs to check for overlaps
             pairs = tree.query_pairs(r=max_distance, p=np.inf)
             
             # Check overlaps only for potentially intersecting pairs
             for i, j in pairs:
                 if i < j:  # Avoid double checking
                     if hex_polygons[i].intersects(hex_polygons[j]):
                         return False
             
             # Do final comprehensive check for safety
             return self._check_all_overlaps_comprehensive(hex_polygons)
             
         except Exception:
             # Fallback to brute force if spatial indexing fails
             return self._check_all_overlaps_comprehensive(hex_polygons)
     
     def _check_all_overlaps_comprehensive(self, hex_polygons: List[Polygon]) -> bool:
         """Comprehensive overlap checking as fallback."""
         for i in range(len(hex_polygons)):
             for j in range(i+1, len(hex_polygons)):
                 if hex_polygons[i].intersects(hex_polygons[j]):
                     return False
         return True
 
