+def evaluate_config(params, outer_radius_bounds=(3.0, 10.0)):
+    """Evaluate a configuration"""
+    start_time = time.time()
+    
+    # Reshape parameters
+    n = 12
+    positions = params[:2*n].reshape((n, 2))
+    angles = params[2*n:3*n]
+    
+    # Get outer hexagon parameters (center at origin, no rotation for simplicity)
+    outer_radius = params[-1]
+    
+    # Convert to array format
+    hex_data = np.column_stack([positions, angles])
+    
+    # Check constraint violations
+    contained, overlapped = check_containment_and_overlap(hex_data, outer_radius)
+    penalty = 0.0
+    
+    if not contained:
+        penalty += 1e6
+    if overlapped:
+        penalty += 1e6
+    
+    # Calculate inverse side length
+    inv_side_length = 1.0 / outer_radius
+    objective = inv_side_length - penalty
+    
+    eval_time = time.time() - start_time
+    return -objective, eval_time
