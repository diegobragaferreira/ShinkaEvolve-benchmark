+@jit(nopython=True)
+def hexagon_vertices(x, y, angle_deg, radius=1.0):
+    """Generate vertices of a regular hexagon"""
+    vertices = np.zeros((6, 2))
+    angle_rad = np.radians(angle_deg)
+    for i in range(6):
+        theta = angle_rad + i * np.pi / 3
+        vertices[i, 0] = x + radius * np.cos(theta)
+        vertices[i, 1] = y + radius * np.sin(theta)
+    return vertices
+
+
+@jit(nopython=True)
+def point_in_hexagon(px, py, hex_x, hex_y, hex_angle, radius=1.0):
+    """Check if point (px,py) is inside hexagon defined by center (hex_x,hex_y), angle, and radius"""
+    # Rotate point to hexagon's coordinate system
+    angle_rad = np.radians(hex_angle)
+    dx = px - hex_x
+    dy = py - hex_y
+    rotated_x = dx * np.cos(-angle_rad) - dy * np.sin(-angle_rad)
+    rotated_y = dx * np.sin(-angle_rad) + dy * np.cos(-angle_rad)
+    
+    # Check against unit hexagon centered at origin
+    hex_radius = radius
+    r = np.sqrt(rotated_x**2 + rotated_y**2)
+    if r > hex_radius:
+        return False
+        
+    # Check angular constraint
+    if r == 0:
+        return True
+        
+    theta = np.arctan2(rotated_y, rotated_x) % (2*np.pi)
+    angle_step = 2*np.pi / 6
+    for i in range(6):
+        angle_min = i * angle_step
+        angle_max = (i+1) * angle_step
+        if angle_min <= theta <= angle_max:
+            return True
+            
+    return False
+
+
+@jit(nopython=True)
+def hexagon_distance(h1_x, h1_y, h1_angle, h2_x, h2_y, h2_angle):
+    """Calculate minimum distance between two hexagons"""
+    v1 = hexagon_vertices(h1_x, h1_y, h1_angle)
+    v2 = hexagon_vertices(h2_x, h2_y, h2_angle)
+    
+    # Find minimum distance between vertices
+    min_dist = np.inf
+    for i in range(6):
+        for j in range(6):
+            dist = np.sqrt((v1[i,0]-v2[j,0])**2 + (v1[i,1]-v2[j,1])**2)
+            if dist < min_dist:
+                min_dist = dist
+                
+    return min_dist
+
+
+@jit(nopython=True)
+def check_containment_and_overlap(hex_data, outer_radius):
+    """Fast overlap and containment check"""
+    n = len(hex_data)
+    
+    # Check containment
+    for i in range(n):
+        x, y, angle = hex_data[i]
+        vertices = hexagon_vertices(x, y, angle)
+        
+        # Check if any vertex is outside outer hexagon
+        for j in range(6):
+            vx, vy = vertices[j]
+            dist_from_center = np.sqrt(vx**2 + vy**2)
+            if dist_from_center >= outer_radius:
+                return False, False  # Not contained
+    
+    # Check overlaps
+    for i in range(n):
+        for j in range(i+1, n):
+            x1, y1, angle1 = hex_data[i]
+            x2, y2, angle2 = hex_data[j]
+            
+            dist = hexagon_distance(x1, y1, angle1, x2, y2, angle2)
+            if dist < 2 * UNIT_HEX_RADIUS:  # Overlapping
+                return False, True
+                
+    return True, False  # Contained, no overlap
+
