 def generate_initial_guess():
     """Generate a better initial configuration based on known dense arrangements"""
     # Start with a more symmetric layout
     # Arrange in a hexagonal pattern around center
     centers = []
 
     # Central hexagon
     centers.append((0, 0))
 
     # Ring 1 hexagons (6 around center)
