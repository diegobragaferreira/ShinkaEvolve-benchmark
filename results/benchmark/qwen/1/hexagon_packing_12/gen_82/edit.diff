     # Optimization parameters
     maxiter = 50  # Reduced for time constraint
     popsize = 15  # Smaller population for faster execution
 
     try:
         # Run optimization
         result = differential_evolution(
             evaluate_solution,
             bounds,
             maxiter=maxiter,
             popsize=popsize,
             seed=42,
             disp=True,
             polish=True
         )
 
         # Extract optimized parameters
         optimized_params = result.x.reshape(-1, 3)
 
         # Build final data structure
         inner_hex_data = optimized_params.copy()
 
         # Calculate final outer hexagon side length
         outer_radius = calculate_outer_hexagon_radius(optimized_params)
         outer_hex_side_length = outer_radius * np.sqrt(3)  # Convert from radius to side length
 
         # Outer hexagon centered at origin with 0 rotation
