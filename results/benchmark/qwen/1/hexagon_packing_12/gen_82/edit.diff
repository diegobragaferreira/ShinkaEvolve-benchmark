     for angle in angles:
         x = 2 * HEXAGON_RADIUS * np.cos(angle)
         y = 2 * HEXAGON_RADIUS * np.sin(angle)
         centers.append((x, y))
 
     # Ring 2 hexagons (6 around ring 1)
     angles = np.linspace(np.pi/6, 2*np.pi + np.pi/6, 6, endpoint=False)
     for angle in angles:
         x = 3 * HEXAGON_RADIUS * np.cos(angle)
