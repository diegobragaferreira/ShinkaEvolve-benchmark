+def hexagon_vertices(center_x: float, center_y: float, angle_deg: float, side_length: float = UNIT_HEX_RADIUS) -> np.ndarray:
+    """Calculate vertices of a regular hexagon given center, angle and side length."""
+    angle_rad = np.radians(angle_deg)
+    # Unit hexagon vertices (assuming side length = 1)
+    unit_vertices = np.array([
+        [1, 0],
+        [0.5, np.sqrt(3)/2],
+        [-0.5, np.sqrt(3)/2],
+        [-1, 0],
+        [-0.5, -np.sqrt(3)/2],
+        [0.5, -np.sqrt(3)/2]
+    ])
+    
+    # Rotate and translate
+    cos_a = np.cos(angle_rad)
+    sin_a = np.sin(angle_rad)
+    rotation_matrix = np.array([[cos_a, -sin_a], [sin_a, cos_a]])
+    
+    vertices = unit_vertices @ rotation_matrix.T * side_length
+    vertices[:, 0] += center_x
+    vertices[:, 1] += center_y
+    
+    return vertices
