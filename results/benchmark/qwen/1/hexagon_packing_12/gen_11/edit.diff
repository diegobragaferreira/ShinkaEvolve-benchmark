+    def _generate_hexagon_vertices(self):
+        """Generate vertices of a unit regular hexagon centered at origin."""
+        angles = np.linspace(0, 2*np.pi, 7)[:-1]  # 6 angles + remove last to avoid duplication
+        return np.column_stack([np.cos(angles), np.sin(angles)])
+    
+    def _get_hexagon_polygon(self, center_x, center_y, angle_deg):
+        """Get shapely polygon representation of hexagon at given position and rotation."""
+        angle_rad = np.radians(angle_deg)
+        # Rotate and translate vertices
+        cos_a, sin_a = np.cos(angle_rad), np.sin(angle_rad)
+        rotation_matrix = np.array([[cos_a, -sin_a], [sin_a, cos_a]])
+        rotated_vertices = rotation_matrix @ self.hex_vertices.T
+        translated_vertices = rotated_vertices.T + [center_x, center_y]
+        return Polygon(translated_vertices)
