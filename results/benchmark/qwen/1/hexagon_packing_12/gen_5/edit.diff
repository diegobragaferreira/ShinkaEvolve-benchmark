+def hexagon_vertices(center_x, center_y, angle_deg, side_length=1):
+    """Generate vertices of a regular hexagon"""
+    angle_rad = math.radians(angle_deg)
+    vertices = []
+    for i in range(6):
+        angle = angle_rad + i * math.pi / 3
+        x = center_x + side_length * math.cos(angle)
+        y = center_y + side_length * math.sin(angle)
+        vertices.append((x, y))
+    return np.array(vertices)
+
+def check_containment(hex_center, hex_angle, outer_hex_center, outer_hex_radius):
+    """Check if a hexagon is fully contained within the outer hexagon"""
+    # Generate vertices of both hexagons
+    inner_vertices = hexagon_vertices(hex_center[0], hex_center[1], hex_angle)
+
+    # Check if all inner hexagon vertices are within outer hexagon
+    # We'll check distance from center to each vertex against outer radius
+    for vertex in inner_vertices:
+        dist = math.sqrt((vertex[0] - outer_hex_center[0])**2 + (vertex[1] - outer_hex_center[1])**2)
+        if dist >= outer_hex_radius:
+            return False
+    return True
+
+def check_overlap(hex1_center, hex1_angle, hex2_center, hex2_angle):
