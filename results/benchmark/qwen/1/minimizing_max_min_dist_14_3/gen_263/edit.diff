 def min_max_dist_ratio(points):
     """Calculate the ratio of minimum to maximum distance."""
     if len(points) < 2:
         return 0.0
     distances = pdist(points)
     if len(distances) == 0:
         return 0.0
     min_dist = np.min(distances)
     max_dist = np.max(distances)
     if max_dist < 1e-12:
         return 0.0
     return min_dist / max_dist
 
