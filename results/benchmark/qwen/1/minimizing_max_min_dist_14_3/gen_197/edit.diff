+def compute_distances_numba(points):
+    """Compute pairwise distances efficiently using numba"""
+    n = points.shape[0]
+    distances = np.zeros((n, n))
+    for i in range(n):
+        for j in range(i+1, n):
+            dist = 0.0
+            for k in range(3):
+                diff = points[i, k] - points[j, k]
+                dist += diff * diff
+            dist = np.sqrt(dist)
+            distances[i, j] = dist
+            distances[j, i] = dist
+    return distances
+
+def sobol_sequence_3d(n):
+    """Generate 3D Sobol sequence points"""
+    try:
+        from sobol_seq import i4_sobol_generate
+        points = i4_sobol_generate(3, n)
+        # Scale to [0,1]^3
+        points = points * 2 - 1  # Scale to [-1,1]^3
+        # Normalize to unit sphere
+        norms = np.linalg.norm(points, axis=1)
+        norms = np.where(norms == 0, 1, norms)
+        points = points / norms[:, np.newaxis]
+        return points
+    except ImportError:
