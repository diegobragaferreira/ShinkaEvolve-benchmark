         try:
             optimized_points = adaptive_multi_stage_optimization(initial_points, max_iter=800)
 
             # Evaluate the result
             ratio = min_max_dist_ratio(optimized_points)
 
             if ratio > best_ratio:
                 best_ratio = ratio
                 best_points = optimized_points.copy()
 
         except Exception:
             # If optimization fails, continue to next restart
