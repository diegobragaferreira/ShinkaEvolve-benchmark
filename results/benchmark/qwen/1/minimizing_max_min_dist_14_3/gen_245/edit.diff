             normalized_points = noisy_points / np.maximum(norms, 1e-12)
 
             # Flatten for optimization
             x0 = normalized_points.flatten()
 
             # Stage 1: Coarse optimization with SLSQP
             try:
                 result_coarse = minimize(
                     objective,
