         )
         iteration_counter += 500
         optimized_points = adaptive_optimization_stage(
             optimized_points,
             max_iter=500,
             stage=2,
             iteration_offset=iteration_counter
         )
         iteration_counter += 500
         optimized_points = adaptive_optimization_stage(
             optimized_points,
             max_iter=500,
             stage=3,
             iteration_offset=iteration_counter
         )
 
         # Evaluate solution
         ratio = min_max_dist_ratio(optimized_points)
 
         if ratio > best_ratio:
             best_ratio = ratio
             best_points = optimized_points.copy()
 
     # Fallback to random if no good solution found
     if best_points is None:
         np.random.seed(42)
         random_points = np.random.randn(n, d)
         norms = np.linalg.norm(random_points, axis=1, keepdims=True)
         best_points = random_points / np.maximum(norms, 1e-12)
 
     return best_points
 
