         conv = self.compute_convolution(sequence)
         
         # Calculate C₁
         max_conv = np.max(conv)
         sum_sq = np.sum(sequence) ** 2
         if sum_sq == 0:
             return float('inf')
             
         c1 = 2 * n * max_conv / sum_sq
         return c1
 
