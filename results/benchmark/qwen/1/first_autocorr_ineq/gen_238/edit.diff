+            try:
+                # Pad to length 2*n - 1 for full convolution
+                padded_length = 2 * n - 1
+                fa = fft(sequence, padded_length)
+                fb = fft(sequence, padded_length)
+                conv = ifft(fa * fb.conj()).real[:n]
