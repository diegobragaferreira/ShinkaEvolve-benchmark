+def adaptive_crossover(parent1: List[float], parent2: List[float]) -> List[float]:
+    """Perform adaptive crossover that respects sequence characteristics."""
+    min_len = min(len(parent1), len(parent2))
+    if min_len == 0:
+        return parent1 if parent1 else parent2
+
+    # Use blend crossover (BLX-α) for better exploration
+    alpha = 0.5
+    child = []
+
+    for i in range(min_len):
+        # Calculate range for blending
+        lower_bound = min(parent1[i], parent2[i])
+        upper_bound = max(parent1[i], parent2[i])
+        range_diff = upper_bound - lower_bound
+
+        # Sample from extended range
+        sample = random.uniform(lower_bound - alpha * range_diff,
+                               upper_bound + alpha * range_diff)
+        child.append(max(0.01, sample))
+
+    return child
+
+def adaptive_mutation(sequence: List[float], generation: int, population_size: int) -> List[float]:
