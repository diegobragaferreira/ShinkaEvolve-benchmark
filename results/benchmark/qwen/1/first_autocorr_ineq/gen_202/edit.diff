 def get_gradient_based_direction(sequence):
     """Estimate a better direction using gradient information."""
     n = len(sequence)
     if n == 0:
         return None
 
     sum_sequence = np.sum(sequence)
     if sum_sequence < 0.01:
         return None
 
     # Normalize the sequence
     normalized_sequence = [x * np.sqrt(2 * n) / sum_sequence for x in sequence]
 
     # Compute the target value for the LP constraint with early termination
     conv_result_full = fftconvolve(normalized_sequence, normalized_sequence[::-1], mode='full')
     conv_result = conv_result_full[len(normalized_sequence)-1:]
     rhs = np.max(conv_result)
 
     # Solve the LP problem with early exit if possible
     g_fun = solve_convolution_lp(normalized_sequence, rhs)
     if g_fun is None:
         return None
 
     # Normalize the resulting sequence
     sum_g_fun = np.sum(g_fun)
     if sum_g_fun < 0.01:
