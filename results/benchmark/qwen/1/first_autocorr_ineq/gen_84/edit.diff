+    def compute_autocorrelation_constant(self, sequence: List[float]) -> Tuple[float, float]:
+        """
+        Compute the autocorrelation constant C₁ and its inverse 1/C₁ for a sequence.
+        
+        Returns:
+            Tuple of (C₁, 1/C₁)
+        """
+        # Check cache first
+        seq_tuple = tuple(sequence)
