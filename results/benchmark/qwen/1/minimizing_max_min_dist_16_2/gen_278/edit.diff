 def _local_refinement(points: np.ndarray, max_iter: int = 150, method: str = 'hybrid') -> np.ndarray:
     """Perform local refinement using gradient-based methods."""
     def objective(x_flat):
         points_candidate = x_flat.reshape(-1, 2)
         return -_compute_distance_ratio(points_candidate)
 
     # Flatten points for optimization
     x0 = points.flatten()
 
     # Define bounds
     bounds = [(0, 1) for _ in range(len(x0))]
 
     try:
         # Try multiple methods for robustness
         if method == 'hybrid':
             # First try L-BFGS-B
             result = minimize(
                 objective,
                 x0,
                 method='L-BFGS-B',
                 bounds=bounds,
                 options={'maxiter': max_iter, 'ftol': 1e-12, 'gtol': 1e-12},
                 tol=1e-12
             )
 
             if result.success and result.fun < -0.9:  # Acceptable quality check
                 refined_points = result.x.reshape(-1, 2)
                 return np.clip(refined_points, 0, 1)
 
             # Fallback to Nelder-Mead if L-BFGS-B doesn't work well
             result = minimize(
                 objective,
                 x0,
                 method='Nelder-Mead',
                 options={'maxiter': max_iter//2, 'adaptive': True}
             )
 
             if result.success:
                 refined_points = result.x.reshape(-1, 2)
                 return np.clip(refined_points, 0, 1)
 
         elif method == 'l_bfgs':
             # Direct L-BFGS-B approach
             result = minimize(
                 objective,
                 x0,
                 method='L-BFGS-B',
                 bounds=bounds,
                 options={'maxiter': max_iter, 'ftol': 1e-12, 'gtol': 1e-12},
                 tol=1e-12
             )
 
             if result.success:
                 refined_points = result.x.reshape(-1, 2)
                 return np.clip(refined_points, 0, 1)
 
     except Exception:
         # Return original points if optimization fails
         pass
 
     return points
 
 def _evolutionary_search(initial_population: List[np.ndarray], max_generations: int = 60) -> np.ndarray:
     """Perform evolutionary search on the population."""
     population = initial_population.copy()
     population_size = len(population)
 
     for generation in range(max_generations):
         # Evaluate fitness for all individuals
         fitness_scores = [_evaluate_fitness(ind) for ind in population]
 
         # Sort by fitness (ascending since we minimize)
         sorted_indices = np.argsort(fitness_scores)
         population = [population[i] for i in sorted_indices]
         fitness_scores = [fitness_scores[i] for i in sorted_indices]
 
         # Keep top 60% (elitism) in early generations, 40% in later
         elitism_percentage = max(0.4, 0.6 - (generation / max_generations) * 0.2)
         elite_count = max(1, int(population_size * elitism_percentage))
         elite_population = population[:elite_count]
 
         # Create new population through reproduction
         new_population = elite_population.copy()
 
         # Generate offspring through crossover and mutation
         while len(new_population) < population_size:
             # Tournament selection with size 3
             tournament_size = 3
             parent1_idx = np.random.choice(elite_count, tournament_size, replace=False)[0]
             parent2_idx = np.random.choice(elite_count, tournament_size, replace=False)[0]
 
             parent1 = population[parent1_idx]
             parent2 = population[parent2_idx]
 
             # Crossover
             child1, child2 = _crossover(parent1, parent2)
 
             # Mutation with adaptive rate
             # Higher mutation rate in early generations, lower in later
             mutation_rate = max(0.05, 0.2 * (1 - generation / max_generations))
             noise_amplitude = max(0.001, 0.01 * (1 - generation / max_generations))
 
             child1 = _mutate_individual(child1, mutation_rate, noise_amplitude)
             child2 = _mutate_individual(child2, mutation_rate, noise_amplitude)
 
             new_population.extend([child1, child2])
 
         # Trim to exact population size
         population = new_population[:population_size]
 
         # Early stopping condition - if we've converged
         if generation > 15:
             recent_improvement = abs(fitness_scores[0] - fitness_scores[-1])
             if recent_improvement < 1e-6:
                 break
 
     # Return best individual
     fitness_scores = [_evaluate_fitness(ind) for ind in population]
     best_idx = np.argmin(fitness_scores)
     return population[best_idx]
 
